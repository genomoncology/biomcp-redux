      "description": "Discover source candidates using one declared selector, without interpreting free text.",
      "properties": {
        "build": {
          "$ref": "#/$defs/Build",
          "description": "Assembly sent to MyVariant. Protein and raw queries default to GRCh37; regions require it explicitly."
        },
        "gene": {
          "$ref": "#/$defs/GeneSymbol",
          "description": "Exact checked gene symbol for the fixed MyVariant gene/protein field query."
        },
        "limit": {
          "default": 10,
          "description": "Native candidates per page, default 10, maximum 50; all candidates remain candidates.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
