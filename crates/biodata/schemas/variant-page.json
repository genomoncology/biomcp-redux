{
  "$defs": {
    "Accession": {
      "pattern": "^((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?)$",
      "type": "string"
    },
    "Allele": {
      "additionalProperties": false,
      "description": "Source-stated interbase replacement; equality never claims normalized equivalence.",
      "properties": {
        "alternate": {
          "$ref": "#/$defs/Sequence"
        },
        "location": {
          "$ref": "#/$defs/SequenceLocation"
        },
        "reference": {
          "$ref": "#/$defs/Sequence"
        }
      },
      "required": [
        "location",
        "reference",
        "alternate"
      ],
      "type": "object"
    },
    "Attribution": {
      "additionalProperties": false,
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link."
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ]
    },
    "Expression": {
      "additionalProperties": false,
      "description": "Source expression checked for its declared published form, without normalization.",
      "properties": {
        "syntax": {
          "$ref": "#/$defs/ExpressionSyntax"
        },
        "syntax_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "syntax",
        "value"
      ],
      "type": "object"
    },
    "ExpressionSyntax": {
      "description": "Published syntax label for a source-preserved expression.",
      "enum": [
        "hgvs.g",
        "hgvs.c",
        "hgvs.n",
        "hgvs.r",
        "hgvs.p",
        "hgvs.m",
        "hgvs.o",
        "spdi",
        "gnomad",
        "vcf",
        "iscn"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGVS genomic description.",
        " HGVS coding description.",
        " HGVS noncoding transcript description.",
        " HGVS RNA description.",
        " HGVS protein description.",
        " HGVS mitochondrial description.",
        " HGVS circular genomic description.",
        " NCBI SPDI interbase description.",
        " gnomAD chromosome-position-reference-alternate identifier.",
        " Padded VCF chromosome-position-reference-alternate text.",
        " Source-preserved cytogenetic notation."
      ]
    },
    "FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "GeneSymbol": {
      "pattern": "^[\\x21-\\x7e]{1,255}$",
      "type": "string"
    },
    "GwasAssociation": {
      "additionalProperties": false,
      "description": "Source association with unchanged trait and effect labels.",
      "properties": {
        "alleles": {
          "description": "Every source effect allele paired with its rsID.",
          "items": {
            "$ref": "#/$defs/GwasEffectAllele"
          },
          "type": "array"
        },
        "beta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source beta text, including units and direction."
        },
        "id": {
          "description": "Native association identity.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source effect interval."
        },
        "odds_ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source odds ratio."
        },
        "ontology_traits": {
          "description": "Source mapped trait identifiers and whole labels, without clinical inference.",
          "items": {
            "$ref": "#/$defs/GwasTrait"
          },
          "type": "array"
        },
        "p_value": {
          "$ref": "#/$defs/FiniteNumber",
          "description": "Reported p value."
        },
        "publication": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication identifier."
        },
        "risk_frequency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source allele frequency text, without interpreting NR."
        },
        "study": {
          "$ref": "#/$defs/Text",
          "description": "Study accession."
        },
        "traits": {
          "description": "Source reported traits.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "study",
        "traits",
        "alleles",
        "p_value"
      ],
      "type": "object"
    },
    "GwasEffectAllele": {
      "additionalProperties": false,
      "description": "Catalog effect allele paired with its exact rsID.",
      "properties": {
        "allele": {
          "$ref": "#/$defs/Text",
          "description": "Source allele text."
        },
        "rs_id": {
          "$ref": "#/$defs/Text",
          "description": "Source rsID."
        }
      },
      "required": [
        "rs_id",
        "allele"
      ],
      "type": "object"
    },
    "GwasTrait": {
      "additionalProperties": false,
      "description": "Source ontology mapping as supplied by GWAS Catalog.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Exact source ontology identifier spelling."
        },
        "label": {
          "$ref": "#/$defs/Text",
          "description": "Whole source trait label."
        }
      },
      "required": [
        "id",
        "label"
      ],
      "type": "object"
    },
    "HgvsText": {
      "pattern": "^((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?):[gcnrpmo]\\.[\\x20-\\x7e]+$",
      "type": "string"
    },
    "LeafRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source-qualified HGVS."
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VariantId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source identifier."
            },
            "level": {
              "const": "allele",
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "gene": {
              "$ref": "#/$defs/GeneSymbol",
              "description": "Source gene."
            },
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein HGVS."
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein label."
            },
            "level": {
              "const": "protein",
              "type": "string"
            }
          },
          "required": [
            "level",
            "gene"
          ],
          "type": "object"
        }
      ]
    },
    "MyVariantQuery": {
      "pattern": "\\S",
      "type": "string"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "PopulationFrequency": {
      "additionalProperties": false,
      "description": "One source cohort allele-frequency result under the shared variant model.",
      "properties": {
        "allele_count": {
          "description": "Source allele count; zero remains an observation.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "allele_number": {
          "description": "Source allele denominator.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "description": "Native source record and dataset provenance."
        },
        "build": {
          "$ref": "#/$defs/Build",
          "description": "Source dataset assembly."
        },
        "dataset": {
          "$ref": "#/$defs/Text",
          "description": "Source dataset identifier."
        },
        "filters": {
          "description": "Every source filter in native order.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        },
        "frequency": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source reported frequency, never calculated from counts."
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source group identifier, absent for the complete sequencing subset."
        },
        "homozygotes": {
          "description": "Source homozygote count, never derived.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "subject": {
          "$ref": "#/$defs/VariantRef",
          "description": "Exact source-qualified allele subject."
        }
      },
      "required": [
        "subject",
        "dataset",
        "build",
        "attribution"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized."
      ]
    },
    "ProteinChange": {
      "pattern": "^(p\\.)?(A|Ala|R|Arg|N|Asn|D|Asp|C|Cys|E|Glu|Q|Gln|G|Gly|H|His|I|Ile|L|Leu|K|Lys|M|Met|F|Phe|P|Pro|S|Ser|T|Thr|W|Trp|Y|Tyr|V|Val|U|Sec|O|Pyl|\\*|Ter)[1-9][0-9]*(A|Ala|R|Arg|N|Asn|D|Asp|C|Cys|E|Glu|Q|Gln|G|Gly|H|His|I|Ile|L|Leu|K|Lys|M|Met|F|Phe|P|Pro|S|Ser|T|Thr|W|Trp|Y|Tyr|V|Val|U|Sec|O|Pyl|\\*|Ter)$",
      "type": "string"
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Representation": {
      "additionalProperties": false,
      "description": "One source's own expression, assembly and optional source-stated interbase allele.",
      "properties": {
        "allele": {
          "anyOf": [
            {
              "$ref": "#/$defs/Allele"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-supplied allele, without local normalization or equivalence inference."
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Assembly stated by the source, omitted when absent."
        },
        "expression": {
          "$ref": "#/$defs/Expression",
          "description": "Published notation kept unchanged."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Source asserting this form."
        }
      },
      "required": [
        "source",
        "expression"
      ],
      "type": "object"
    },
    "Section": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/VariantPopulation",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Section2": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/VariantGwas",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Sequence": {
      "pattern": "^[ACGTNRYSWKMBDHV]*$",
      "type": "string"
    },
    "SequenceLocation": {
      "additionalProperties": false,
      "description": "An interbase interval on one versioned sequence accession.",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/Accession",
          "description": "Versioned source sequence, without an inferred genome build."
        },
        "span": {
          "$ref": "#/$defs/Span0",
          "description": "Zero-based half-open bounds."
        }
      },
      "required": [
        "sequence",
        "span"
      ],
      "type": "object"
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "hpa",
        "uniprot",
        "gwas",
        "gnomad",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "pmc-oa",
