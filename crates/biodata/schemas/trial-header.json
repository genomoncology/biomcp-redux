{
  "$defs": {
    "NctId": {
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "TrialPhase": {
      "description": "Source-native registry value.",
      "enum": [
        "EARLY_PHASE1",
        "PHASE1",
        "PHASE2",
        "PHASE3",
        "PHASE4",
        "NA"
      ],
      "type": "string"
    },
    "TrialStatus": {
      "description": "Source-native registry value.",
      "enum": [
        "ACTIVE_NOT_RECRUITING",
        "COMPLETED",
        "ENROLLING_BY_INVITATION",
        "NOT_YET_RECRUITING",
        "RECRUITING",
        "SUSPENDED",
        "TERMINATED",
        "WITHDRAWN",
        "AVAILABLE",
        "NO_LONGER_AVAILABLE",
        "APPROVED_FOR_MARKETING",
        "WITHHELD",
        "UNKNOWN"
      ],
      "type": "string"
    }
  },
  "$id": "biodata.trial_header/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Small source-attributed trial discovery record.",
  "properties": {
    "conditions": {
      "description": "Source condition names.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "type": "array"
    },
    "interventions": {
      "description": "Source intervention names.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "type": "array"
    },
    "nct_id": {
      "$ref": "#/$defs/NctId",
      "description": "Exact registry identity."
    },
    "phases": {
      "description": "Source phases; absent phases remain absent.",
      "items": {
        "$ref": "#/$defs/TrialPhase"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/TrialStatus",
      "description": "Registry's overall status, independent of site status."
    },
    "title": {
      "$ref": "#/$defs/Text",
      "description": "Complete brief title."
    },
    "updated": {
      "$ref": "#/$defs/PartialDate",
      "description": "Last posted registry update."
    },
    "url": {
      "$ref": "#/$defs/Text",
      "description": "Publisher's canonical record URL."
    }
  },
  "required": [
    "nct_id",
    "title",
    "status",
    "phases",
    "conditions",
    "interventions",
    "updated",
    "url"
  ],
  "title": "TrialHeader",
  "type": "object"
}
