{
  "$defs": {
    "Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "enum": [
        "GRCh37",
        "GRCh38",
        "unstated"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38.",
        " Source did not state an assembly."
      ]
    },
    "Contig": {
      "pattern": "^[\\x21-\\x7e]{1,255}$",
      "type": "string"
    },
    "GenomicInterval": {
      "additionalProperties": false,
      "description": "An assembly-qualified zero-based half-open source interval.",
      "properties": {
        "build": {
          "$ref": "#/$defs/Build",
          "description": "Source-stated assembly, explicitly unstated when absent."
        },
        "contig": {
          "$ref": "#/$defs/Contig",
          "description": "Source chromosome or scaffold name."
        },
        "span": {
          "$ref": "#/$defs/Span0",
          "description": "Checked zero-based half-open bounds; an empty span remains valid."
        },
        "strand": {
          "anyOf": [
            {
              "$ref": "#/$defs/Strand"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated strand, if available."
        }
      },
      "required": [
        "build",
        "contig",
        "span"
      ],
      "type": "object"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "hgnc",
        "mygene",
        "reactome",
        "hpa",
        "uniprot",
        "gnomad",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "civic",
        "oncokb"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " Human Protein Atlas.",
        " UniProt.",
        " gnomAD.",
        " ClinGen.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " CIViC.",
        " OncoKB."
      ]
    },
    "SourceNotice": {
      "description": "A provider query interpretation notice.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph_truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not_found_words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "words"
          ],
          "type": "object"
        }
      ]
    },
    "SourceOutcome": {
      "additionalProperties": false,
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched": {
          "description": "Retrieved identity depth.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Provider query notices that do not indicate failure.",
          "items": {
            "$ref": "#/$defs/SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        }
      },
      "required": [
        "source",
        "state"
      ],
      "type": "object"
    },
    "SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Span0": {
      "additionalProperties": false,
      "description": "A zero-based half-open span with ordered bounds; empty spans are valid.",
      "properties": {
        "end": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind",
        "args"
      ],
      "type": "object"
    },
    "StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Strand": {
      "description": "Source-stated forward or reverse strand.",
      "enum": [
        "+",
        "-"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Forward strand.",
        " Reverse strand."
      ]
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "VariantCard": {
      "additionalProperties": false,
      "description": "A compact identity card, including every provider candidate and explicit rejection.",
      "properties": {
        "candidates": {
          "description": "All retained source identities.",
          "items": {
            "$ref": "#/$defs/VariantHeader"
          },
          "type": "array"
        },
        "rejection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Provider rejection text, when present, separate from unchanged query input."
        },
        "resolution": {
          "$ref": "#/$defs/VariantResolution",
          "description": "Identity outcome, without selecting the first candidate."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Responsible identity source."
        }
      },
      "required": [
        "resolution",
        "source",
        "candidates"
      ],
      "type": "object"
    },
    "VariantFact": {
      "additionalProperties": false,
      "description": "A compact annotation fact retains its original source and label.",
      "properties": {
        "field": {
          "$ref": "#/$defs/Text",
          "description": "Source field name, without a common severity ranking."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Annotation supplier inside MyVariant."
        },
        "value": {
          "$ref": "#/$defs/Text",
          "description": "Provider text, preserved without interpretation."
        }
      },
      "required": [
        "source",
        "field",
        "value"
      ],
      "type": "object"
    },
    "VariantGet": {
      "additionalProperties": false,
      "description": "Read one published variant identifier; every source candidate is retained.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for chromosome notation; no assembly is guessed."
        },
        "input": {
          "$ref": "#/$defs/VariantInput",
          "description": "Published rsID, CAid, ClinVar Variation ID or reference-qualified HGVS.",
          "x-positional": 0
        },
        "resolver": {
          "$ref": "#/$defs/VariantResolver",
          "default": "car",
          "description": "Resolver for reference-qualified notation; never repairs the input locally."
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "VariantHeader": {
      "additionalProperties": false,
      "description": "Enough source identity to select a candidate and inspect compact facts.",
      "properties": {
        "facts": {
          "description": "Compact source-attributed annotation facts.",
          "items": {
            "$ref": "#/$defs/VariantFact"
          },
          "type": "array"
        },
        "identity": {
          "$ref": "#/$defs/VariantIdentity",
          "description": "Checked source identity."
        }
      },
      "required": [
        "identity",
        "facts"
      ],
      "type": "object"
    },
    "VariantIdentity": {
      "additionalProperties": false,
      "description": "One source record with its exact provider aliases and allele representations.",
      "properties": {
        "aliases": {
          "description": "Identifiers asserted by the same provider, without local alias inference.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        },
        "key": {
          "$ref": "#/$defs/Text",
          "description": "Exact provider record key."
        },
        "representations": {
          "description": "Every source-qualified representation retained for this record.",
          "items": {
            "$ref": "#/$defs/VariantRepresentation"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Identity provider."
        }
      },
      "required": [
        "source",
        "key",
        "aliases",
        "representations"
      ],
      "type": "object"
    },
    "VariantInput": {
      "pattern": "^[\\x21-\\x7e]{1,2048}$",
      "type": "string"
    },
    "VariantRepresentation": {
      "additionalProperties": false,
      "description": "A provider's unchanged notation and optional source coordinate.",
      "properties": {
        "alternate_allele": {
          "description": "Source alternate allele without repair.",
          "type": [
            "string",
            "null"
          ]
        },
        "assembly": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Provider's original assembly label, including older or unstated builds."
        },
        "coordinate": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenomicInterval"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicitly counted coordinate, only when supplied by the provider."
        },
        "notation": {
          "$ref": "#/$defs/Text",
          "description": "Unchanged source notation."
        },
        "reference": {
          "$ref": "#/$defs/Text",
          "description": "Reference accession or provider reference identifier."
        },
        "reference_allele": {
          "description": "Source reference allele without complementation.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Provider responsible for this representation."
        }
      },
      "required": [
        "source",
        "notation",
        "reference"
      ],
      "type": "object"
    },
    "VariantResolution": {
      "description": "Identity resolution preserves ambiguity, rejection and unavailable sources.",
      "enum": [
        "resolved",
        "candidates",
        "absent",
        "rejected",
        "unavailable"
      ],
      "type": "string"
    },
    "VariantResolver": {
      "description": "Explicit resolver service; the default never selects an alternative silently.",
      "enum": [
        "car",
        "mutalyzer",
        "variantvalidator"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.variant_card/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One versioned command response; schema identity comes only from its body type.",
  "properties": {
    "next": {
      "description": "Available next commands.",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Search page metadata."
    },
    "problems": {
      "description": "Rejected source fields.",
      "items": {
        "$ref": "#/$defs/Problem"
      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/VariantGet",
      "description": "Parsed query."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariantCard"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.variant_card/1",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
