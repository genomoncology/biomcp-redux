{
  "$defs": {
    "Pmid": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.article-edges/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Page the citing or referenced PubMed papers of one checked PMID.",
  "properties": {
    "limit": {
      "default": 10,
      "description": "Maximum papers on one page.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Number of pool items to skip.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "pmid": {
      "$ref": "#/$defs/Pmid",
      "description": "PMID whose graph edges to read.",
      "x-positional": 0
    },
    "pool": {
      "$ref": "#/$defs/Text",
      "description": "Fixed snapshot from an earlier page."
    }
  },
  "required": [
    "pmid"
  ],
  "title": "ArticleEdges",
  "type": "object"
}
