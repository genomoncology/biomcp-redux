{
  "$defs": {
    "ArticleInput": {
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|PPR[0-9]*[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "ArticleText": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "part"
          ]
        },
        {
          "required": [
            "find"
          ]
        }
      ],
      "description": "Read one bounded body part or a page of matching paragraphs and table rows.",
      "properties": {
        "find": {
          "$ref": "#/$defs/Text",
          "description": "Case-insensitive literal text to find."
        },
        "input": {
          "$ref": "#/$defs/ArticleInput",
          "description": "PubMed or PMC identity. DOI selectors are not accepted by the reader.",
          "x-positional": 0
        },
        "offset": {
          "default": 0,
          "description": "Number of matching rows already returned.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "part": {
          "description": "One-based outline part number.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "ArticleTextResult": {
      "additionalProperties": false,
      "description": "Body text response; the envelope supplies advancing reader steps.",
      "properties": {
        "content": {
          "$ref": "#/$defs/Section",
          "description": "Explicit section outcome including not applicable and not open."
        },
        "pmcid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pmcid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested PMC record when known."
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    },
    "License": {
      "description": "License reported by the bucket metadata record.",
      "enum": [
        "cc_by",
        "cc_by_nc",
        "cc_by_sa",
        "cc_by_nc_sa",
        "cc_by_nd",
        "cc_by_nc_nd",
        "cc0",
        "public_domain",
        "tdm",
        "other"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Creative Commons Attribution.",
        " Creative Commons Attribution NonCommercial.",
        " Creative Commons Attribution ShareAlike.",
        " Creative Commons Attribution NonCommercial ShareAlike.",
        " Creative Commons Attribution NoDerivatives.",
        " Creative Commons Attribution NonCommercial NoDerivatives.",
        " Creative Commons public-domain dedication.",
        " Public domain.",
        " Text and data mining manuscript terms.",
        " The bucket reports another license."
      ]
    },
    "Markdown": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "format": "markdown",
      "minLength": 1,
      "type": "string"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Pmcid": {
      "pattern": "^PMC[1-9][0-9]*$",
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Section": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/TextContent",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "hpa",
        "uniprot",
        "gnomad",
        "clingen",
        "pubmed",
        "europepmc",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "civic",
        "oncokb"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " Human Protein Atlas.",
        " UniProt.",
        " gnomAD.",
        " ClinGen.",
        " PubMed.",
        " Europe PMC.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " CIViC.",
        " OncoKB."
      ]
    },
    "SourceNotice": {
      "description": "A provider query interpretation notice.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not_found_words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "words"
          ],
          "type": "object"
        }
      ]
    },
    "SourceOutcome": {
      "additionalProperties": false,
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched": {
          "description": "Retrieved identity depth.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Provider query notices that do not indicate failure.",
          "items": {
            "$ref": "#/$defs/SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        }
      },
      "required": [
        "source",
        "state"
      ],
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "The source's own entry for an entity.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Native source identifier."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Link to that entry."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind",
        "args"
      ],
      "type": "object"
    },
    "StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "TextContent": {
      "additionalProperties": false,
      "description": "One bounded part or matching rows with the bucket license.",
      "properties": {
        "heading_path": {
          "description": "Section ancestry for a selected part.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "hits": {
          "description": "Matching source rows for a find selection.",
          "items": {
            "$ref": "#/$defs/TextHit"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "license": {
          "$ref": "#/$defs/License",
          "description": "Bucket license."
        },
        "manuscript": {
          "description": "Author manuscript flag.",
          "type": "boolean"
        },
        "markdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/Markdown"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bounded body text for a direct part selection."
        },
        "part": {
          "description": "Part number for a direct part selection.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "processing_version": {
          "description": "Selected processing version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Text",
          "description": "Scope of returned source text."
        }
      },
      "required": [
        "license",
        "scope"
      ],
      "type": "object"
    },
    "TextHit": {
      "additionalProperties": false,
      "description": "One matching paragraph or table row, split when necessary to fit the text budget.",
      "properties": {
        "heading_path": {
          "description": "Section ancestry in source order.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        },
        "markdown": {
          "$ref": "#/$defs/Markdown",
          "description": "Whole bounded source row."
        },
        "part": {
          "description": "Outline part containing this text.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "part",
        "markdown",
        "heading_path"
      ],
      "type": "object"
    }
  },
  "$id": "biomcp.article_text/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One versioned command response; schema identity comes only from its body type.",
  "properties": {
    "next": {
      "description": "Available next commands.",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Search page metadata."
    },
    "problems": {
      "description": "Rejected source fields.",
      "items": {
        "$ref": "#/$defs/Problem"
      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/ArticleText",
      "description": "Parsed query."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArticleTextResult"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.article_text/2",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
