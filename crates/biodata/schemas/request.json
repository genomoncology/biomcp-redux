{
  "$defs": {
    "ArticleInput": {
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "ArticleSectionWord": {
      "description": "Article section request including all landed sections.",
      "enum": [
        "annotations",
        "fulltext",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Normalized text-mined entities from PubTator3.",
        " Licensed PMC body outline.",
        " Every landed article section."
      ]
    },
    "ArticleSort": {
      "description": "Article ordering supported by this command.",
      "enum": [
        "rank",
        "date"
      ],
      "type": "string"
    },
    "ArticleSource": {
      "description": "Source selectors supported by article search.",
      "enum": [
        "pubmed",
        "europepmc"
      ],
      "type": "string"
    },
    "ArticleType": {
      "description": "Publication-type selectors sent to the named sources.",
      "enum": [
        "trial",
        "randomized",
        "review",
        "systematic_review",
        "meta_analysis",
        "guideline",
        "case_report"
      ],
      "type": "string"
    },
    "Cytoband": {
      "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y)[pq][1-9][0-9](\\.[0-9]+)?$",
      "type": "string"
    },
    "GeneInput": {
      "pattern": "\\S",
      "type": "string"
    },
    "GeneSectionWord": {
      "description": "A section request word, including expansion to all landed sections.",
      "enum": [
        "protein",
        "civic",
        "clingen",
        "constraint",
        "expression",
        "pathways",
        "oncokb",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Reviewed human proteins.",
        " CIViC gene curation.",
        " ClinGen validity and dosage.",
        " Population constraint metrics.",
        " Human Protein Atlas expression.",
        " Human Reactome pathways.",
        " Keyed OncoKB annotations.",
        " Every landed section."
      ]
    },
    "LocusGroup": {
      "description": "HGNC locus group, separate from a missing source value.",
      "enum": [
        "protein_coding",
        "non_coding_rna",
        "pseudogene",
        "phenotype",
        "other"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Protein coding.",
        " Non-coding RNA.",
        " Pseudogene.",
        " Phenotype.",
        " HGNC's stated other group."
      ]
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.request/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One checked query. Housekeeping actions are separate.",
  "oneOf": [
    {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "part"
          ]
        },
        {
          "required": [
            "find"
          ]
        }
      ],
      "description": "Read licensed PMC body text.",
      "properties": {
        "command": {
          "const": "article_text",
          "type": "string"
        },
        "find": {
          "$ref": "#/$defs/Text",
          "description": "Case-insensitive literal text to find."
        },
        "input": {
          "$ref": "#/$defs/ArticleInput",
          "description": "PubMed or PMC identity. DOI selectors are not accepted by the reader.",
          "x-positional": 0
        },
        "offset": {
          "default": 0,
          "description": "Number of matching rows already returned.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "part": {
          "description": "One-based outline part number.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "command",
        "input"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Retrieve PubMed article cards.",
      "properties": {
        "command": {
          "const": "get_article",
          "type": "string"
        },
        "input": {
          "description": "PubMed, PMC or DOI identifiers in input order.",
          "items": {
            "$ref": "#/$defs/ArticleInput"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
          "x-positional": 0
        },
        "section": {
          "description": "Requested section words; trailing words and --section share this field.",
          "items": {
            "$ref": "#/$defs/ArticleSectionWord"
          },
          "type": "array",
          "x-trailing-section": true
        }
      },
      "required": [
        "command",
        "input"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "gene"
          ]
        },
        {
          "required": [
            "variant"
          ]
        },
        {
          "required": [
            "disease"
          ]
        },
        {
          "required": [
            "drug"
          ]
        },
        {
          "required": [
            "author"
          ]
        },
        {
          "required": [
            "journal"
          ]
        },
        {
          "required": [
            "since"
          ]
        },
        {
          "required": [
            "until"
          ]
        },
        {
          "required": [
            "type"
          ]
        }
      ],
      "description": "Search PubMed article identities.",
      "properties": {
        "author": {
          "$ref": "#/$defs/Text",
          "description": "Author words sent to PubMed's author field."
        },
        "command": {
          "const": "search_article",
          "type": "string"
        },
        "disease": {
          "$ref": "#/$defs/Text",
          "description": "Disease words."
        },
        "drug": {
          "$ref": "#/$defs/Text",
          "description": "Drug words."
        },
        "gene": {
          "$ref": "#/$defs/GeneInput",
          "description": "Gene input; PubMed resolves it through HGNC."
        },
        "journal": {
          "$ref": "#/$defs/Text",
          "description": "Journal words sent to PubMed's journal field."
        },
        "limit": {
          "default": 10,
          "description": "Maximum page length.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of pool items to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Stable snapshot from an earlier response."
        },
        "since": {
          "$ref": "#/$defs/PartialDate",
          "description": "Inclusive lower publication-date bound at the stated precision."
        },
        "sort": {
          "$ref": "#/$defs/ArticleSort",
          "default": "rank",
          "description": "rank (default): native provider order; several sources take turns.\ndate: newest first in each source; PubMed means date added to PubMed.\nBoth pubmed and europepmc support rank and date."
        },
        "source": {
          "default": [
            "pubmed"
          ],
          "description": "Sources to search in caller order, comma separated. Default: pubmed.\nSeveral sources take turns, remove duplicates and show every native rank.\npubmed: keyword search with PubMed MeSH mapping, in plain PubMed order.\neuropepmc: words in open full text, and preprints.",
          "items": {
            "$ref": "#/$defs/ArticleSource"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array",
          "x-comma-separated": true
        },
        "text": {
          "$ref": "#/$defs/Text",
          "description": "Words sent to each named source in its default fields.",
          "x-positional": 0
        },
        "type": {
          "$ref": "#/$defs/ArticleType",
          "description": "Publication-type filter."
        },
        "until": {
          "$ref": "#/$defs/PartialDate",
          "description": "Inclusive upper publication-date bound at the stated precision."
        },
        "variant": {
          "$ref": "#/$defs/Text",
          "description": "Variant words."
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Get gene identities and annotations.",
      "properties": {
        "command": {
          "const": "get_gene",
          "type": "string"
        },
        "input": {
          "description": "Gene symbols or checked identifiers, in input order.",
          "items": {
            "$ref": "#/$defs/GeneInput"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
          "x-positional": 0
        },
        "section": {
          "description": "Requested section words, preserving caller order and repetitions.\nTrailing section words select sections. Use --section WORD to keep inputs that equal a section word as inputs.",
          "items": {
            "$ref": "#/$defs/GeneSectionWord"
          },
          "type": "array",
          "x-trailing-section": true
        }
      },
      "required": [
        "command",
        "input"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "query"
          ]
        },
        {
          "required": [
            "band"
          ]
        }
      ],
      "description": "Search gene headers.",
      "properties": {
        "band": {
          "$ref": "#/$defs/Cytoband",
          "description": "A cytoband prefix."
        },
        "command": {
          "const": "search_gene",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "Number of results per page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "locus_group": {
          "$ref": "#/$defs/LocusGroup",
          "description": "Optional HGNC locus group intersected with the selector."
        },
        "offset": {
          "default": 0,
          "description": "Number of results to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "$ref": "#/$defs/Text",
          "description": "Words matched against symbols, previous symbols, aliases and names.",
          "x-positional": 0
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  ],
  "title": "Request"
}
