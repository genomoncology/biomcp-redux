{
  "$defs": {
    "ArticleInput": {
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|PPR[0-9]*[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "ArticleSectionWord": {
      "description": "Article section request including all landed sections.",
      "enum": [
        "annotations",
        "fulltext",
        "supplements",
        "tldr",
        "citations",
        "indexing",
        "pdf",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Normalized text-mined entities from PubTator3.",
        " Licensed PMC body outline.",
        " Supplementary files confirmed by PMC metadata.",
        " Machine-written Semantic Scholar summary and counts.",
        " Citation counts from NIH iCite.",
        " MeSH, keywords and author indexing from the citation.",
        " Publisher PDF link without downloading.",
        " Every landed article section."
      ]
    },
    "ArticleSort": {
      "description": "Article ordering supported by this command.",
      "enum": [
        "rank",
        "date",
        "citations"
      ],
      "type": "string"
    },
    "ArticleSource": {
      "description": "Source selectors supported by article search.",
      "enum": [
        "pubmed",
        "europepmc",
        "litvar",
        "semantic-scholar",
        "litsense",
        "pubtator"
      ],
      "type": "string"
    },
    "ArticleType": {
      "description": "Publication-type selectors sent to the named sources.",
      "enum": [
        "trial",
        "randomized",
        "review",
        "systematic_review",
        "meta_analysis",
        "guideline",
        "case_report"
      ],
      "type": "string"
    },
    "Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ]
    },
    "Cytoband": {
      "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y)[pq][1-9][0-9](\\.[0-9]+)?$",
      "type": "string"
    },
    "EdgeSource": {
      "description": "Graph edge provider, independent of article search providers.",
      "enum": [
        "icite",
        "semantic-scholar"
      ],
      "type": "string"
    },
    "GeneInput": {
      "pattern": "\\S",
      "type": "string"
    },
    "GeneSectionWord": {
      "description": "A section request word, including expansion to all landed sections.",
      "enum": [
        "protein",
        "civic",
        "clingen",
        "constraint",
        "expression",
        "pathways",
        "oncokb",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Reviewed human proteins.",
        " CIViC gene curation.",
        " ClinGen validity and dosage.",
        " Population constraint metrics.",
        " Human Protein Atlas expression.",
        " Human Reactome pathways.",
        " Keyed OncoKB annotations.",
        " Every landed section."
      ]
    },
    "GeneSymbol": {
      "pattern": "^[\\x21-\\x7e]{1,255}$",
      "type": "string"
    },
    "HgvsText": {
      "pattern": "^((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?):[gcnrpmo]\\.[\\x20-\\x7e]+$",
      "type": "string"
    },
    "LocusGroup": {
      "description": "HGNC locus group, separate from a missing source value.",
      "enum": [
        "protein_coding",
        "non_coding_rna",
        "pseudogene",
        "phenotype",
        "other"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Protein coding.",
        " Non-coding RNA.",
        " Pseudogene.",
        " Phenotype.",
        " HGNC's stated other group."
      ]
    },
    "MyVariantQuery": {
      "pattern": "\\S",
      "type": "string"
    },
    "NctId": {
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "NormalizationSource": {
      "description": "Explicit normalization service selection.",
      "enum": [
        "car",
        "mutalyzer",
        "variantvalidator",
        "all"
      ],
      "type": "string"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PhaseFilter": {
      "description": "Explicit source phase selection, including the registry's combined phases.",
      "enum": [
        "early-1",
        "1",
        "2",
        "3",
        "4",
        "not-applicable",
        "1/2",
        "2/3"
      ],
      "type": "string"
    },
    "ProteinChange": {
      "pattern": "^(p\\.)?(A|Ala|R|Arg|N|Asn|D|Asp|C|Cys|E|Glu|Q|Gln|G|Gly|H|His|I|Ile|L|Leu|K|Lys|M|Met|F|Phe|P|Pro|S|Ser|T|Thr|W|Trp|Y|Tyr|V|Val|U|Sec|O|Pyl|\\*|Ter)[1-9][0-9]*(A|Ala|R|Arg|N|Asn|D|Asp|C|Cys|E|Glu|Q|Gln|G|Gly|H|His|I|Ile|L|Leu|K|Lys|M|Met|F|Phe|P|Pro|S|Ser|T|Thr|W|Trp|Y|Tyr|V|Val|U|Sec|O|Pyl|\\*|Ter)$",
      "type": "string"
    },
    "RecurrenceSource": {
      "description": "Source requiring explicit study, profile and sample set.",
      "enum": [
        "cbioportal"
      ],
      "type": "string"
    },
    "RetractionFilter": {
      "description": "Native retraction inclusion policy.",
      "enum": [
        "include",
        "exclude"
      ],
      "type": "string"
    },
    "SheetRows": {
      "pattern": "^[1-9][0-9]*-[1-9][0-9]*$",
      "type": "string"
    },
    "SponsorType": {
      "description": "Registry funding category facet.",
      "enum": [
        "nih",
        "fed",
        "industry",
        "other"
      ],
      "type": "string"
    },
    "StudyType": {
      "description": "Source-native registry value.",
      "enum": [
        "INTERVENTIONAL",
        "OBSERVATIONAL",
        "EXPANDED_ACCESS"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "TrialSection": {
      "description": "Available source protocol sections.",
      "enum": [
        "eligibility",
        "outcomes",
        "arms",
        "locations",
        "contacts",
        "references",
        "documents",
        "all",
        "diseases",
        "summary"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Intact criteria and structured age/sex fields.",
        " Primary, secondary and other outcome records.",
        " Arms and interventions with original relationships.",
        " Whole source sites with their attached contacts.",
        " Central contacts and overall officials in their original roles.",
        " Registry publication identities and native reference types.",
        " Posted document metadata and source URLs.",
        " Every implemented trial section, each with independent continuations.",
        " Native NCI disease concepts, including source enrichment metadata.",
        " Complete NCI summary, paged by original character offsets."
      ]
    },
    "TrialSex": {
      "description": "Source-native registry value.",
      "enum": [
        "ALL",
        "FEMALE",
        "MALE"
      ],
      "type": "string"
    },
    "TrialSource": {
      "description": "Independent trial providers; results are never folded or used as fallbacks.",
      "enum": [
        "ctgov",
        "nci"
      ],
      "type": "string"
    },
    "TrialStatus": {
      "description": "Source-native registry value.",
      "enum": [
        "ACTIVE_NOT_RECRUITING",
        "COMPLETED",
        "ENROLLING_BY_INVITATION",
        "NOT_YET_RECRUITING",
        "RECRUITING",
        "SUSPENDED",
        "TERMINATED",
        "WITHDRAWN",
        "AVAILABLE",
        "NO_LONGER_AVAILABLE",
        "APPROVED_FOR_MARKETING",
        "WITHHELD",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "VariantInput": {
      "pattern": "^(rs[1-9][0-9]*|CA[0-9]{6,}|(clinvar:)?[1-9][0-9]*|(((N[CGMPRTW]|X[MPR])_[0-9]+|ENS[GTP][0-9]+)\\.[1-9][0-9]*|LRG_[1-9][0-9]*([tp][1-9][0-9]*)?|chr([1-9][0-9]*|X|Y|M|MT)):[cgnprmo]\\.[\\x21-\\x7e]+)$",
      "type": "string"
    },
    "VariantRegion": {
      "pattern": "^chr([1-9]|1[0-9]|2[0-2]|X|Y|MT):[1-9][0-9]*-[1-9][0-9]*$",
      "type": "string"
    },
    "VariantResolver": {
      "description": "Explicit source service for reference-qualified notation.",
      "enum": [
        "car",
        "mutalyzer",
        "variantvalidator"
      ],
      "type": "string"
    },
    "VariantSearchSource": {
      "description": "The source-native query language exposed by variant search.",
      "enum": [
        "myvariant"
      ],
      "type": "string"
    }
  },
  "$id": "biodata.request/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One checked query. Housekeeping actions are separate.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Observe an exact allele in an explicitly selected cohort.",
      "properties": {
        "command": {
          "const": "variant_recurrence",
          "type": "string"
        },
        "gene": {
          "$ref": "#/$defs/GeneSymbol",
          "description": "HGNC symbol resolved to the source's Entrez gene identifier."
        },
        "input": {
          "$ref": "#/$defs/VariantInput",
          "description": "Published variant identity; ambiguous identities are never selected silently.",
          "x-positional": 0
        },
        "limit": {
          "default": 10,
          "description": "Source mutation rows per page, including excluded alleles.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "page": {
          "default": 0,
          "description": "Zero-based native source page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "profile": {
          "$ref": "#/$defs/Text",
          "description": "Explicit mutation molecular profile."
        },
        "sample_set": {
          "$ref": "#/$defs/Text",
          "description": "Explicit sample list; selected size is never an allele denominator."
        },
        "source": {
          "$ref": "#/$defs/RecurrenceSource",
          "description": "Explicit cohort source."
        },
        "study": {
          "$ref": "#/$defs/Text",
          "description": "Explicit study; there is no default cohort."
        }
      },
      "required": [
        "command",
        "input",
        "source",
        "gene",
        "study",
        "profile",
        "sample_set"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Send unchanged HGVS to explicit normalization services.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Caller assembly; required when VariantValidator is selected."
        },
        "command": {
          "const": "variant_normalize",
          "type": "string"
        },
        "hgvs": {
          "$ref": "#/$defs/HgvsText",
          "description": "Unchanged reference-qualified HGVS; no local molecular parse."
        },
        "limit": {
          "default": 10,
          "description": "Source mapping rows per service, with typed continuation for remaining rows.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Source mapping rows to skip per service.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/NormalizationSource",
          "description": "Explicit service; all preserves independent results without consensus."
        }
      },
      "required": [
        "command",
        "source",
        "hgvs"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Read a published variant identifier.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for chromosome notation; no assembly is guessed."
        },
        "command": {
          "const": "get_variant",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/VariantInput",
          "description": "Published rsID, CAid, ClinVar Variation ID or reference-qualified HGVS.",
          "x-positional": 0
        },
        "limit": {
          "default": 10,
          "description": "Candidate rows per page; more remain reachable through typed next commands.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Candidate rows to skip in source order.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "resolver": {
          "$ref": "#/$defs/VariantResolver",
          "default": "car",
          "description": "Resolver for reference-qualified notation; never repairs the input locally."
        }
      },
      "required": [
        "command",
        "input"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "gene",
            "protein"
          ]
        },
        {
          "required": [
            "region",
            "build"
          ]
        },
        {
          "required": [
            "query",
            "source"
          ]
        }
      ],
      "description": "Discover source-native variant candidates.",
      "properties": {
        "build": {
          "$ref": "#/$defs/Build",
          "description": "Optional caller assembly sent to MyVariant; regions require it explicitly."
        },
        "command": {
          "const": "search_variant",
          "type": "string"
        },
        "gene": {
          "$ref": "#/$defs/GeneSymbol",
          "description": "Exact checked gene symbol for the fixed MyVariant gene/protein field query."
        },
        "limit": {
          "default": 10,
          "description": "Native candidates per page, default 10, maximum 50; all candidates remain candidates.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Native offset within this command's bounded result window; larger native totals remain visible.",
          "format": "uint32",
          "maximum": 9999,
          "minimum": 0,
          "type": "integer"
        },
        "protein": {
          "$ref": "#/$defs/ProteinChange",
          "description": "Explicit substitution using checked one-letter or three-letter amino-acid codes."
        },
        "query": {
          "$ref": "#/$defs/MyVariantQuery",
          "description": "Raw MyVariant query, passed and echoed unchanged; requires --source myvariant."
        },
        "region": {
          "$ref": "#/$defs/VariantRegion",
          "description": "Exact one-based inclusive MyVariant region, such as chr7:55259500-55259600; requires --build."
        },
        "source": {
          "$ref": "#/$defs/VariantSearchSource",
          "description": "Explicit source language; required for a raw query."
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Save an exact registry document to an explicit destination.",
      "properties": {
        "command": {
          "const": "trial_document",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/Text",
          "description": "Exact filename from the registry manifest; never a URL or inferred path.",
          "x-positional": 1
        },
        "input": {
          "$ref": "#/$defs/NctId",
          "description": "Exact registry identity.",
          "x-positional": 0
        },
        "replace": {
          "default": false,
          "description": "Replace an existing file only when explicitly requested.",
          "type": "boolean"
        },
        "save": {
          "$ref": "#/$defs/Text",
          "description": "Caller-owned file or existing folder."
        }
      },
      "required": [
        "command",
        "input",
        "file",
        "save"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Retrieve exact trial cards and source protocol sections.",
      "properties": {
        "command": {
          "const": "get_trial",
          "type": "string"
        },
        "input": {
          "description": "One to twenty exact NCT identifiers, in caller order.",
          "items": {
            "$ref": "#/$defs/NctId"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
          "x-positional": 0
        },
        "limit": {
          "default": 10,
          "description": "Whole-record count per source collection page; text fragments follow the text budget.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Character offset for ClinicalTrials.gov eligibility or NCI summary; whole-record offset for other collections.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Checked stored source record, supplied by a continuation."
        },
        "section": {
          "description": "Optional intact source sections. Default cards only; diseases and summary require NCI. NCI locations, contacts, references and documents are unsupported.",
          "items": {
            "$ref": "#/$defs/TrialSection"
          },
          "type": "array",
          "x-trailing-section": true
        },
        "source": {
          "$ref": "#/$defs/TrialSource",
          "description": "Explicit provider; defaults to ClinicalTrials.gov and never falls back."
        }
      },
      "required": [
        "command",
        "input"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Search ClinicalTrials.gov without local screening.",
      "properties": {
        "age": {
          "description": "Age in years; unstated source bounds count as no limit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "command": {
          "const": "search_trial",
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/Text",
          "description": "Registry condition text, or an NCIt code for NCI; use --keyword for NCI free text."
        },
        "count_only": {
          "default": false,
          "description": "Source total only; no returned study rows.",
          "type": "boolean"
        },
        "criteria": {
          "$ref": "#/$defs/Text",
          "description": "Search literal registry eligibility text for discovery only; no eligibility judgment."
        },
        "distance": {
          "$ref": "#/$defs/Text",
          "description": "Source distance with explicit mi or km units."
        },
        "facility": {
          "$ref": "#/$defs/Text",
          "description": "Exact registry facility field; cannot combine with radius."
        },
        "gene": {
          "$ref": "#/$defs/GeneInput",
          "description": "Resolve one checked gene for registry text discovery only; no eligibility judgment."
        },
        "has_results": {
          "default": false,
          "description": "Require posted source results.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/NctId",
          "description": "Exact NCT identity in a conjunction with other filters."
        },
        "intervention": {
          "$ref": "#/$defs/Text",
          "description": "Literal source intervention text."
        },
        "keyword": {
          "$ref": "#/$defs/Text",
          "description": "NCI free text; explicit keyword mode never substitutes for a disease identity."
        },
        "lat": {
          "$ref": "#/$defs/Text",
          "description": "Radius center latitude in degrees."
        },
        "limit": {
          "default": 10,
          "description": "Headers per page; NCI applies its own lower publisher limit.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "lon": {
          "$ref": "#/$defs/Text",
          "description": "Radius center longitude in degrees."
        },
        "next_page": {
          "$ref": "#/$defs/Text",
          "description": "Opaque registry continuation; keep filters unchanged."
        },
        "phase": {
          "$ref": "#/$defs/PhaseFilter",
          "description": "Registry phase: 1, 2, 3, 4, early-1, not-applicable, 1/2 or 2/3."
        },
        "query": {
          "$ref": "#/$defs/Text",
          "description": "General registry discovery text.",
          "x-positional": 0
        },
        "sex": {
          "$ref": "#/$defs/TrialSex",
          "description": "Registry sex facet."
        },
        "source": {
          "$ref": "#/$defs/TrialSource",
          "description": "Explicit provider; defaults to ClinicalTrials.gov and never falls back."
        },
        "sponsor": {
          "$ref": "#/$defs/Text",
          "description": "Exact lead sponsor field."
        },
        "sponsor_type": {
          "$ref": "#/$defs/SponsorType",
          "description": "Registry sponsor funding facet."
        },
        "status": {
          "$ref": "#/$defs/TrialStatus",
          "description": "Exact registry overall status."
        },
        "study_type": {
          "$ref": "#/$defs/StudyType",
          "description": "Exact registry study type."
        },
        "updated_since": {
          "$ref": "#/$defs/PartialDate",
          "description": "First included registry update date."
        },
        "updated_until": {
          "$ref": "#/$defs/PartialDate",
          "description": "Last included registry update date."
        },
        "variant": {
          "$ref": "#/$defs/Text",
          "description": "Literal variant text for registry discovery only; no eligibility judgment."
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Save a publisher PDF to an explicit destination.",
      "properties": {
        "command": {
          "const": "article_pdf",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/ArticleInput",
          "description": "Article identity.",
          "x-positional": 0
        },
        "replace": {
          "default": false,
          "description": "Replace an existing file only when explicitly requested.",
          "type": "boolean"
        },
        "save": {
          "$ref": "#/$defs/Text",
          "description": "Destination file or existing folder."
        }
      },
      "required": [
        "command",
        "input",
        "save"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Read source citation evidence.",
      "properties": {
        "cited": {
          "$ref": "#/$defs/ArticleInput",
          "description": "Cited PMID, PMC identity or DOI.",
          "x-positional": 1
        },
        "citing": {
          "$ref": "#/$defs/ArticleInput",
          "description": "Citing PMID, PMC identity or DOI.",
          "x-positional": 0
        },
        "command": {
          "const": "article_evidence",
          "type": "string"
        },
        "fulltext": {
          "default": false,
          "description": "Include the citing paper's own explicit reference paragraphs.",
          "type": "boolean"
        },
        "offset": {
          "default": 0,
          "description": "Context fragment position returned by the advancing step.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "paragraph_offset": {
          "default": 0,
          "description": "Full-text fragment position returned by the advancing step.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Stored checked source scan and original hit positions."
        }
      },
      "required": [
        "command",
        "citing",
        "cited"
      ],
      "type": "object"
    },
