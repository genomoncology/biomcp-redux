{
  "$defs": {
    "ArticleInput": {
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|PPR[0-9]*[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "ArticleSectionWord": {
      "description": "Article section request including all landed sections.",
      "enum": [
        "annotations",
        "fulltext",
        "supplements",
        "tldr",
        "citations",
        "indexing",
        "pdf",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Normalized text-mined entities from PubTator3.",
        " Licensed PMC body outline.",
        " Supplementary files confirmed by PMC metadata.",
        " Machine-written Semantic Scholar summary and counts.",
        " Citation counts from NIH iCite.",
        " MeSH, keywords and author indexing from the citation.",
        " Publisher PDF link without downloading.",
        " Every landed article section."
      ]
    },
    "ArticleSort": {
      "description": "Article ordering supported by this command.",
      "enum": [
        "rank",
        "date",
        "citations"
      ],
      "type": "string"
    },
    "ArticleSource": {
      "description": "Source selectors supported by article search.",
      "enum": [
        "pubmed",
        "europepmc",
        "litvar",
        "semantic-scholar",
        "litsense",
        "pubtator"
      ],
      "type": "string"
    },
    "ArticleType": {
      "description": "Publication-type selectors sent to the named sources.",
      "enum": [
        "trial",
        "randomized",
        "review",
        "systematic_review",
        "meta_analysis",
        "guideline",
        "case_report"
      ],
      "type": "string"
    },
    "Cytoband": {
      "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y)[pq][1-9][0-9](\\.[0-9]+)?$",
      "type": "string"
    },
    "EdgeSource": {
      "description": "Graph edge provider, independent of article search providers.",
      "enum": [
        "icite",
        "semantic-scholar"
      ],
      "type": "string"
    },
    "GeneInput": {
      "pattern": "\\S",
      "type": "string"
    },
    "GeneSectionWord": {
      "description": "A section request word, including expansion to all landed sections.",
      "enum": [
        "protein",
        "civic",
        "clingen",
        "constraint",
        "expression",
        "pathways",
        "oncokb",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Reviewed human proteins.",
        " CIViC gene curation.",
        " ClinGen validity and dosage.",
        " Population constraint metrics.",
        " Human Protein Atlas expression.",
        " Human Reactome pathways.",
        " Keyed OncoKB annotations.",
        " Every landed section."
      ]
    },
    "LocusGroup": {
      "description": "HGNC locus group, separate from a missing source value.",
      "enum": [
        "protein_coding",
        "non_coding_rna",
        "pseudogene",
        "phenotype",
        "other"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Protein coding.",
        " Non-coding RNA.",
        " Pseudogene.",
        " Phenotype.",
        " HGNC's stated other group."
      ]
    },
    "NctId": {
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PhaseFilter": {
      "description": "Explicit source phase selection, including the registry's combined phases.",
      "enum": [
        "early-1",
        "1",
        "2",
        "3",
        "4",
        "not-applicable",
        "1/2",
        "2/3"
      ],
      "type": "string"
    },
    "RetractionFilter": {
      "description": "Native retraction inclusion policy.",
      "enum": [
        "include",
        "exclude"
      ],
      "type": "string"
    },
    "SheetRows": {
      "pattern": "^[1-9][0-9]*-[1-9][0-9]*$",
      "type": "string"
    },
    "SponsorType": {
      "description": "Registry funding category facet.",
      "enum": [
        "nih",
        "fed",
        "industry",
        "other"
      ],
      "type": "string"
    },
    "StudyType": {
      "description": "Source-native registry value.",
      "enum": [
        "INTERVENTIONAL",
        "OBSERVATIONAL",
        "EXPANDED_ACCESS"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "TrialSection": {
      "description": "Available source protocol sections.",
      "enum": [
        "eligibility",
        "outcomes",
        "arms",
        "locations",
        "contacts",
        "references",
        "documents",
        "all"
      ],
      "type": "string"
    },
    "TrialSex": {
      "description": "Source-native registry value.",
      "enum": [
        "ALL",
        "FEMALE",
        "MALE"
      ],
      "type": "string"
    },
    "TrialStatus": {
      "description": "Source-native registry value.",
      "enum": [
        "ACTIVE_NOT_RECRUITING",
        "COMPLETED",
        "ENROLLING_BY_INVITATION",
        "NOT_YET_RECRUITING",
        "RECRUITING",
        "SUSPENDED",
        "TERMINATED",
        "WITHDRAWN",
        "AVAILABLE",
        "NO_LONGER_AVAILABLE",
        "APPROVED_FOR_MARKETING",
        "WITHHELD",
        "UNKNOWN"
      ],
      "type": "string"
    }
  },
  "$id": "biodata.request/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One checked query. Housekeeping actions are separate.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Save an exact registry document to an explicit destination.",
      "properties": {
        "command": {
          "const": "trial_document",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/Text",
          "description": "Exact filename from the registry manifest; never a URL or inferred path.",
          "x-positional": 1
        },
        "input": {
          "$ref": "#/$defs/NctId",
          "description": "Exact registry identity.",
          "x-positional": 0
        },
        "replace": {
          "default": false,
          "description": "Replace an existing file only when explicitly requested.",
          "type": "boolean"
        },
        "save": {
          "$ref": "#/$defs/Text",
          "description": "Caller-owned file or existing folder."
        }
      },
      "required": [
        "command",
        "input",
        "file",
        "save"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Retrieve exact trial cards and source protocol sections.",
      "properties": {
        "command": {
          "const": "get_trial",
          "type": "string"
        },
        "input": {
          "description": "One to twenty exact NCT identifiers, in caller order.",
          "items": {
            "$ref": "#/$defs/NctId"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
          "x-positional": 0
        },
        "limit": {
          "default": 10,
          "description": "Record count per source collection page; eligibility pages follow the text budget.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Character offset for eligibility or whole-record offset for a source collection.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Checked stored source record, supplied by a continuation."
        },
        "section": {
          "description": "Optional intact source sections. The default returns cards only.",
          "items": {
            "$ref": "#/$defs/TrialSection"
          },
          "type": "array",
          "x-trailing-section": true
        }
      },
      "required": [
        "command",
        "input"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Search ClinicalTrials.gov without local screening.",
      "properties": {
        "age": {
          "description": "Age in years; unstated source bounds count as no limit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "command": {
          "const": "search_trial",
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/Text",
          "description": "Condition-only source text."
        },
        "count_only": {
          "default": false,
          "description": "Source total only; no returned study rows.",
          "type": "boolean"
        },
        "criteria": {
          "$ref": "#/$defs/Text",
          "description": "Literal eligibility-field discovery text."
        },
        "distance": {
          "$ref": "#/$defs/Text",
          "description": "Source distance with explicit mi or km units."
        },
        "facility": {
          "$ref": "#/$defs/Text",
          "description": "Exact registry facility field; cannot combine with radius."
        },
        "gene": {
          "$ref": "#/$defs/GeneInput",
          "description": "Resolve one checked gene before registry discovery."
        },
        "has_results": {
          "default": false,
          "description": "Require posted source results.",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/NctId",
          "description": "Exact NCT identity in a conjunction with other filters."
        },
        "intervention": {
          "$ref": "#/$defs/Text",
          "description": "Literal source intervention text."
        },
        "lat": {
          "$ref": "#/$defs/Text",
          "description": "Radius center latitude in degrees."
        },
        "limit": {
          "default": 10,
          "description": "Headers per page; default ten, maximum one hundred.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "lon": {
          "$ref": "#/$defs/Text",
          "description": "Radius center longitude in degrees."
        },
        "next_page": {
          "$ref": "#/$defs/Text",
          "description": "Opaque registry continuation; keep filters unchanged."
        },
        "phase": {
          "$ref": "#/$defs/PhaseFilter",
          "description": "Registry phase: 1, 2, 3, 4, early-1, not-applicable, 1/2 or 2/3."
        },
        "query": {
          "$ref": "#/$defs/Text",
          "description": "General registry discovery text.",
          "x-positional": 0
        },
        "sex": {
          "$ref": "#/$defs/TrialSex",
          "description": "Registry sex facet."
        },
        "sponsor": {
          "$ref": "#/$defs/Text",
          "description": "Exact lead sponsor field."
        },
        "sponsor_type": {
          "$ref": "#/$defs/SponsorType",
          "description": "Registry sponsor funding facet."
        },
        "status": {
          "$ref": "#/$defs/TrialStatus",
          "description": "Exact registry overall status."
        },
        "study_type": {
          "$ref": "#/$defs/StudyType",
          "description": "Exact registry study type."
        },
        "updated_since": {
          "$ref": "#/$defs/PartialDate",
          "description": "First included registry update date."
        },
        "updated_until": {
          "$ref": "#/$defs/PartialDate",
          "description": "Last included registry update date."
        },
        "variant": {
          "$ref": "#/$defs/Text",
          "description": "Caller-supplied variant discovery text; no eligibility inference."
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Save a publisher PDF to an explicit destination.",
      "properties": {
        "command": {
          "const": "article_pdf",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/ArticleInput",
          "description": "Article identity.",
          "x-positional": 0
        },
        "replace": {
          "default": false,
          "description": "Replace an existing file only when explicitly requested.",
          "type": "boolean"
        },
        "save": {
          "$ref": "#/$defs/Text",
          "description": "Destination file or existing folder."
        }
      },
      "required": [
        "command",
        "input",
        "save"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Read source citation evidence.",
      "properties": {
        "cited": {
          "$ref": "#/$defs/ArticleInput",
          "description": "Cited PMID, PMC identity or DOI.",
          "x-positional": 1
        },
        "citing": {
          "$ref": "#/$defs/ArticleInput",
          "description": "Citing PMID, PMC identity or DOI.",
          "x-positional": 0
        },
        "command": {
          "const": "article_evidence",
          "type": "string"
        },
        "fulltext": {
          "default": false,
          "description": "Include the citing paper's own explicit reference paragraphs.",
          "type": "boolean"
        },
        "offset": {
          "default": 0,
          "description": "Context fragment position returned by the advancing step.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "paragraph_offset": {
          "default": 0,
          "description": "Full-text fragment position returned by the advancing step.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Stored checked source scan and original hit positions."
        }
      },
      "required": [
        "command",
        "citing",
        "cited"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Source-native paper recommendations.",
      "properties": {
        "command": {
          "const": "article_recommend",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "Maximum recommendations requested, in native order.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "negative": {
          "default": [],
          "description": "Up to ten negative paper identities.",
          "items": {
            "$ref": "#/$defs/ArticleInput"
          },
          "maxItems": 10,
          "type": "array"
        },
        "offset": {
          "default": 0,
          "description": "Number of stored recommendations to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Fixed recommendation pool."
        },
        "seeds": {
          "description": "One to ten positive paper identities.",
          "items": {
            "$ref": "#/$defs/ArticleInput"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
          "x-positional": 0
        }
      },
      "required": [
        "command",
        "seeds"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Read a licensed supplementary file.",
      "properties": {
        "command": {
          "const": "article_supplement",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/Text",
          "description": "Exact file name from the supplements section.",
          "x-positional": 1
        },
        "find": {
          "$ref": "#/$defs/Text",
          "description": "Literal case-insensitive needle."
        },
        "input": {
          "$ref": "#/$defs/ArticleInput",
          "description": "PubMed or PMC identity.",
          "x-positional": 0
        },
        "offset": {
          "default": 0,
          "description": "Matching-row or text-fragment offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "replace": {
          "description": "Replace an existing destination only when explicitly requested with save.",
          "type": "boolean"
        },
        "rows": {
          "$ref": "#/$defs/SheetRows",
          "description": "Inclusive original row range."
        },
        "save": {
          "$ref": "#/$defs/Text",
          "description": "Save the whole original document to an explicit file or existing folder."
        },
        "sheet": {
          "$ref": "#/$defs/Text",
          "description": "Sheet name for row selection."
        },
        "variant": {
          "$ref": "#/$defs/Text",
          "description": "Explicit protein substitution."
        }
      },
      "required": [
        "command",
        "input",
        "file"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "part"
          ]
        },
        {
          "required": [
            "find"
          ]
        },
        {
          "required": [
            "variant"
          ]
        },
        {
          "required": [
            "save"
          ]
        }
      ],
      "description": "Read licensed PMC body text.",
      "properties": {
        "command": {
          "const": "article_text",
          "type": "string"
        },
        "find": {
          "$ref": "#/$defs/Text",
          "description": "Case-insensitive literal text to find."
        },
        "input": {
          "$ref": "#/$defs/ArticleInput",
          "description": "PubMed or PMC identity. DOI selectors are not accepted by the reader.",
          "x-positional": 0
        },
        "offset": {
          "default": 0,
          "description": "Number of matching rows already returned.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "part": {
          "description": "One-based outline part number.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "replace": {
          "description": "Replace an existing destination only when explicitly requested with save.",
          "type": "boolean"
        },
        "save": {
          "$ref": "#/$defs/Text",
          "description": "Save the whole original document to an explicit file or existing folder."
        },
        "variant": {
          "$ref": "#/$defs/Text",
          "description": "Explicit checked protein substitution."
        }
      },
      "required": [
        "command",
        "input"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Papers citing one PMID.",
      "properties": {
        "command": {
          "const": "article_citations",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "Maximum papers on one page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of pool items to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pmid": {
          "$ref": "#/$defs/ArticleInput",
          "description": "PMID, PMC or DOI; iCite accepts only a PMID.",
          "x-positional": 0
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Fixed snapshot from an earlier page."
        },
        "source": {
          "$ref": "#/$defs/EdgeSource",
          "default": "icite",
          "description": "Graph provider; iCite remains the default."
        }
      },
      "required": [
        "command",
        "pmid"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Papers referenced by one PMID.",
      "properties": {
        "command": {
          "const": "article_references",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "Maximum papers on one page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of pool items to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pmid": {
          "$ref": "#/$defs/ArticleInput",
          "description": "PMID, PMC or DOI; iCite accepts only a PMID.",
          "x-positional": 0
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Fixed snapshot from an earlier page."
        },
        "source": {
          "$ref": "#/$defs/EdgeSource",
          "default": "icite",
          "description": "Graph provider; iCite remains the default."
        }
      },
      "required": [
        "command",
        "pmid"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Retrieve PubMed article cards.",
      "properties": {
        "command": {
          "const": "get_article",
          "type": "string"
        },
        "input": {
          "description": "PubMed, PMC or DOI identifiers in input order.",
          "items": {
            "$ref": "#/$defs/ArticleInput"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
          "x-positional": 0
        },
        "section": {
          "description": "Requested section words; trailing words and --section share this field.",
          "items": {
            "$ref": "#/$defs/ArticleSectionWord"
          },
          "type": "array",
          "x-trailing-section": true
        }
      },
      "required": [
        "command",
        "input"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "gene"
          ]
        },
        {
          "required": [
            "variant"
          ]
        },
        {
          "required": [
            "disease"
          ]
        },
        {
          "required": [
            "drug"
          ]
        },
        {
          "required": [
            "author"
          ]
        },
        {
          "required": [
            "journal"
          ]
        },
        {
          "required": [
            "since"
          ]
        },
        {
          "required": [
            "until"
          ]
        },
        {
          "required": [
            "type"
          ]
        }
      ],
      "description": "Search PubMed article identities.",
      "properties": {
        "author": {
          "$ref": "#/$defs/Text",
          "description": "Author words sent to PubMed's author field."
        },
        "command": {
          "const": "search_article",
          "type": "string"
        },
        "disease": {
          "$ref": "#/$defs/Text",
          "description": "Disease words."
        },
        "drug": {
          "$ref": "#/$defs/Text",
          "description": "Drug words."
        },
        "gene": {
          "$ref": "#/$defs/GeneInput",
          "description": "Gene input; PubMed resolves it through HGNC."
        },
        "journal": {
          "$ref": "#/$defs/Text",
          "description": "Journal words sent to PubMed's journal field."
        },
        "limit": {
          "default": 10,
          "description": "Maximum page length.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "no_preprints": {
          "description": "Exclude preprints using the source's native filter.",
          "type": "boolean"
        },
        "offset": {
          "default": 0,
          "description": "Number of pool items to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "open_access": {
          "description": "Require the source's native open-access filter; Semantic Scholar means a public PDF.",
          "type": "boolean"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Stable snapshot from an earlier response."
        },
        "retracted": {
          "$ref": "#/$defs/RetractionFilter",
          "description": "Include retracted papers by default, or exclude them using a native filter.",
          "x-cli-flags": {
            "exclude-retracted": "exclude",
            "include-retracted": "include"
          }
        },
        "since": {
          "$ref": "#/$defs/PartialDate",
          "description": "Inclusive lower publication-date bound at the stated precision; PubMed matches either electronic or print date."
        },
        "sort": {
          "$ref": "#/$defs/ArticleSort",
          "default": "rank",
