{
  "$defs": {
    "KeyHelp": {
      "additionalProperties": false,
      "description": "Configuration names for one keyed source; never includes credential values.",
      "properties": {
        "config": {
          "$ref": "#/$defs/Text",
          "description": "Configuration file key path."
        },
        "environment": {
          "$ref": "#/$defs/Text",
          "description": "Environment variable name."
        },
        "guidance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional source-specific key guidance."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Source name."
        }
      },
      "required": [
        "source",
        "config",
        "environment"
      ],
      "type": "object"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "hpa",
        "uniprot",
        "gwas",
        "gnomad",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "cbioportal"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " Human Protein Atlas.",
        " UniProt.",
        " GWAS Catalog v2.",
        " gnomAD.",
        " ClinGen.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " Public cBioPortal with study-specific reuse terms."
      ]
    },
    "SourceNotice": {
      "description": "A provider query interpretation notice.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph_truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not_found_words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "words"
          ],
          "type": "object"
        }
      ]
    },
    "SourceOutcome": {
      "additionalProperties": false,
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched": {
          "description": "Retrieved identity depth.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Provider query notices that do not indicate failure.",
          "items": {
            "$ref": "#/$defs/SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        }
      },
      "required": [
        "source",
        "state"
      ],
      "type": "object"
    },
    "SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind",
        "args"
      ],
      "type": "object"
    },
    "StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biomcp.key/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One versioned command response; schema identity comes only from its body type.",
  "properties": {
    "next": {
      "description": "Available next commands.",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Search page metadata."
    },
    "problems": {
      "description": "Rejected source fields.",
      "items": {
        "$ref": "#/$defs/Problem"
      },
      "type": "array"
    },
    "query": {
      "description": "Parsed query.",
      "type": "null"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeyHelp"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.key/1",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
