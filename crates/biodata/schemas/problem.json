{
  "$defs": {
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "hpa",
        "uniprot",
        "gnomad",
        "clingen",
        "pubmed",
        "europepmc",
        "pubtator",
        "ctgov",
        "civic",
        "oncokb"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " Human Protein Atlas.",
        " UniProt.",
        " gnomAD.",
        " ClinGen.",
        " PubMed.",
        " Europe PMC.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " CIViC.",
        " OncoKB."
      ]
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.problem/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A field that could not be accepted from a source record.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ProblemCode",
      "description": "Why the field value was not accepted."
    },
    "field": {
      "description": "The biodata field name.",
      "type": "string"
    },
    "record": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "The record's canonical identifier, when known."
    },
    "source": {
      "$ref": "#/$defs/Source",
      "description": "The source that supplied the record."
    }
  },
  "required": [
    "source",
    "field",
    "code"
  ],
  "title": "Problem",
  "type": "object"
}
