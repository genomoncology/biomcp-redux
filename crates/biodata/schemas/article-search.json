{
  "$defs": {
    "ArticleSort": {
      "description": "Article ordering supported by this command.",
      "enum": [
        "rank",
        "date"
      ],
      "type": "string"
    },
    "ArticleSource": {
      "description": "Source selectors supported by article search.",
      "enum": [
        "pubmed",
        "europepmc"
      ],
      "type": "string"
    },
    "ArticleType": {
      "description": "Publication-type selectors sent to PubMed.",
      "enum": [
        "trial",
        "randomized",
        "review",
        "systematic_review",
        "meta_analysis",
        "guideline",
        "case_report"
      ],
      "type": "string"
    },
    "GeneInput": {
      "pattern": "\\S",
      "type": "string"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.article-search/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "text"
      ]
    },
    {
      "required": [
        "gene"
      ]
    },
    {
      "required": [
        "variant"
      ]
    },
    {
      "required": [
        "disease"
      ]
    },
    {
      "required": [
        "drug"
      ]
    },
    {
      "required": [
        "author"
      ]
    },
    {
      "required": [
        "journal"
      ]
    },
    {
      "required": [
        "since"
      ]
    },
    {
      "required": [
        "until"
      ]
    },
    {
      "required": [
        "type"
      ]
    }
  ],
  "description": "Checked search selectors and pool cursor.",
  "properties": {
    "author": {
      "$ref": "#/$defs/Text",
      "description": "Author words sent to PubMed's author field."
    },
    "disease": {
      "$ref": "#/$defs/Text",
      "description": "Disease words."
    },
    "drug": {
      "$ref": "#/$defs/Text",
      "description": "Drug words."
    },
    "gene": {
      "$ref": "#/$defs/GeneInput",
      "description": "Gene input resolved through HGNC."
    },
    "journal": {
      "$ref": "#/$defs/Text",
      "description": "Journal words sent to PubMed's journal field."
    },
    "limit": {
      "default": 10,
      "description": "Maximum page length.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Number of pool items to skip.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "pool": {
      "$ref": "#/$defs/Text",
      "description": "Stable snapshot from an earlier response."
    },
    "since": {
      "$ref": "#/$defs/PartialDate",
      "description": "Inclusive lower publication-date bound at the stated precision."
    },
    "sort": {
      "$ref": "#/$defs/ArticleSort",
      "default": "rank",
      "description": "Native provider order."
    },
    "source": {
      "default": [
        "pubmed"
      ],
      "description": "Sources in caller order; defaults to PubMed.",
      "items": {
        "$ref": "#/$defs/ArticleSource"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
    },
    "text": {
      "$ref": "#/$defs/Text",
      "description": "Words sent to PubMed in its default fields.",
      "x-positional": 0
    },
    "type": {
      "$ref": "#/$defs/ArticleType",
      "description": "Publication-type filter."
    },
    "until": {
      "$ref": "#/$defs/PartialDate",
      "description": "Inclusive upper publication-date bound at the stated precision."
    },
    "variant": {
      "$ref": "#/$defs/Text",
      "description": "Variant words."
    }
  },
  "title": "ArticleSearch",
  "type": "object"
}
