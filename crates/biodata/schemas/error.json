{
  "$defs": {
    "ErrorCode": {
      "description": "The stable error code for an invalid schema request.",
      "enum": [
        "usage.schema",
        "usage.arguments",
        "usage.retired",
        "local.failure",
        "pool.expired",
        "usage.pool_mismatch",
        "usage.too_many_pmids",
        "usage.unsupported_filter"
      ],
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "$ref": "#/$defs/ErrorMessage"
        },
        "option": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterOption"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorMessage": {
      "description": "Fixed input-free error and migration guidance.",
      "enum": [
        "a selected source does not support the requested filters",
        "citation ordering exceeds the PMID limit; narrow the search",
        "expected schema <known artifact id>",
        "expected a supported command with checked arguments",
        "local configuration, cache or recording failed",
        "NCI disease filters require an NCIt identifier such as C3224; use --keyword for free text",
        "get variant needs an rsID, CAid, ClinVar Variation ID or reference-qualified HGVS; chromosome notation needs --build; use search variant --gene BRAF --protein V600E for gene/protein shorthand",
        "the registry cannot bind --facility and radius to one site; choose one filter",
        "retired; use: --criteria for literal registry eligibility text",
        "retired; use: --variant for explicit discovery text",
        "renamed; use: --updated-since",
        "renamed; use: --updated-until",
        "renamed; use: --has-results",
        "renamed; use: --next-page with the opaque registry cursor",
        "retired; registry discovery never invents chemical aliases",
        "use: get gene <gene>",
        "use: get gene <gene> pathways",
        "use: search trial --gene <gene>",
        "use: search article --gene <gene>",
        "use: search drug --target <gene>",
        "moved to the cell line entity",
        "moved to the variant entity",
        "use: --locus-group",
        "use: search article <text>",
        "no score blends in 1.0; each source keeps its own order",
        "use: get article <id> pdf",
        "use: --since",
        "use: --until",
        "use: --sort citations",
        "use: --gene",
        "use: --disease",
        "use: --author",
        "use: supplements",
        "use: article supplement <id> <file>",
        "use: fulltext",
        "use: article text <id> --part <n>",
        "use: article supplement <id> <file> --find <text>",
        "use: get article <id> annotations",
        "use: get article <id>...",
        "use: search article --variant <variant>",
        "use: search article --disease <disease>",
        "use: search article --drug <drug>",
        "moved to the pathway entity",
        "use: --band",
        "dropped in 1.0",
        "use: expression",
        "moved to the drug entity",
        "moved to the diagnostic entity",
        "deferred",
        "pool expired; restart the search",
        "pool selectors do not match this search"
      ],
      "type": "string"
    },
    "ErrorSchema": {
      "enum": [
        "biomcp.error/1"
      ],
      "type": "string"
    },
    "ErrorStatus": {
      "description": "The status of an invalid schema request.",
      "enum": [
        "usage",
        "local",
        "expired"
      ],
      "type": "string"
    },
    "FilterOption": {
      "enum": [
        "TEXT",
        "--gene",
        "--variant",
        "--disease",
        "--drug",
        "--author",
        "--journal",
        "--since",
        "--until",
        "--type",
        "--sort date",
        "--open-access",
        "--no-preprints",
        "--exclude-retracted",
        "--criteria",
        "--intervention",
        "--status",
        "--phase",
        "--study-type",
        "--sex",
        "--age",
        "--facility",
        "--lat",
        "--sponsor",
        "--sponsor-type",
        "--updated-since",
        "--updated-until",
        "--id",
        "--has-results",
        "--keyword"
      ],
      "type": "string"
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "hpa",
        "uniprot",
        "gwas",
        "gnomad",
        "clinvar",
        "erepo",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " Human Protein Atlas.",
        " UniProt.",
        " GWAS Catalog v2.",
        " gnomAD.",
        " ClinVar assertions.",
        " ClinGen Evidence Repository.",
        " ClinGen.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator."
      ]
    },
    "Step": {
      "additionalProperties": false,
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind",
        "args"
      ],
      "type": "object"
    },
    "StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biomcp.error/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A versioned error response that never contains caller input.",
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    },
    "next": {
      "description": "Typed restart when a snapshot cannot answer this query.",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "type": "array"
    },
    "schema": {
      "$ref": "#/$defs/ErrorSchema"
    },
    "status": {
      "$ref": "#/$defs/ErrorStatus"
    }
  },
  "required": [
    "schema",
    "status",
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
