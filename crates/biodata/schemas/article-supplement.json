{
  "$defs": {
    "ArticleInput": {
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "SheetRows": {
      "pattern": "^[1-9][0-9]*-[1-9][0-9]*$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.article-supplement/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read a checked supplement file or page its original rows.",
  "properties": {
    "file": {
      "$ref": "#/$defs/Text",
      "description": "Exact file name from the supplements section.",
      "x-positional": 1
    },
    "find": {
      "$ref": "#/$defs/Text",
      "description": "Literal case-insensitive needle."
    },
    "input": {
      "$ref": "#/$defs/ArticleInput",
      "description": "PubMed or PMC identity.",
      "x-positional": 0
    },
    "offset": {
      "default": 0,
      "description": "Matching-row or text-fragment offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "rows": {
      "$ref": "#/$defs/SheetRows",
      "description": "Inclusive original row range."
    },
    "sheet": {
      "$ref": "#/$defs/Text",
      "description": "Sheet name for row selection."
    },
    "variant": {
      "$ref": "#/$defs/Text",
      "description": "Explicit protein substitution."
    }
  },
  "required": [
    "input",
    "file"
  ],
  "title": "ArticleSupplement",
  "type": "object"
}
