{
  "$defs": {
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ],
      "x-extensible-enum": [
        "GRCh37",
        "GRCh38"
      ]
    },
    "Reply_EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?$",
      "type": "string"
    },
    "Reply_Fraction": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "Reply_GeneRef": {
      "description": "A source-stated gene reference; its label never implies an identifier.",
      "properties": {
        "ensembl_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hgnc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_HgncId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Reply_Text"
        },
        "ncbi_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_NcbiGeneId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Reply_GenotypeFilter": {
      "description": "Source count filtering state.",
      "enum": [
        "raw"
      ],
      "type": "string"
    },
    "Reply_HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_HgvsText": {
      "description": "Reference-qualified notation with its original text, without a molecular parse.",
      "pattern": "^(?!(?:[NX]P_[0-9]{6}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|[NX]P_(?!000)[0-9]{9}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENSP[0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))p0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))(?:\\([^)]*\\))?:[gcnrmo]\\.)(?![^:()]+\\((?:[NX]P_[0-9]{6}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|[NX]P_(?!000)[0-9]{9}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENSP[0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))p0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))\\):[gcnrmo]\\.)(?:(?:N[CGMPRTW]|X[MPR])_(?:[0-9]{6}|(?!000)[0-9]{9})\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENS[GTP][0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))(?:[tp]0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))?)(?:\\((?:(?:(?:N[CGMPRTW]|X[MPR])_(?:[0-9]{6}|(?!000)[0-9]{9})\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENS[GTP][0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))(?:[tp]0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))?)|[A-Za-z][A-Za-z0-9._/@-]{0,254})\\))?:(?:[gcnrpmo]\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*|[pr]\\.(?:\\?|\\(\\?\\)|=|\\(=\\))|r\\.(?:spl\\??|\\(spl\\?\\)))$",
      "type": "string"
    },
    "Reply_LeafRef": {
      "oneOf": [
        {
          "properties": {
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source-qualified HGVS."
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_VariantId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source identifier."
            },
            "level": {
              "const": "allele",
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "properties": {
            "gene": {
              "$ref": "#/$defs/Reply_GeneRef",
              "description": "Source gene."
            },
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein HGVS."
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein label."
            },
            "level": {
              "const": "protein",
              "type": "string"
            }
          },
          "required": [
            "level",
            "gene"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PopulationDataType": {
      "description": "Dataset sequencing sample set.",
      "enum": [
        "exomes",
        "genomes",
        "joint"
      ],
      "type": "string"
    },
    "Reply_PopulationSex": {
      "description": "Sex stratum stated by a population source.",
      "enum": [
        "xx",
        "xy"
      ],
      "type": "string"
    },
    "Reply_Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "Reply_VariantId": {
      "description": "Published variant-level identifiers, with each identifier's level retained.",
      "pattern": "(^rs(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$|^CA(?=[0-9]{6,}(?:[^0-9]|$))(?:(?=[0-9]{6}(?:[^0-9]|$))0*(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})|(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}))$|^PA(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$|^VCV(?!000000000)[0-9]{9}(\\.[1-9][0-9]*)?$|^clinvar:(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$|^COS[VMN][1-9][0-9]*$|^ga4gh:VA\\.[A-Za-z0-9_-]{32}$)",
      "type": "string"
    },
    "Reply_VariantRef": {
      "description": "Checked source subject reference; at least one source identity or label is required.",
      "oneOf": [
        {
          "description": "Exact allele identifier or reference-qualified notation.",
          "properties": {
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source-qualified HGVS."
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_VariantId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source identifier."
            },
            "level": {
              "const": "allele",
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "description": "Protein-level assertion, without genomic conversion.",
          "properties": {
            "gene": {
              "$ref": "#/$defs/Reply_GeneRef",
              "description": "Source gene."
            },
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein HGVS."
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reply_Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein label."
            },
            "level": {
              "const": "protein",
              "type": "string"
            }
          },
          "required": [
            "level",
            "gene"
          ],
          "type": "object"
        },
        {
          "description": "Compound source profile, without an inferred allele.",
          "properties": {
            "label": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Complete source label."
            },
            "level": {
              "const": "profile",
              "type": "string"
            },
            "members": {
              "description": "Source member references in their native order.",
              "items": {
                "$ref": "#/$defs/Reply_LeafRef"
              },
              "type": "array"
            },
            "record": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Native profile ID."
            }
          },
          "required": [
            "level",
            "record",
            "label"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "biodata.population-frequency/6",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One checked stratum of one source dataset release.",
  "properties": {
    "allele_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "allele_frequency": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Fraction"
        },
        {
          "type": "null"
        }
      ]
    },
    "allele_number": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "ancestry_group": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "attribution": {
      "$ref": "#/$defs/Reply_Attribution"
    },
    "build": {
      "$ref": "#/$defs/Reply_Build"
    },
    "data_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PopulationDataType"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset": {
      "$ref": "#/$defs/Reply_Text"
    },
    "dataset_version": {
      "$ref": "#/$defs/Reply_Text"
    },
    "faf95": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Fraction"
        },
        {
          "type": "null"
        }
      ]
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/Reply_Text"
      },
      "type": "array"
    },
    "genotype_filter": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_GenotypeFilter"
        },
        {
          "type": "null"
        }
      ]
    },
    "grpmax_group": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "hemizygote_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "heteroplasmic_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "heteroplasmic_frequency": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Fraction"
        },
        {
          "type": "null"
        }
      ]
    },
    "heterozygote_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "homoplasmic_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "homoplasmic_frequency": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Fraction"
        },
        {
          "type": "null"
        }
      ]
    },
    "homozygote_count": {
      "format": "uint64",
