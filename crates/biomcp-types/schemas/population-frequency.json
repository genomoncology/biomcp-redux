{
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ]
    },
    "EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.[1-9][0-9]*)?$",
      "type": "string"
    },
    "FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "GeneRef": {
      "additionalProperties": false,
      "description": "A source-stated gene reference; its label never implies an identifier.",
      "properties": {
        "ensembl_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hgnc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HgncId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "ncbi_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NcbiGeneId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:[1-9][0-9]*$",
      "type": "string"
    },
    "HgvsText": {
      "description": "Reference-qualified notation with its original text, without a molecular parse.",
      "pattern": "^(?!(NP_|XP_|ENSP|LRG_[0-9]+p|[^:]*\\((NP_|XP_|ENSP|LRG_[0-9]+p))[^:]*:[gcnrmo]\\.)((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?)(\\(([A-Za-z][A-Za-z0-9._/@-]*|[A-Za-z0-9_.]+)\\))?:([gcnrpmo]\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*|[pr]\\.(\\?|\\(\\?\\)|=|\\(=\\))|r\\.(spl\\??|\\(spl\\?\\)))$",
      "type": "string"
    },
    "LeafRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source-qualified HGVS."
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VariantId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source identifier."
            },
            "level": {
              "const": "allele",
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "gene": {
              "$ref": "#/$defs/GeneRef",
              "description": "Source gene."
            },
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein HGVS."
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein label."
            },
            "level": {
              "const": "protein",
              "type": "string"
            }
          },
          "required": [
            "level",
            "gene"
          ],
          "type": "object"
        }
      ]
    },
    "NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PopulationDataType": {
      "description": "Dataset sequencing sample set.",
      "enum": [
        "exomes",
        "genomes",
        "joint"
      ],
      "type": "string"
    },
    "PopulationSex": {
      "description": "Sex stratum stated by a population source.",
      "enum": [
        "xx",
        "xy"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "VariantId": {
      "description": "Published variant-level identifiers, with each identifier's level retained.",
      "pattern": "^(rs[1-9][0-9]*|CA[0-9]{6,}|PA[1-9][0-9]*|VCV[0-9]{9}(\\.[1-9][0-9]*)?|clinvar:[1-9][0-9]*|COS[VMN][1-9][0-9]*|ga4gh:VA\\.[A-Za-z0-9_-]{32})$",
      "type": "string"
    },
    "VariantRef": {
      "description": "Checked source subject reference; at least one source identity or label is required.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Exact allele identifier or reference-qualified notation.",
          "properties": {
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source-qualified HGVS."
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VariantId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source identifier."
            },
            "level": {
              "const": "allele",
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Protein-level assertion, without genomic conversion.",
          "properties": {
            "gene": {
              "$ref": "#/$defs/GeneRef",
              "description": "Source gene."
            },
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein HGVS."
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein label."
            },
            "level": {
              "const": "protein",
              "type": "string"
            }
          },
          "required": [
            "level",
            "gene"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Compound source profile, without an inferred allele.",
          "properties": {
            "label": {
              "$ref": "#/$defs/Text",
              "description": "Complete source label."
            },
            "level": {
              "const": "profile",
              "type": "string"
            },
            "members": {
              "description": "Source member references in their native order.",
              "items": {
                "$ref": "#/$defs/LeafRef"
              },
              "type": "array"
            },
            "record": {
              "$ref": "#/$defs/Text",
              "description": "Native profile ID."
            }
          },
          "required": [
            "level",
            "record",
            "label"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "biodata.population-frequency/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One checked stratum of one source dataset release.",
  "properties": {
    "allele_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "allele_frequency": {
      "anyOf": [
        {
          "$ref": "#/$defs/FiniteNumber"
        },
        {
          "type": "null"
        }
      ]
    },
    "allele_number": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "ancestry_group": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    },
    "attribution": {
      "$ref": "#/$defs/Attribution"
    },
    "build": {
      "$ref": "#/$defs/Build"
    },
    "data_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopulationDataType"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset": {
      "$ref": "#/$defs/Text"
    },
    "dataset_version": {
      "$ref": "#/$defs/Text"
    },
    "faf95": {
      "anyOf": [
        {
          "$ref": "#/$defs/FiniteNumber"
        },
        {
          "type": "null"
        }
      ]
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/Text"
      },
      "type": "array"
    },
    "hemizygote_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "homozygote_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "sex": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopulationSex"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "$ref": "#/$defs/VariantRef"
    },
    "subset": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "subject",
    "build",
    "dataset",
    "dataset_version",
    "attribution"
  ],
  "title": "PopulationFrequency",
  "type": "object"
}
