{
  "$defs": {
    "Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ]
    },
    "Chromosome": {
      "description": "A primary chromosome in the caller's reference build.",
      "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y|MT)$",
      "type": "string"
    },
    "Cytoband": {
      "description": " A single nuclear cytogenetic band, without a range or location descriptor.",
      "pattern": "^([1-9]|1[0-9]|2[0-2]|X|Y)[pq][1-9][0-9](\\.[0-9]+)?$",
      "type": "string"
    },
    "EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.[1-9][0-9]*)?$",
      "type": "string"
    },
    "Gene": {
      "additionalProperties": false,
      "description": "Human gene identity and whole source annotations, independent of response cards.",
      "properties": {
        "aliases": {
          "description": "All stated HGNC aliases.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        },
        "ensembl_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Ensembl gene identifier, if stated."
        },
        "entrez_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NcbiGeneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "NCBI Gene identifier, if stated."
        },
        "hgnc_id": {
          "$ref": "#/$defs/HgncId",
          "description": "HGNC identifier."
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cytoband"
            },
            {
              "type": "null"
            }
          ],
          "description": "Single stated band, if available."
        },
        "locus_group": {
          "$ref": "#/$defs/LocusGroup",
          "description": "HGNC locus group."
        },
        "locus_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocusType"
            },
            {
              "type": "null"
            }
          ],
          "description": "HGNC locus type, if stated and recognized."
        },
        "mane": {
          "description": "Versioned MANE Select transcript pair, if stated.",
          "items": {
            "$ref": "#/$defs/Mane"
          },
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Gene name."
        },
        "omim": {
          "description": "All stated OMIM identifiers.",
          "items": {
            "$ref": "#/$defs/OmimId"
          },
          "type": "array"
        },
        "previous_symbols": {
          "description": "All stated previous symbols.",
          "items": {
            "$ref": "#/$defs/GeneSymbol"
          },
          "type": "array"
        },
        "spans": {
          "description": "Source intervals with explicit assembly and counting rule.",
          "items": {
            "$ref": "#/$defs/GenomicInterval"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/GeneStatus",
          "description": "HGNC record status."
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Summary"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whole attributed summary, if stated."
        },
        "symbol": {
          "$ref": "#/$defs/GeneSymbol",
          "description": "Source-preserved symbol."
        },
        "uniprot": {
          "description": "All stated UniProt base accessions.",
          "items": {
            "$ref": "#/$defs/UniProtAcc"
          },
          "type": "array"
        }
      },
      "required": [
        "hgnc_id",
        "symbol",
        "status",
        "locus_group",
        "name"
      ],
      "type": "object"
    },
    "GeneHeader": {
      "additionalProperties": false,
      "description": "Enough gene identity to choose a search result.",
      "properties": {
        "hgnc_id": {
          "$ref": "#/$defs/HgncId",
          "description": "HGNC identifier."
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cytoband"
            },
            {
              "type": "null"
            }
          ],
          "description": "A single stated band, if available."
        },
        "locus_group": {
          "$ref": "#/$defs/LocusGroup",
          "description": "HGNC locus group."
        },
        "match": {
          "anyOf": [
            {
              "$ref": "#/$defs/Match"
            },
            {
              "type": "null"
            }
          ],
          "description": "Match information when this header answers an input."
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Gene name."
        },
        "status": {
          "$ref": "#/$defs/GeneStatus",
          "description": "HGNC record status."
        },
        "symbol": {
          "$ref": "#/$defs/GeneSymbol",
          "description": "Source-preserved symbol."
        }
      },
      "required": [
        "hgnc_id",
        "symbol",
        "locus_group",
        "status",
        "name"
      ],
      "type": "object"
    },
    "GeneStatus": {
      "description": "HGNC approval status.",
      "enum": [
        "approved",
        "withdrawn"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " An HGNC approved record.",
        " An HGNC withdrawn record."
      ]
    },
    "GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "GenomicInterval": {
      "additionalProperties": false,
      "description": "An assembly-qualified zero-based half-open source interval.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated assembly, omitted when absent."
        },
        "chromosome": {
          "$ref": "#/$defs/Chromosome",
          "description": "Canonical primary chromosome."
        },
        "span": {
          "$ref": "#/$defs/Span0",
          "description": "Checked zero-based half-open bounds; an empty span remains valid."
        },
        "strand": {
          "anyOf": [
            {
              "$ref": "#/$defs/Strand"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated strand, if available."
        }
      },
      "required": [
        "chromosome",
        "span"
      ],
      "type": "object"
    },
    "HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:[1-9][0-9]*$",
      "type": "string"
    },
    "HgncStatus": {
      "description": "HGNC's stated withdrawn-file status.",
      "enum": [
        "entry_withdrawn",
        "merged_split"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Entry withdrawn.",
        " Entry merged or split."
      ]
    },
    "LocusGroup": {
      "description": "HGNC locus group, separate from a missing source value.",
      "enum": [
        "protein_coding",
        "non_coding_rna",
        "pseudogene",
        "phenotype",
        "other"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Protein coding.",
        " Non-coding RNA.",
        " Pseudogene.",
        " Phenotype.",
        " HGNC's stated other group."
      ]
    },
    "LocusType": {
      "description": "HGNC locus type; Unknown is a source-stated value, distinct from absence.",
      "enum": [
        "gene_with_protein_product",
        "rna_cluster",
        "long_non_coding_rna",
        "micro_rna",
        "misc_rna",
        "ribosomal_rna",
        "small_nuclear_rna",
        "small_nucleolar_rna",
        "transfer_rna",
        "vault_rna",
        "y_rna",
        "phenotype_only",
        "pseudogene",
        "complex_locus_constituent",
        "endogenous_retrovirus",
        "fragile_site",
        "immunoglobulin_gene",
        "immunoglobulin_pseudogene",
        "readthrough",
        "region",
        "t_cell_receptor_gene",
        "t_cell_receptor_pseudogene",
        "transposable_element",
        "unknown",
        "virus_integration_site"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC gene with protein product.",
        " HGNC rna cluster.",
        " HGNC long non coding rna.",
        " HGNC micro rna.",
        " HGNC misc rna.",
        " HGNC ribosomal rna.",
        " HGNC small nuclear rna.",
        " HGNC small nucleolar rna.",
        " HGNC transfer rna.",
        " HGNC vault rna.",
        " HGNC y rna.",
        " HGNC phenotype only.",
        " HGNC pseudogene.",
        " HGNC complex locus constituent.",
        " HGNC endogenous retrovirus.",
        " HGNC fragile site.",
        " HGNC immunoglobulin gene.",
        " HGNC immunoglobulin pseudogene.",
        " HGNC readthrough.",
        " HGNC region.",
        " HGNC t cell receptor gene.",
        " HGNC t cell receptor pseudogene.",
        " HGNC transposable element.",
        " HGNC unknown.",
        " HGNC virus integration site."
      ]
    },
    "Mane": {
      "additionalProperties": false,
      "description": "A source-stated MANE pair with versioned sequence accessions.",
      "properties": {
        "ensembl": {
          "description": "Versioned Ensembl accession.",
          "pattern": "^ENST[0-9]{11}\\.[1-9][0-9]*$",
          "type": "string"
        },
        "refseq": {
          "description": "Versioned RefSeq accession.",
          "pattern": "^(NM_|NR_)([0-9]{6}|[0-9]{9})\\.[1-9][0-9]*$",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ManeStatus",
          "description": "Source-stated transcript status."
        }
      },
      "required": [
        "status",
        "refseq",
        "ensembl"
      ],
      "type": "object"
    },
    "ManeStatus": {
      "description": "The source-stated MANE transcript status.",
      "enum": [
        "select",
        "plus_clinical"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " MANE Select transcript pair.",
        " MANE Plus Clinical transcript pair."
      ]
    },
    "Match": {
      "additionalProperties": false,
      "description": "A source-stated match, preserving the text that matched.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MatchKind",
          "description": "The match category."
        },
        "text": {
          "$ref": "#/$defs/Text",
          "description": "The source text that matched the input."
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    "MatchKind": {
      "description": "How a source matched a gene input.",
      "enum": [
        "symbol",
        "previous_symbol",
        "alias",
        "ncbi_alias",
        "hgnc_id",
        "entrez_id",
        "ensembl_id",
        "band"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Current symbol.",
        " Previous symbol.",
        " HGNC alias.",
        " NCBI-only alias.",
        " HGNC identifier.",
        " NCBI Gene identifier.",
        " Ensembl gene identifier.",
        " Cytogenetic band."
      ]
    },
    "NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "OmimId": {
      "description": " A six-digit OMIM identifier, preserving all six digits.",
      "pattern": "^[0-9]{6}$",
      "type": "string"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Span0": {
      "additionalProperties": false,
      "description": "A zero-based half-open span with ordered bounds; empty spans are valid.",
      "properties": {
        "end": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Strand": {
      "description": "Source-stated forward or reverse strand.",
      "enum": [
        "+",
        "-"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Forward strand.",
        " Reverse strand."
      ]
    },
    "Summary": {
      "additionalProperties": false,
      "description": "A whole source-provided summary with attribution and stated date precision.",
      "properties": {
        "dated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date stated by the source, if any."
        },
        "source": {
          "$ref": "#/$defs/SummarySource",
          "description": "The summary's attribution, independent of the fetching provider."
        },
        "text": {
          "$ref": "#/$defs/Text",
          "description": "Entire summary text."
        }
      },
      "required": [
        "text",
        "source"
      ],
      "type": "object"
    },
    "SummarySource": {
      "description": "The attribution on a source-provided summary, independent of fetch providers.",
      "enum": [
        "refseq"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " RefSeq attribution."
      ]
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "UniProtAcc": {
      "description": " A whole UniProt base accession, without an isoform suffix.",
      "pattern": "^([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})$",
      "type": "string"
    }
  },
  "$id": "biodata.gene-resolution/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Resolution outcomes preserve ambiguity and withdrawn identity.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "One resolved identity and its source match.",
      "properties": {
        "gene": {
          "$ref": "#/$defs/Gene",
          "description": "The whole gene entity."
        },
        "match": {
          "$ref": "#/$defs/Match",
          "description": "How the source matched the input."
        },
        "resolution": {
          "const": "resolved",
          "type": "string"
        }
      },
      "required": [
        "resolution",
        "gene",
        "match"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Every candidate, with no silent selection.",
      "properties": {
        "candidates": {
          "description": "Ordered candidates supplied by the resolver.",
          "items": {
            "$ref": "#/$defs/GeneHeader"
          },
          "type": "array"
        },
        "resolution": {
          "const": "ambiguous",
          "type": "string"
        }
      },
      "required": [
        "resolution"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The original withdrawn identity and stated successors.",
      "properties": {
        "hgnc_id": {
          "$ref": "#/$defs/HgncId",
          "description": "Original HGNC identifier."
        },
        "hgnc_status": {
          "$ref": "#/$defs/HgncStatus",
          "description": "Stated HGNC withdrawn-file status."
        },
        "merged_into": {
          "description": "All stated merge destinations.",
          "items": {
            "$ref": "#/$defs/HgncId"
          },
          "type": "array"
        },
        "resolution": {
          "const": "withdrawn",
          "type": "string"
        },
        "symbol": {
          "$ref": "#/$defs/GeneSymbol",
          "description": "Original symbol."
        }
      },
      "required": [
        "resolution",
        "hgnc_id",
        "symbol",
        "hgnc_status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "No source identity matched.",
      "properties": {
        "resolution": {
          "const": "not_found",
          "type": "string"
        }
      },
      "required": [
        "resolution"
      ],
      "type": "object"
    }
  ],
  "title": "GeneResolution"
}
