{
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link."
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "ComponentLabel": {
      "additionalProperties": false,
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "ComponentTerms": {
      "additionalProperties": false,
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms page."
        },
        "usage": {
          "$ref": "#/$defs/Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "Concept": {
      "additionalProperties": false,
      "description": "One source concept with its optional ontology identifier.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated concept identifier."
        },
        "label": {
          "$ref": "#/$defs/Text",
          "description": "Original concept label."
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Curie": {
      "pattern": "^[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "DiseaseAssociation": {
      "additionalProperties": false,
      "description": "A native source association without clinical interpretation.",
      "properties": {
        "agent_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native agent type."
        },
        "aggregator_knowledge_source": {
          "description": "Native aggregator knowledge sources; missing, null and lists remain distinct.",
          "items": {
            "$ref": "#/$defs/Curie"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "description": "Native row provenance and version."
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native association category."
        },
        "evidence": {
          "description": "Source evidence terms; unavailable evidence stays absent.",
          "items": {
            "$ref": "#/$defs/DiseaseAssociationReference"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "evidence_count": {
          "description": "Native evidence count, distinct from returned reference count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "has_count": {
          "description": "Native annotation count, without a computed denominator.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "has_percentage": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native percentage, never computed from another field."
        },
        "has_quotient": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native quotient, never computed from another field."
        },
        "has_total": {
          "description": "Native annotation total, without inferring an assayed denominator.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "knowledge_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native source knowledge level."
        },
        "negated": {
          "description": "Source negation; absent is not false.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "object": {
          "$ref": "#/$defs/Concept",
          "description": "Native returned object."
        },
        "object_closure": {
          "description": "Native object closure.",
          "items": {
            "$ref": "#/$defs/Curie"
          },
          "type": "array"
        },
        "original_object": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original source object before source normalization."
        },
        "original_predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native pre-normalization predicate, without interpretation."
        },
        "original_subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original source subject before source normalization."
        },
        "predicate": {
          "$ref": "#/$defs/Curie",
          "description": "Native source predicate."
        },
        "primary_knowledge_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native primary knowledge source."
        },
        "provided_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native providing collection."
        },
        "publications": {
          "description": "Native publication references, without inferred links or labels.",
          "items": {
            "$ref": "#/$defs/DiseaseAssociationReference"
          },
          "type": "array"
        },
        "qualifiers": {
          "description": "Native qualifiers, including frequency or onset if supplied.",
          "items": {
            "$ref": "#/$defs/DiseaseAssociationQualifier"
          },
          "type": "array"
        },
        "requested_id": {
          "$ref": "#/$defs/Curie",
          "description": "The exact requested concept, including a queried parent."
        },
        "subject": {
          "$ref": "#/$defs/Concept",
          "description": "Native returned subject."
        },
        "subject_closure": {
          "description": "Native subject closure.",
          "items": {
            "$ref": "#/$defs/Curie"
          },
          "type": "array"
        },
        "subject_taxon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native subject taxon, only as supplied by the publisher."
        }
      },
      "required": [
        "requested_id",
        "subject",
        "predicate",
        "object",
        "attribution",
        "qualifiers",
        "subject_closure",
        "object_closure"
      ],
      "type": "object"
    },
    "DiseaseAssociationItem": {
      "additionalProperties": false,
      "description": "One native association and the component terms governing that row.",
      "properties": {
        "association": {
          "$ref": "#/$defs/DiseaseAssociation",
          "description": "Complete neutral association, including requested and actual endpoints."
        },
        "components": {
          "description": "Independently attributed annotation components for this row.",
          "items": {
            "$ref": "#/$defs/ComponentLabel"
          },
          "type": "array"
        }
      },
      "required": [
        "association",
        "components"
      ],
      "type": "object"
    },
    "DiseaseAssociationQualifier": {
      "additionalProperties": false,
      "description": "A named native qualifier without an inferred role.",
      "properties": {
        "field": {
          "$ref": "#/$defs/Text",
          "description": "Original native qualifier field."
        },
        "id": {
          "$ref": "#/$defs/Curie",
          "description": "Native qualifier identity."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label when supplied."
        }
      },
      "required": [
        "field",
        "id"
      ],
      "type": "object"
    },
    "DiseaseAssociationReference": {
      "additionalProperties": false,
      "description": "One native association reference, with no invented display label or link.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Curie",
          "description": "Native evidence or publication identity."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label when supplied."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unchanged native link when supplied."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DiseaseGenes": {
      "additionalProperties": false,
      "description": "Native association rows, not a unique-gene count.",
      "properties": {
        "components": {
          "description": "Applicable component use terms, independent of row provenance.",
          "items": {
            "$ref": "#/$defs/ComponentLabel"
          },
          "type": "array"
        },
        "fetched": {
          "description": "Original response retrieval Unix seconds, independent of local delivery.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "description": "Native source rows; totals in the envelope count rows, not distinct entities.",
          "items": {
            "$ref": "#/$defs/DiseaseAssociationItem"
          },
          "type": "array"
        }
      },
      "required": [
        "items",
        "components"
      ],
      "type": "object"
    },
    "DiseaseGet": {
      "additionalProperties": false,
      "description": "Exact concept or native SEER site with independently paged section.",
      "properties": {
        "age_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native age-range code."
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested native dataset selector, not proof of returned membership."
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Exact ontology CURIE or an explicit SEER catalog site ID.",
          "x-positional": 0
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Survival-only interval code."
        },
        "ontology": {
          "$ref": "#/$defs/DiseaseOntology",
          "default": "mondo",
          "description": "One OLS ontology."
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Incidence-only native period code."
        },
        "race": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native race code."
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiseaseSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "One named section; absent means identity card only.",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Native rows per page: default 2 for Monarch genes, 1 for Monarch phenotypes, otherwise 5.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Native row offset within the selected section.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sex": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native sex code."
        },
        "source": {
          "$ref": "#/$defs/DiseaseSource",
          "default": "mydisease",
          "description": "Default MyDisease; no automatic fallback."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DiseaseOntology": {
      "description": "One explicit OLS ontology.",
      "enum": [
        "mondo",
        "doid",
        "ncit"
      ],
      "type": "string"
    },
    "DiseaseSection": {
      "description": "One named disease page.",
      "enum": [
        "synonyms",
        "xrefs",
        "hierarchy",
        "genes",
        "phenotypes",
        "incidence",
        "survival"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Publisher scoped synonyms.",
        " Native cross references.",
        " Native parent relations.",
        " Native gene association rows.",
        " Native phenotype association rows.",
        " Native stage incidence rows.",
        " Annual survival rows."
      ]
    },
    "DiseaseSource": {
      "description": "An explicit disease source without fallback.",
      "enum": [
        "ols",
        "mydisease",
        "monarch",
        "seer"
      ],
      "type": "string"
    },
    "FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "oncokb",
