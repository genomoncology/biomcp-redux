{
  "$defs": {
    "ArticleEvidence": {
      "additionalProperties": false,
      "description": "Read every source context and optional explicit full-text citation paragraph.",
      "properties": {
        "cited": {
          "$ref": "#/$defs/ArticleInput",
          "description": "Cited PMID, PMC identity or DOI.",
          "x-positional": 1
        },
        "citing": {
          "$ref": "#/$defs/ArticleInput",
          "description": "Citing PMID, PMC identity or DOI.",
          "x-positional": 0
        },
        "fulltext": {
          "default": false,
          "description": "Include the citing paper's own explicit reference paragraphs.",
          "type": "boolean"
        },
        "offset": {
          "default": 0,
          "description": "Context fragment position returned by the advancing step.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "paragraph_offset": {
          "default": 0,
          "description": "Full-text fragment position returned by the advancing step.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Stored checked source scan and original hit positions."
        }
      },
      "required": [
        "citing",
        "cited"
      ],
      "type": "object"
    },
    "ArticleEvidenceResult": {
      "additionalProperties": false,
      "description": "Independent graph and optional open-text evidence parts.",
      "properties": {
        "fulltext": {
          "anyOf": [
            {
              "$ref": "#/$defs/Section2"
            },
            {
              "type": "null"
            }
          ],
          "description": "The citing paper's own explicit reference paragraphs."
        },
        "semantic_scholar": {
          "$ref": "#/$defs/Section",
          "description": "Source-reported citation contexts."
        }
      },
      "required": [
        "semantic_scholar"
      ],
      "type": "object"
    },
    "ArticleInput": {
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|PPR[0-9]*[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "Capped": {
      "additionalProperties": false,
      "description": "A bounded list with the total before its cap was applied.",
      "properties": {
        "items": {
          "description": "References in stable source order.",
          "items": {
            "$ref": "#/$defs/EvidenceContext"
          },
          "type": "array"
        },
        "total": {
          "description": "Distinct references before capping.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total"
      ],
      "type": "object"
    },
    "Capped2": {
      "additionalProperties": false,
      "description": "A bounded list with the total before its cap was applied.",
      "properties": {
        "items": {
          "description": "References in stable source order.",
          "items": {
            "$ref": "#/$defs/EvidenceParagraph"
          },
          "type": "array"
        },
        "total": {
          "description": "Distinct references before capping.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total"
      ],
      "type": "object"
    },
    "CitationContexts": {
      "additionalProperties": false,
      "description": "Source edge metadata and a bounded advancing context page.",
      "properties": {
        "complete": {
          "description": "Completion means a terminal source page was reached.",
          "type": "boolean"
        },
        "contexts": {
          "$ref": "#/$defs/Capped",
          "description": "Every context remains accessible through the advancing step."
        },
        "influential": {
          "description": "Missing is distinct from false.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "intents": {
          "description": "Source-reported citation intents.",
          "items": {
            "$ref": "#/$defs/CitationIntent"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "notice": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceNotice"
            },
            {
              "type": "null"
            }
          ],
          "description": "Successful empty-source explanation."
        },
        "source_cursor": {
          "description": "Native next source offset when a scan is incomplete.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "contexts",
        "complete"
      ],
      "type": "object"
    },
    "CitationIntent": {
      "description": "Source-reported reason for citing a paper.",
      "enum": [
        "background",
        "result",
        "methodology"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The source cites background information.",
        " The source cites a reported result.",
        " The source cites a method."
      ]
    },
    "CitationParagraphs": {
      "additionalProperties": false,
      "description": "Exact JATS reference paragraphs independent of the graph result.",
      "properties": {
        "license": {
          "$ref": "#/$defs/License",
          "description": "Original publisher license category."
        },
        "paragraphs": {
          "$ref": "#/$defs/Capped2",
          "description": "Original paragraph fragments and complete fragment count."
        }
      },
      "required": [
        "license",
        "paragraphs"
      ],
      "type": "object"
    },
    "EvidenceContext": {
      "additionalProperties": false,
      "description": "One advancing piece of an original source citation context.",
      "properties": {
        "character_offset": {
          "description": "Unicode character position within that context.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "position": {
          "description": "One-based original source context position.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "Whole context, or an exact advancing fragment when the context exceeds a page.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "position",
        "character_offset",
        "text"
      ],
      "type": "object"
    },
    "EvidenceNotice": {
      "description": "Explicit successful empty outcomes, never inferred from a source failure.",
      "enum": [
        "not_in_references",
        "no_contexts",
        "no_recommendations"
      ],
      "type": "string"
    },
    "EvidenceParagraph": {
      "additionalProperties": false,
      "description": "One source paragraph fragment with its own exact outline location.",
      "properties": {
        "character_offset": {
          "description": "Unicode character position within the original paragraph.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "markdown": {
          "description": "Preserved source Markdown.",
          "format": "markdown",
          "minLength": 1,
          "type": "string"
        },
        "part": {
          "description": "Exact semantic outline part.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "position": {
          "description": "One-based original body paragraph position.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "position",
        "part",
        "character_offset",
        "markdown"
      ],
      "type": "object"
    },
    "License": {
      "description": "License reported by the bucket metadata record.",
      "enum": [
        "cc_by",
        "cc_by_nc",
        "cc_by_sa",
        "cc_by_nc_sa",
        "cc_by_nd",
        "cc_by_nc_nd",
        "cc0",
        "public_domain",
        "tdm",
        "other"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Creative Commons Attribution.",
        " Creative Commons Attribution NonCommercial.",
        " Creative Commons Attribution ShareAlike.",
        " Creative Commons Attribution NonCommercial ShareAlike.",
        " Creative Commons Attribution NoDerivatives.",
        " Creative Commons Attribution NonCommercial NoDerivatives.",
        " Creative Commons public-domain dedication.",
        " Public domain.",
        " Text and data mining manuscript terms.",
        " The bucket reports another license."
      ]
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Section": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/CitationContexts",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Section2": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/CitationParagraphs",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
