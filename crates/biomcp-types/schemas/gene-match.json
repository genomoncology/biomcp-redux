{
  "$defs": {
    "MatchKind": {
      "description": "How a source matched a gene input.",
      "type": "string",
      "x-enum-descriptions": [
        " Current symbol.",
        " Previous symbol.",
        " HGNC alias.",
        " NCBI-only alias.",
        " HGNC identifier.",
        " NCBI Gene identifier.",
        " Ensembl gene identifier.",
        " Cytogenetic band."
      ],
      "x-extensible-enum": [
        "symbol",
        "previous_symbol",
        "alias",
        "ncbi_alias",
        "hgnc_id",
        "entrez_id",
        "ensembl_id",
        "band"
      ]
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.gene-match/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A source-stated match, preserving the text that matched.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/MatchKind",
      "description": "The match category."
    },
    "text": {
      "$ref": "#/$defs/Text",
      "description": "The source text that matched the input."
    }
  },
  "required": [
    "kind",
    "text"
  ],
  "title": "Match",
  "type": "object"
}
