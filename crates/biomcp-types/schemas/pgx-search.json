{
  "$defs": {
    "GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "PgxSource": {
      "description": "Explicit independent source.",
      "enum": [
        "cpic",
        "clinpgx"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " CPIC source-native records.",
        " ClinPGx annotation records."
      ]
    },
    "RsId": {
      "description": " A dbSNP site identifier, never an allele join key.",
      "pattern": "^rs(?:18446744073709551615|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})$",
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.pgx-search/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CPIC pairs by gene or drug, or ClinPGx clinical annotations by variant or drug.\nGive one selector and its source. By default, returns five rows per page.",
  "properties": {
    "cpic_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Literal CPIC level, including B/C.",
      "x-required-component": "cpic"
    },
    "drug": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Drug name for CPIC or ClinPGx."
    },
    "gene": {
      "$ref": "#/$defs/GeneSymbol",
      "description": "Gene symbol for CPIC pairs.",
      "x-required-component": "cpic"
    },
    "limit": {
      "default": 5,
      "description": "Rows per native page.",
      "format": "uint32",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Source offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/PgxSource",
      "description": "Source of pairs or clinical annotations; help search pgx\nSource of pairs or clinical annotations."
    },
    "variant": {
      "anyOf": [
        {
          "$ref": "#/$defs/RsId"
        },
        {
          "type": "null"
        }
      ],
      "description": "dbSNP rsID for ClinPGx.",
      "x-required-component": "clinpgx"
    }
  },
  "required": [
    "source"
  ],
  "title": "PgxSearch",
  "type": "object",
  "x-reply-query-titles": [
    "PgxGeneSearch"
  ]
}
