{
  "$defs": {
    "DiseaseOntology": {
      "description": "One explicit OLS ontology.",
      "enum": [
        "mondo",
        "doid",
        "ncit"
      ],
      "type": "string"
    },
    "DiseaseSection": {
      "description": "One named disease page.",
      "enum": [
        "synonyms",
        "xrefs",
        "hierarchy",
        "genes",
        "phenotypes",
        "incidence",
        "survival",
        "prevalence",
        "gene-validity"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Publisher synonyms.",
        " Native cross-references. Use --source ols for publisher-supplied target URLs.",
        " Parent terms.",
        " Gene associations.",
        " Phenotype associations.",
        " Incidence by stage.",
        " Annual survival.",
        " Orphanet prevalence, onset and inheritance.",
        " ClinGen and GenCC curations. Filters ignore case."
      ]
    },
    "DiseaseSource": {
      "description": "An explicit disease source without fallback.",
      "enum": [
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "orphadata",
        "clingen",
        "gencc"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.disease-get/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Disease details and sections.",
  "properties": {
    "age_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native age-range code."
    },
    "classification": {
      "$ref": "#/$defs/Text",
      "description": "Exact gene validity classification."
    },
    "dataset": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Requested dataset code."
    },
    "id": {
      "$ref": "#/$defs/Text",
      "description": "Disease CURIE, SEER site code or name, or exact curation name.",
      "x-positional": 0
    },
    "interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Survival interval code."
    },
    "ontology": {
      "$ref": "#/$defs/DiseaseOntology",
      "description": "OLS ontology. Defaults to the ID’s ontology or MONDO; help get disease\nOLS ontology. Defaults to the ID’s ontology or MONDO."
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Incidence period code."
    },
    "race": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native race code."
    },
    "section": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiseaseSection"
        },
        {
          "type": "null"
        }
      ],
      "description": "Omit for the identity card; help get disease",
      "x-positional": 1,
      "x-section-rule": "Omit for the identity card."
    },
    "section_limit": {
      "description": "Rows per page. Default 5, Monarch genes 2, phenotypes 1.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "section_offset": {
      "default": 0,
      "description": "Section row offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sex": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native sex code."
    },
    "source": {
      "$ref": "#/$defs/DiseaseSource",
      "description": "Default MyDisease, or both sources for gene validity; help get disease\nDefault MyDisease, or both sources for gene validity."
    },
    "submitter": {
      "$ref": "#/$defs/Text",
      "description": "Exact GenCC submitter or ClinGen panel."
    }
  },
  "required": [
    "id"
  ],
  "title": "DiseaseGet",
  "type": "object",
  "x-reply-query-titles": [
    "DiseaseSearch"
  ]
}
