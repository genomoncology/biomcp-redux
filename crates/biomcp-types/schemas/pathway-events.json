{
  "$defs": {
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PathwayEventRef": {
      "description": "An event object or unresolved integer reference; never the parent's inferred ID.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Native unresolved integer database reference.",
          "properties": {
            "db_id": {
              "description": "Positive native database reference.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "kind": {
              "const": "database",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "db_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native event object; fields are absent only when omitted by the source.",
          "properties": {
            "db_id": {
              "description": "Native object database identity.",
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ReactomeId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native stable identity when present, never copied from the pathway."
            },
            "kind": {
              "const": "object",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Whole native display name."
            },
            "schema_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native class; a reaction is not automatically a pathway."
            },
            "source_url": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Publisher record URL for the event's own stable identity, never the parent pathway."
            },
            "version": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Whole native stIdVersion, separate from the event stable identity."
            }
          },
          "required": [
            "kind",
            "db_id"
          ],
          "type": "object"
        }
      ]
    },
    "PathwayEvents": {
      "additionalProperties": false,
      "description": "Independent source-ordered page of whole native references.",
      "properties": {
        "header": {
          "$ref": "#/$defs/PathwayHeader",
          "description": "Exact source pathway owning this relation."
        },
        "items": {
          "description": "Whole native references; unresolved identities remain visible.",
          "items": {
            "$ref": "#/$defs/PathwayEventRef"
          },
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/PathwayPageInfo",
          "description": "Relation-specific count provenance and continuation."
        }
      },
      "required": [
        "header",
        "items",
        "page"
      ],
      "type": "object"
    },
    "PathwayEventsQuery": {
      "additionalProperties": false,
      "description": "Read Reactome event objects and unresolved native integer references in source order. Membership names a source and release; it implies no therapy, response or actionability. No enrichment is calculated.",
      "properties": {
        "id": {
          "description": "Checked source-owned human pathway identity.",
          "pattern": "^R-HSA-[1-9][0-9]*$",
          "type": "string",
          "x-positional": 0
        },
        "limit": {
          "default": 5,
          "description": "Five complete relation rows by default, at most fifty.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Offset within the retained selected relation.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Immutable relation snapshot."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "PathwayHeader": {
      "additionalProperties": false,
      "description": "Small selectable native pathway identity, without its potentially long description.",
      "properties": {
        "id": {
          "$ref": "#/$defs/PathwayId",
          "description": "Checked source-owned identity."
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Whole native name."
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "WikiPathways revision, separate from identity."
        },
        "species": {
          "$ref": "#/$defs/PathwaySpecies",
          "description": "Explicit native human species."
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whole native Reactome stIdVersion, separate from stable identity."
        }
      },
      "required": [
        "id",
        "name",
        "species"
      ],
      "type": "object"
    },
    "PathwayId": {
      "description": "Source-owned pathway identity; equal names never merge sources.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Human Reactome stable identity without a version suffix.",
          "properties": {
            "id": {
              "$ref": "#/$defs/ReactomeId"
            },
            "source": {
              "const": "reactome",
              "type": "string"
            }
          },
          "required": [
            "source",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "WikiPathways identity without a revision suffix.",
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPathwaysId"
            },
            "source": {
              "const": "wikipathways",
              "type": "string"
            }
          },
          "required": [
            "source",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "PathwayPageInfo": {
      "additionalProperties": false,
      "description": "Native page position and explicit count provenance; a short admitted page can continue.",
      "properties": {
        "next_offset": {
          "description": "Next native position, independent of returned rows; absent only at the end.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "description": "Native source or retained relation offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Snapshot identity and lifetime when retained."
        },
        "returned": {
          "description": "Whole admitted rows on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Source-reported or observed relation total, as qualified by total_kind.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_kind": {
          "$ref": "#/$defs/PathwayTotalKind",
          "description": "Whether the total comes from the source or this retained collection."
        }
      },
      "required": [
        "offset",
        "returned",
        "total",
        "total_kind"
      ],
      "type": "object"
    },
    "PathwaySpecies": {
      "description": "Source-stated human species; no species inference from a title.",
      "enum": [
        "Homo sapiens"
      ],
      "type": "string"
    },
    "PathwayTotalKind": {
      "description": "Meaning of the collection total, independent of admitted rows on a page.",
      "enum": [
        "source",
        "observed",
        "distinct_references",
        "data_nodes"
      ],
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "ReactomeId": {
      "pattern": "^R-HSA-[1-9][0-9]*$",
      "type": "string"
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
