{
  "$defs": {
    "DrugRecallNumber": {
      "description": "Native FDA drug recall number, independent of its event number.",
      "pattern": "^D-[0-9]{4}-[0-9]{4}$",
      "type": "string"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biomcp.drug-recall-header/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One native drug recall record, independent of its event.",
  "properties": {
    "classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native FDA classification, without local interpretation."
    },
    "firm": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Published recalling firm."
    },
    "initiated": {
      "anyOf": [
        {
          "$ref": "#/$defs/PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native recall initiation day."
    },
    "product_description": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Published product wording; harmonized names never enter this field."
    },
    "recall_number": {
      "$ref": "#/$defs/DrugRecallNumber",
      "description": "Native recall number."
    },
    "reported": {
      "anyOf": [
        {
          "$ref": "#/$defs/PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native enforcement report day."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Published recall status."
    }
  },
  "required": [
    "recall_number"
  ],
  "title": "DrugRecallHeader",
  "type": "object"
}
