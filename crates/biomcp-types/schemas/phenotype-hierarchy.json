{
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "ComponentLabel": {
      "additionalProperties": false,
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "ComponentTerms": {
      "additionalProperties": false,
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms page.",
          "format": "uri"
        },
        "usage": {
          "$ref": "#/$defs/Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "HpId": {
      "description": "Exact Human Phenotype Ontology identifier with seven decimal digits.",
      "pattern": "^HP:[0-9]{7}$",
      "type": "string"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PhenotypeGet": {
      "additionalProperties": false,
      "description": "Read an exact HP term from HPO or Monarch, or page native source sections. A term lookup answers terminology; an association answers what its publisher asserts. Neither establishes a diagnosis.",
      "properties": {
        "id": {
          "$ref": "#/$defs/HpId",
          "description": "Exact HP identifier.",
          "x-positional": 0
        },
        "section": {
          "$ref": "#/$defs/PhenotypeSection",
          "description": "Absent means the source identity card.",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Default five text/link rows or one complete association row.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Native section row offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/Text",
          "description": "Retained exact source reply for local text and link pages; unsupported for diseases and genes."
        },
        "source": {
          "$ref": "#/$defs/PhenotypeSource",
          "description": "HPO or Monarch for cards, synonyms and xrefs; Monarch only for hierarchy, diseases and genes. Defaults to HPO for cards, synonyms and xrefs, otherwise Monarch."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "PhenotypeHierarchy": {
      "additionalProperties": false,
      "description": "Direct source hierarchy links without graph traversal.",
      "properties": {
        "components": {
          "description": "Applicable publisher component terms.",
          "items": {
            "$ref": "#/$defs/ComponentLabel"
          },
          "type": "array"
        },
        "fetched": {
          "description": "Original source retrieval seconds, distinct from ontology release.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "description": "Native ordered rows; empty remains an empty collection.",
          "items": {
            "$ref": "#/$defs/PhenotypeHierarchyLink"
          },
          "type": "array"
        }
      },
      "required": [
        "items",
        "components"
      ],
      "type": "object"
    },
    "PhenotypeHierarchyLink": {
      "additionalProperties": false,
      "description": "One native direct hierarchy link, without traversal or inferred equivalence.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "description": "Publisher provenance."
        },
        "id": {
          "$ref": "#/$defs/Curie",
          "description": "Exact related term identifier; native parents can be outside HP."
        },
        "label": {
          "description": "Whole related term label.",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/PhenotypeHierarchyRelation",
          "description": "Original source relation, such as super_classes or sub_classes."
        }
      },
      "required": [
        "id",
        "label",
        "relation",
        "attribution"
      ],
      "type": "object"
    },
    "PhenotypeHierarchyRelation": {
      "description": "Native hierarchy collection that supplies the link.",
      "enum": [
        "super_classes",
        "sub_classes"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " A direct parent in the native super_classes collection.",
        " A direct child in the native sub_classes collection."
      ]
    },
    "PhenotypeSection": {
      "description": "A named source term section.",
      "enum": [
        "synonyms",
        "xrefs",
        "hierarchy",
        "diseases",
        "genes"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native synonyms.",
        " Native cross references.",
        " Native direct parent and child links.",
        " Native disease association rows.",
        " Native human gene association rows."
      ]
    },
    "PhenotypeSource": {
      "description": "One independent term publisher.",
      "enum": [
        "hpo",
        "monarch"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Direct HPO term metadata.",
        " Monarch term search and associations."
      ]
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "alphagenome",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
