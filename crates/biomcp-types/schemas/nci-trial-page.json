    "TrialGet": {
      "description": "Retrieve exact trial cards in input order; request bounded intact source sections with independent continuations.",
      "properties": {
        "input": {
          "description": "One to twenty exact NCT identifiers, in caller order.",
          "items": {
            "$ref": "#/$defs/NctId"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
          "x-positional": 0
        },
        "limit": {
          "default": 10,
          "description": "Whole-record count per source collection page; text fragments follow the text budget.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Character offset for ClinicalTrials.gov eligibility or NCI summary; whole-record offset for other collections.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Checked stored source record, supplied by a continuation."
        },
        "section": {
          "description": "Optional intact source sections. Default cards only; diseases and summary require NCI. NCI locations, contacts, references and documents are unsupported.",
          "items": {
            "$ref": "#/$defs/TrialSection"
          },
          "type": "array",
          "x-trailing-section": true
        },
        "source": {
          "$ref": "#/$defs/TrialSource",
          "description": "Explicit provider; defaults to ClinicalTrials.gov and never falls back."
        }
