{
  "$defs": {
    "Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "ComponentLabel": {
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "ComponentTerms": {
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms page.",
          "format": "uri"
        },
        "usage": {
          "$ref": "#/$defs/Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "DiseaseConcept": {
      "description": "A disease identity whose optional display label never determines record admission.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated exact identifier."
        },
        "label": {
          "$ref": "#/$defs/Text",
          "description": "Native display label when supplied and valid."
        }
      },
      "type": "object"
    },
    "DiseaseEndpoint": {
      "description": "One native endpoint with an identifier and an optional source label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Curie",
          "description": "Exact source identifier."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source label when supplied."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DiseaseRelation": {
      "description": "A publisher relation with distinct endpoints and predicate.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "description": "Publisher record and version."
        },
        "description": {
          "description": "Unchanged native cross-reference description when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "object": {
          "$ref": "#/$defs/DiseaseEndpoint",
          "description": "Native object."
        },
        "predicate": {
          "$ref": "#/$defs/Curie",
          "description": "Publisher predicate, without equivalence promotion."
        },
        "subject": {
          "$ref": "#/$defs/DiseaseEndpoint",
          "description": "Native subject."
        }
      },
      "required": [
        "subject",
        "predicate",
        "object",
        "attribution"
      ],
      "type": "object"
    },
    "GeneInput": {
      "description": "An input classified before source resolution; aliases remain free text.",
      "pattern": "\\S",
      "type": "string"
    },
    "NciDiseaseRef": {
      "description": "Compact source disease reference; the diseases section retains every coding field.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Native source name."
        },
        "nci_thesaurus_concept_id": {
          "$ref": "#/$defs/NcitId",
          "description": "Source NCIt identity."
        }
      },
      "required": [
        "name",
        "nci_thesaurus_concept_id"
      ],
      "type": "object"
    },
    "NciMatchedSite": {
      "description": "Compact source site observation; its presence does not establish enrollment.",
      "properties": {
        "org_city": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native city, when provided."
        },
        "org_name": {
          "$ref": "#/$defs/Text",
          "description": "Published organization name."
        },
        "org_state_or_province": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native state or province, when provided."
        },
        "recruitment_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native recruitment status, without translation or enrollment inference."
        }
      },
      "required": [
        "org_name"
      ],
      "type": "object"
    },
    "NciTextPage": {
      "description": "Exact source text fragment with an honest original character count.",
      "properties": {
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrialGet"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked request for the next original characters, absent when complete."
        },
        "offset": {
          "description": "Original Unicode scalar position.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "Original source fragment, including whitespace.",
          "type": "string"
        },
        "total_characters": {
          "description": "Complete source length in Unicode scalar values.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "text",
        "offset",
        "total_characters"
      ],
      "type": "object"
    },
    "NciTrial": {
      "description": "NCI trial card without registry status or phase coercion.",
      "properties": {
        "brief_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/NciTextPage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native short summary, only on exact retrieval."
        },
        "brief_title": {
          "$ref": "#/$defs/Text",
          "description": "Native title."
        },
        "current_trial_status": {
          "$ref": "#/$defs/Text",
          "description": "Native status, without a registry translation."
        },
        "diseases": {
          "$ref": "#/$defs/TrialRecords",
          "description": "Publisher-provided disease concepts in source order."
        },
        "matched_site": {
          "anyOf": [
            {
              "$ref": "#/$defs/NciMatchedSite"
            },
            {
              "type": "null"
            }
          ],
          "description": "First site with an exact case-insensitive organization name, in source order."
        },
        "matching_sites": {
          "description": "Number of sites with that name, without deduplication; present only for facility searches.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "nci_id": {
          "$ref": "#/$defs/Text",
          "description": "Publisher NCI identifier."
        },
        "nct_id": {
          "$ref": "#/$defs/NctId",
          "description": "Registry cross-reference supplied by NCI."
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/NciTrialPhase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native phase."
        }
      },
      "required": [
        "nci_id",
        "nct_id",
        "brief_title",
        "current_trial_status",
        "diseases"
      ],
      "type": "object"
    },
    "NciTrialPage": {
      "description": "NCI search page in native order with native count.",
      "properties": {
        "attribution": {
          "description": "Publisher attribution.",
          "type": "string"
        },
        "condition_resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrialConditionResolution"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact condition identity and source-provided mapping, absent for literal text."
        },
        "items": {
          "description": "Source rows, never merged with another provider.",
          "items": {
            "$ref": "#/$defs/NciTrial"
          },
          "type": "array"
        },
        "request": {
          "description": "Exact source parameters, excluding credentials.",
          "items": {
            "$ref": "#/$defs/TrialParameter"
          },
          "type": "array"
        }
      },
      "required": [
        "attribution"
      ],
      "type": "object"
    },
    "NciTrialPhase": {
      "description": "Native publisher vocabulary; new values are retained unchanged. Known values: NA; 0; I; I_II; II; II_III; III; IV; ",
      "type": "string"
    },
    "NcitId": {
      "description": "A native NCI Thesaurus concept code.",
      "pattern": "^C[0-9]+$",
      "type": "string"
    },
    "NctId": {
      "description": "Canonical ClinicalTrials.gov identifier.",
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PhaseFilter": {
      "description": "Explicit source phase selection, including the registry's combined phases.",
      "enum": [
        "early-1",
        "1",
        "2",
        "3",
        "4",
        "not-applicable",
        "1/2",
        "2/3"
      ],
      "type": "string"
    },
    "PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
