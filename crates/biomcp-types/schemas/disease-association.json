{
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link."
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Concept": {
      "additionalProperties": false,
      "description": "One source concept with its optional ontology identifier.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated concept identifier."
        },
        "label": {
          "$ref": "#/$defs/Text",
          "description": "Original concept label."
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Curie": {
      "pattern": "^[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "DiseaseAssociationQualifier": {
      "additionalProperties": false,
      "description": "A named native qualifier without an inferred role.",
      "properties": {
        "field": {
          "$ref": "#/$defs/Text",
          "description": "Original native qualifier field."
        },
        "id": {
          "$ref": "#/$defs/Curie",
          "description": "Native qualifier identity."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label when supplied."
        }
      },
      "required": [
        "field",
        "id"
      ],
      "type": "object"
    },
    "DiseaseAssociationReference": {
      "additionalProperties": false,
      "description": "One native association reference, with no invented display label or link.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Curie",
          "description": "Native evidence or publication identity."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label when supplied."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unchanged native link when supplied."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.disease-association/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A native source association without clinical interpretation.",
  "properties": {
    "agent_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native agent type."
    },
    "aggregator_knowledge_source": {
      "description": "Native aggregator knowledge sources; missing, null and lists remain distinct.",
      "items": {
        "$ref": "#/$defs/Curie"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "attribution": {
      "$ref": "#/$defs/Attribution",
      "description": "Native row provenance and version."
    },
    "category": {
      "anyOf": [
        {
          "$ref": "#/$defs/Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native association category."
    },
    "evidence": {
      "description": "Source evidence terms; unavailable evidence stays absent.",
      "items": {
        "$ref": "#/$defs/DiseaseAssociationReference"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "evidence_count": {
      "description": "Native evidence count, distinct from returned reference count.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "has_count": {
      "description": "Native annotation count, without a computed denominator.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "has_percentage": {
      "anyOf": [
        {
          "$ref": "#/$defs/FiniteNumber"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native percentage, never computed from another field."
    },
    "has_quotient": {
      "anyOf": [
        {
          "$ref": "#/$defs/FiniteNumber"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native quotient, never computed from another field."
    },
    "has_total": {
      "description": "Native annotation total, without inferring an assayed denominator.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "knowledge_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native source knowledge level."
    },
    "negated": {
      "description": "Source negation; absent is not false.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "object": {
      "$ref": "#/$defs/Concept",
      "description": "Native returned object."
    },
    "object_closure": {
      "description": "Native object closure.",
      "items": {
        "$ref": "#/$defs/Curie"
      },
      "type": "array"
    },
    "original_object": {
      "anyOf": [
        {
          "$ref": "#/$defs/Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original source object before source normalization."
    },
    "original_predicate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native pre-normalization predicate, without interpretation."
    },
    "original_subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original source subject before source normalization."
    },
    "predicate": {
      "$ref": "#/$defs/Curie",
      "description": "Native source predicate."
    },
    "primary_knowledge_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native primary knowledge source."
    },
    "provided_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native providing collection."
    },
    "publications": {
      "description": "Native publication references, without inferred links or labels.",
      "items": {
        "$ref": "#/$defs/DiseaseAssociationReference"
      },
      "type": "array"
    },
    "qualifiers": {
      "description": "Native qualifiers, including frequency or onset if supplied.",
      "items": {
        "$ref": "#/$defs/DiseaseAssociationQualifier"
      },
      "type": "array"
    },
    "requested_id": {
      "$ref": "#/$defs/Curie",
      "description": "The exact requested concept, including a queried parent."
    },
    "subject": {
      "$ref": "#/$defs/Concept",
      "description": "Native returned subject."
    },
    "subject_closure": {
      "description": "Native subject closure.",
      "items": {
        "$ref": "#/$defs/Curie"
      },
      "type": "array"
    },
    "subject_taxon": {
      "anyOf": [
        {
          "$ref": "#/$defs/Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native subject taxon, only as supplied by the publisher."
    }
  },
  "required": [
    "requested_id",
    "subject",
    "predicate",
    "object",
    "attribution"
  ],
  "title": "DiseaseAssociation",
  "type": "object"
}
