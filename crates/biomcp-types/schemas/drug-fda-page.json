{
  "$defs": {
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "DrugFdaCandidate": {
      "additionalProperties": false,
      "description": "One candidate application and its independent source-listed products.",
      "properties": {
        "identity": {
          "$ref": "#/$defs/DrugHeader",
          "description": "Exact native application identity; no product has been selected."
        },
        "products": {
          "description": "Complete native product candidates within this application.",
          "items": {
            "$ref": "#/$defs/DrugFdaProduct"
          },
          "type": "array"
        }
      },
      "required": [
        "identity",
        "products"
      ],
      "type": "object"
    },
    "DrugFdaIngredient": {
      "additionalProperties": false,
      "description": "An unchanged native ingredient and strength, without local normalization.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Native ingredient name."
        },
        "strength": {
          "$ref": "#/$defs/Text",
          "description": "Full source strength wording."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "DrugFdaPage": {
      "additionalProperties": false,
      "description": "A source-owned application page preserving complete product context and source order.",
      "properties": {
        "items": {
          "description": "Native applications and products; a phrase match never establishes equivalence.",
          "items": {
            "$ref": "#/$defs/DrugFdaCandidate"
          },
          "type": "array"
        },
        "source_updated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native dataset last_updated date, independent of event dates and retrieval."
        },
        "total": {
          "description": "Native application total, independent of product count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total"
      ],
      "type": "object"
    },
    "DrugFdaProduct": {
      "additionalProperties": false,
      "description": "One explicit native product within the selected FDA application.",
      "properties": {
        "active_ingredients": {
          "description": "Complete source-listed ingredient and strength pairs.",
          "items": {
            "$ref": "#/$defs/DrugFdaIngredient"
          },
          "type": "array"
        },
        "brand_name": {
          "$ref": "#/$defs/Text",
          "description": "Source brand wording, without inferred ingredient equivalence."
        },
        "dosage_form": {
          "$ref": "#/$defs/Text",
          "description": "Native dosage form."
        },
        "marketing_status": {
          "$ref": "#/$defs/Text",
          "description": "Product marketing status, independent of submission history."
        },
        "product_number": {
          "$ref": "#/$defs/Text",
          "description": "Exact source product number, scoped by the response application."
        },
        "reference_drug": {
          "$ref": "#/$defs/Text",
          "description": "Original source reference-drug designation."
        },
        "reference_standard": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original source reference-standard designation when supplied."
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native route; absent and null remain unavailable."
        },
        "te_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native therapeutic-equivalence code when supplied."
        }
      },
      "required": [
        "product_number",
        "brand_name",
        "active_ingredients",
        "dosage_form",
        "marketing_status",
        "reference_drug"
      ],
      "type": "object"
    },
    "DrugHeader": {
      "additionalProperties": false,
      "description": "One source candidate, without authorization, targets, label text or interactions.",
      "properties": {
        "id": {
          "$ref": "#/$defs/DrugId",
          "description": "Published native identifier."
        },
        "identity_level": {
          "$ref": "#/$defs/DrugIdentityLevel",
          "description": "Level established only by the endpoint or record type."
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Original source display name."
        },
        "source": {
          "$ref": "#/$defs/DrugSource",
          "description": "The single source responsible for this header."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native record type."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record URL."
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native source revision, omitted when the source supplies none."
        }
      },
      "required": [
        "id",
        "source",
        "identity_level"
      ],
      "type": "object"
    },
    "DrugId": {
      "pattern": "^(?:[A-Z][A-Z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "DrugIdentityLevel": {
      "description": "Identity level established by the source endpoint or record type, never inferred from ID shape.",
      "enum": [
        "ingredient",
        "salt",
        "clinical_formulation",
        "branded_product",
        "spl_set",
        "spl_version",
        "ndc_package",
        "fda_application",
        "fda_product",
        "ema_authorization",
        "ema_application",
        "orphan_designation",
        "unknown"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Source-stated ingredient identity.",
        " Source-stated salt identity.",
        " Source-stated clinical formulation identity.",
        " Source-stated branded product identity.",
        " Source-stated spl set identity.",
        " Source-stated spl version identity.",
        " Source-stated ndc package identity.",
        " Source-stated fda application identity.",
        " Source-stated fda product identity.",
        " Source-stated ema authorization identity.",
        " Source-stated ema application identity.",
        " Source-stated orphan designation identity.",
        " Source-stated unknown identity."
      ]
    },
    "DrugNameSelector": {
      "description": "One explicit ChEMBL name filter without fallback or synonym expansion.",
      "enum": [
        "preferred",
        "synonym"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Match the native preferred name exactly, ignoring case.",
        " Match an explicit native synonym exactly, ignoring case."
      ]
    },
    "DrugSearch": {
      "additionalProperties": false,
      "description": "Literal single-source candidate discovery, without an implicit identity selection.",
      "properties": {
        "limit": {
          "default": 10,
          "description": "Native candidate rows per page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "name_selector": {
          "$ref": "#/$defs/DrugNameSelector",
          "description": "Explicit ChEMBL native name selector; omitted means preferred name."
        },
        "offset": {
          "default": 0,
          "description": "Native rows to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "$ref": "#/$defs/Text",
          "description": "Literal source name selector, unchanged by the consumer.",
          "x-positional": 0
        },
        "source": {
          "$ref": "#/$defs/DrugSource",
          "default": "mychem",
          "description": "Exactly one source; default MyChem never fans out."
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "DrugSource": {
      "enum": [
        "who-pq",
        "mychem",
        "chembl",
        "opentargets",
        "civic",
        "openfda-label",
        "drugsfda",
        "ema",
        "ddinter"
      ],
      "type": "string"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "alphagenome",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
