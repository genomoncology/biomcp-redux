{
  "$defs": {
    "Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "AuthorizationDate": {
      "description": "A native date kept with its original role.",
      "properties": {
        "date": {
          "$ref": "#/$defs/PartialDate",
          "description": "Source date at its stated precision."
        },
        "role": {
          "$ref": "#/$defs/Text",
          "description": "Native date role, without assigning approval meaning."
        }
      },
      "required": [
        "role",
        "date"
      ],
      "type": "object"
    },
    "DrugId": {
      "description": "A published native drug record identifier, without a consumer source prefix.",
      "pattern": "^(?:[A-Z][A-Z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.authorization-event/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A source-scoped regulator event; never an identity-card field.",
  "properties": {
    "attribution": {
      "$ref": "#/$defs/Attribution",
      "description": "One source record and its native provenance."
    },
    "dates": {
      "description": "All native dates with separate roles.",
      "items": {
        "$ref": "#/$defs/AuthorizationDate"
      },
      "type": "array"
    },
    "indication": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original indication scope when present."
    },
    "jurisdiction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Jurisdiction explicitly stated by the source."
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original native event type."
    },
    "product_number": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit native product number, never a synthesized first product."
    },
    "record": {
      "$ref": "#/$defs/DrugId",
      "description": "Native regulator record identifier."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original source status; historical positives imply no current status."
    }
  },
  "required": [
    "record",
    "attribution"
  ],
  "title": "AuthorizationEvent",
  "type": "object"
}
