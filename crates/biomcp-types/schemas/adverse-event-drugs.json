{
  "$defs": {
    "AdverseEventDrug": {
      "additionalProperties": false,
      "description": "One absolute native drug row without its unbounded identifier arrays.",
      "properties": {
        "actiondrug": {
          "description": "Native actiondrug string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugadditional": {
          "description": "Native drugadditional string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugadministrationroute": {
          "description": "Native drugadministrationroute string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugauthorizationnumb": {
          "description": "Native drugauthorizationnumb string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugbatchnumb": {
          "description": "Native drugbatchnumb string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugcumulativedosagenumb": {
          "description": "Native drugcumulativedosagenumb string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugcumulativedosageunit": {
          "description": "Native drugcumulativedosageunit string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugdosageform": {
          "description": "Native drugdosageform string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugdosagetext": {
          "description": "Native drugdosagetext string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugenddate": {
          "description": "Native drugenddate string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugenddateformat": {
          "description": "Native drugenddateformat string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugintervaldosagedefinition": {
          "description": "Native drugintervaldosagedefinition string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugintervaldosageunitnumb": {
          "description": "Native drugintervaldosageunitnumb string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugrecurreadministration": {
          "description": "Native drugrecurreadministration string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugseparatedosagenumb": {
          "description": "Native drugseparatedosagenumb string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugstartdate": {
          "description": "Native drugstartdate string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugstartdateformat": {
          "description": "Native drugstartdateformat string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugstructuredosagenumb": {
          "description": "Native drugstructuredosagenumb string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugstructuredosageunit": {
          "description": "Native drugstructuredosageunit string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugtreatmentduration": {
          "description": "Native drugtreatmentduration string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugtreatmentdurationunit": {
          "description": "Native drugtreatmentdurationunit string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "identity_counts": {
          "$ref": "#/$defs/AdverseEventIdentityCounts",
          "description": "Sizes only; original lists live behind named pages."
        },
        "index": {
          "description": "Absolute native array index.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "indication": {
          "description": "Native indication string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "medicinalproduct": {
          "description": "Native medicinalproduct string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Native role string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "index",
        "identity_counts"
      ],
      "type": "object"
    },
    "AdverseEventDrugs": {
      "additionalProperties": false,
      "description": "A bounded report section; all rows belong to the exact header and snapshot.",
      "properties": {
        "components": {
          "description": "Applicable component terms.",
          "items": {
            "$ref": "#/$defs/ComponentLabel"
          },
          "type": "array"
        },
        "drugs": {
          "$ref": "#/$defs/AdverseEventRecords",
          "description": "One page of complete native rows."
        },
        "header": {
          "$ref": "#/$defs/AdverseEventHeader",
          "description": "Exact source report identity and version."
        },
        "snapshot": {
          "$ref": "#/$defs/Text",
          "description": "Opaque retained source snapshot."
        }
      },
      "required": [
        "header",
        "snapshot",
        "drugs",
        "components"
      ],
      "type": "object"
    },
    "AdverseEventGet": {
      "additionalProperties": false,
      "description": "Exact native report identity and an optional independently paged section.",
      "properties": {
        "drug_index": {
          "description": "Absolute source-array index; required only for identifier sections.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ReportId",
          "description": "Published report ID with no source prefix.",
          "x-positional": 0
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdverseEventSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS owns drugs, reactions and identifiers; MAUDE owns devices and narrative. Omitted means card only.",
          "x-positional": 1
        },
        "section_limit": {
          "default": 5,
          "description": "Whole source rows per section page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Offset within the selected native section.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked retained report snapshot for provider-free continuation."
        },
        "source": {
          "default": "faers",
          "description": "FAERS by default; MAUDE is explicit.",
          "enum": [
            "faers",
            "maude"
          ],
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "AdverseEventHeader": {
      "additionalProperties": false,
      "description": "Small source report header without a drug title, flattened lists or count buckets.",
      "properties": {
        "event_type": {
          "description": "Native event_type string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "first_received": {
          "description": "Native first_received string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ReportId",
          "description": "Exact published source identity."
        },
        "serious": {
          "description": "Native serious string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/AdverseEventSource",
          "description": "Explicit report family."
        },
        "version": {
          "description": "Native version string; present empty values remain present.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "source"
      ],
      "type": "object"
    },
    "AdverseEventIdentityCounts": {
      "additionalProperties": false,
      "description": "Lengths of present native harmonized lists; missing stays absent.",
      "properties": {
        "application_number": {
          "description": "Actual native application_number list length.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "package_ndc": {
          "description": "Actual native package_ndc list length.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "product_ndc": {
          "description": "Actual native product_ndc list length.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "rxcui": {
          "description": "Actual native rxcui list length.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "spl_id": {
          "description": "Actual native spl_id list length.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "spl_set_id": {
          "description": "Actual native spl_set_id list length.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unii": {
          "description": "Actual native unii list length.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AdverseEventRecords": {
      "additionalProperties": false,
      "description": "One complete-row page tied to the retained report snapshot.",
      "properties": {
        "offset": {
          "description": "Native section offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "records": {
          "description": "Source ordered whole rows.",
          "items": {
            "$ref": "#/$defs/AdverseEventDrug"
          },
          "type": "array"
        },
        "total": {
          "description": "Complete selected section length, not report or patient count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "records",
        "offset",
        "total"
      ],
      "type": "object"
    },
    "AdverseEventSection": {
      "description": "One source-owned section; no all or reporter section.",
      "enum": [
        "drugs",
        "reactions",
        "unii",
        "rxcui",
        "product-ndc",
        "package-ndc",
        "spl-id",
        "spl-set-id",
        "application-number",
        "devices",
        "narrative"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Independent native drug rows.",
        " Independent native reaction rows.",
        " Native UNII strings.",
        " Native RxCUI strings.",
        " Native product NDC strings.",
        " Native package NDC strings.",
        " Native SPL IDs.",
        " Native SPL set IDs.",
        " Native application numbers.",
        " Native device rows.",
        " Complete native narrative rows."
      ]
    },
    "AdverseEventSource": {
      "description": "An explicit source; never probe the other family.",
      "enum": [
        "faers",
        "maude",
        "vaers"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Drug event reports.",
        " Device event reports.",
        " Explicit CDC WONDER vaccine aggregate tables."
      ]
    },
    "ComponentLabel": {
      "additionalProperties": false,
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "ComponentTerms": {
      "additionalProperties": false,
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms page."
        },
        "usage": {
          "$ref": "#/$defs/Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "ReportId": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
