{
  "$defs": {
    "Reply_Doi": {
      "description": "DOI preserving source spelling with ASCII-insensitive equality.",
      "pattern": "^10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "Reply_EuropePmcId": {
      "description": "Europe PMC source prefix followed by its positive numeric local identifier.",
      "pattern": "^[A-Z]{1,8}[0-9]*[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Reply_Pmcid": {
      "description": "Canonical PMC identifier, with an explicit namespace.",
      "pattern": "^PMC[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_PublicationType": {
      "description": "Clinically meaningful PubMed publication types.",
      "type": "string",
      "x-enum-descriptions": [
        " Randomized controlled trial.",
        " Clinical trial.",
        " Phase one trial.",
        " Phase two trial.",
        " Phase three trial.",
        " Phase four trial.",
        " Meta-analysis.",
        " Systematic review.",
        " Review.",
        " Practice guideline.",
        " Guideline.",
        " Case report.",
        " Observational study.",
        " Multicenter study.",
        " Letter.",
        " Comment.",
        " Editorial.",
        " Preprint.",
        " Retracted publication.",
        " Retraction notice.",
        " Erratum."
      ],
      "x-extensible-enum": [
        "randomized_controlled_trial",
        "clinical_trial",
        "clinical_trial_phase_1",
        "clinical_trial_phase_2",
        "clinical_trial_phase_3",
        "clinical_trial_phase_4",
        "meta_analysis",
        "systematic_review",
        "review",
        "practice_guideline",
        "guideline",
        "case_report",
        "observational_study",
        "multicenter_study",
        "letter",
        "comment",
        "editorial",
        "preprint",
        "retracted_publication",
        "retraction_notice",
        "erratum"
      ]
    },
    "Reply_SemanticScholarAuthorId": {
      "description": "A checked source-local Semantic Scholar author identifier, never a person identity.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.article_header/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Citation metadata from PubMed or Europe PMC.",
  "properties": {
    "author_count": {
      "description": "Whole source author count.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "date": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Publication date at source precision."
    },
    "doi": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Doi"
        },
        {
          "type": "null"
        }
      ],
      "description": "Checked DOI, when supplied."
    },
    "electronic_date": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Electronic publication date when different from the publication date."
    },
    "europepmc_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_EuropePmcId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Europe PMC source-local identity."
    },
    "first_author": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "First author in source order."
    },
    "first_author_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_SemanticScholarAuthorId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact Semantic Scholar ID for the displayed native first author, when supplied."
    },
    "journal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Journal name."
    },
    "pmcid": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Pmcid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Checked PMC identity, when supplied."
    },
    "pmid": {
      "$ref": "#/$defs/Reply_Pmid",
      "description": "Checked PubMed identity."
    },
    "title": {
      "$ref": "#/$defs/Reply_Text",
      "description": "Whole source title."
    },
    "types": {
      "description": "Clinical publication types.",
      "items": {
        "$ref": "#/$defs/Reply_PublicationType"
      },
      "type": "array"
    },
    "types_unknown": {
      "description": "The provider does not supply checked publication types.",
      "type": "boolean"
    }
  },
  "required": [
    "author_count"
  ],
  "title": "ArticleHeader",
  "type": "object"
}
