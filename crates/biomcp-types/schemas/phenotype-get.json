{
  "$defs": {
    "HpId": {
      "pattern": "^HP:[0-9]{7}$",
      "type": "string"
    },
    "PhenotypeSection": {
      "description": "A named source term section.",
      "enum": [
        "synonyms",
        "xrefs",
        "hierarchy",
        "diseases",
        "genes"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native synonyms.",
        " Native cross references.",
        " Native direct parent and child links.",
        " Native disease association rows.",
        " Native human gene association rows."
      ]
    },
    "PhenotypeSource": {
      "description": "One independent term publisher.",
      "enum": [
        "hpo",
        "monarch"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Direct HPO term metadata.",
        " Monarch term search and associations."
      ]
    }
  },
  "$id": "biomcp.phenotype-get/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact HP term with independently selected source and bounded section.",
  "properties": {
    "id": {
      "$ref": "#/$defs/HpId",
      "description": "Exact HP identifier.",
      "x-positional": 0
    },
    "section": {
      "$ref": "#/$defs/PhenotypeSection",
      "description": "Absent means the source identity card.",
      "x-positional": 1
    },
    "section_limit": {
      "description": "Default five text/link rows or one complete association row.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "section_offset": {
      "default": 0,
      "description": "Native section row offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/PhenotypeSource",
      "description": "HPO for card, synonyms and xrefs; Monarch for other sections."
    }
  },
  "required": [
    "id"
  ],
  "title": "PhenotypeGet",
  "type": "object"
}
