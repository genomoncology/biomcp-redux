{
  "$defs": {
    "Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "ComponentLabel": {
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "ComponentTerms": {
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Publisher terms page.",
          "format": "uri"
        },
        "usage": {
          "$ref": "#/$defs/Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "DiseaseConcept": {
      "description": "A disease identity whose optional display label never determines record admission.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated exact identifier."
        },
        "label": {
          "$ref": "#/$defs/Text",
          "description": "Native display label when supplied and valid."
        }
      },
      "type": "object"
    },
    "DiseaseEndpoint": {
      "description": "One native endpoint with an identifier and an optional source label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Curie",
          "description": "Exact source identifier."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source label when supplied."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DiseaseRelation": {
      "description": "A publisher relation with distinct endpoints and predicate.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "description": "Publisher record and version."
        },
        "description": {
          "description": "Unchanged native cross-reference description when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "object": {
          "$ref": "#/$defs/DiseaseEndpoint",
          "description": "Native object."
        },
        "predicate": {
          "$ref": "#/$defs/Curie",
          "description": "Publisher predicate, without equivalence promotion."
        },
        "subject": {
          "$ref": "#/$defs/DiseaseEndpoint",
          "description": "Native subject."
        }
      },
      "required": [
        "subject",
        "predicate",
        "object",
        "attribution"
      ],
      "type": "object"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " AlphaGenome.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
        " Open Targets.",
        " openFDA SPL labels.",
        " Drugs@FDA application records.",
        " European Medicines Agency.",
        " WHO finished pharmaceutical products.",
        " DDInter interaction records.",
        " MyChem DrugBank Open identity subset only.",
        " MyChem DrugCentral component.",
        " MyChem Guide to Pharmacology component.",
        " MyChem UNII identities.",
        " MyChem NDC package identities.",
        " MyChem openFDA cross-references only.",
        " Ontology Lookup Service.",
        " MyDisease.info aggregation.",
        " Monarch associations.",
        " SEER Explorer.",
        " MONDO published ontology content.",
        " Disease Ontology published content.",
        " NCI Thesaurus ontology content.",
        " HPO-published annotations.",
        " Reviewed Orphadata Science content.",
        " Separately licensed OMIM payload only.",
        " openFDA FAERS drug adverse event reports.",
        " CDC WONDER vaccine report summaries.",
        " openFDA MAUDE device event reports.",
        " Source-reported MedDRA reaction labels and versions.",
        " Source-carried GMDN device terminology.",
        " NCBI Genetic Testing Registry public reports.",
        " WHO prequalified in vitro diagnostics.",
        " FDA companion diagnostic device tables.",
        " openFDA premarket approval submissions.",
        " FDA native 510(k) clearance records.",
        " openFDA medical device product recall records.",
        " Clinical Pharmacogenetics Implementation Consortium.",
        " ClinPGx pharmacogenomics annotations.",
        " Public cBioPortal with study-specific reuse terms.",
        " Cellosaurus cell line identity."
      ],
      "x-extensible-enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "gencc",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "alphagenome",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "fda-device-recall",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ]
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "Use": {
      "description": "Reviewed source-use category, without inferring rights in individual records.",
      "enum": [
        "open",
        "attribution",
        "noncommercial",
        "restricted"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.trial-condition-resolution/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Exact condition identity used for one trial request, without eligibility inference.",
  "properties": {
    "alias": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiseaseRelation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native relation proving a requested alias, when required."
    },
    "attribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/Attribution"
        },
        {
          "type": "null"
        }
      ],
      "description": "Resolver record provenance, independent of the trial provider."
    },
    "components": {
      "description": "Admitted resolver components and their own terms.",
      "items": {
        "$ref": "#/$defs/ComponentLabel"
      },
      "type": "array"
    },
    "concept": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiseaseConcept"
        },
        {
          "type": "null"
        }
      ],
      "description": "Returned concept with its unchanged native primary label."
    },
    "input": {
      "$ref": "#/$defs/Curie",
      "description": "Caller-selected CURIE, never a source-name search."
    },
    "ncit_candidates": {
      "description": "Native NCIt mapping rows; duplicate targets keep their independent provenance.",
      "items": {
        "$ref": "#/$defs/DiseaseRelation"
      },
      "type": "array"
    },
    "resolver": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ],
      "description": "Named exact resolver; absent for explicit NCIt input."
    },
    "selected_ncit": {
      "anyOf": [
        {
          "$ref": "#/$defs/Curie"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit or unique source-provided NCIt identifier actually sent to NCI."
    }
  },
  "required": [
    "input"
  ],
  "title": "TrialConditionResolution",
  "type": "object"
}
