{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache or recording failure, independent of what the provider returned.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version",
        "recording-conflict",
        "recording-io",
        "recording-missing",
        "recording-exhausted",
        "recording-malformed",
        "recording-limit",
        "recording-non-utf8"
      ],
      "type": "string"
    },
    "Reply_Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^:/\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f][^:\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "Reply_GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "Reply_IdentifierNamespace": {
      "description": "A source-stated authority or an explicit unknown authority, represented by the string unknown.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_Identifier_int64": {
      "description": "An authority and its unchanged native identifier; unknown means the authority was not stated.",
      "properties": {
        "id": {
          "description": "Native identifier value, with its original scalar type and precision.",
          "format": "int64",
          "type": "integer"
        },
        "namespace": {
          "$ref": "#/$defs/Reply_IdentifierNamespace",
          "description": "Native authority spelling; the literal unknown carries an unstated authority."
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "type": "object",
      "x-identifier": true
    },
    "Reply_Incomplete": {
      "description": "One thing a `partial` reply is missing, pointing at the detail already in the reply.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Reply_Text",
          "description": "JSON pointer into this reply, such as `/sources/1` or a record's field."
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_ProblemCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "The refused record's own problem code, when a problem is the cause."
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why, when a typed source reason is known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source whose data is missing."
        }
      },
      "required": [
        "at",
        "source"
      ],
      "type": "object"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matches: the source's own count when one source states more than the snapshot holds, otherwise the identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PgxHeader": {
      "description": "Source and declared gene context; no chosen pair or patient result.",
      "properties": {
        "gene": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Declared source symbol."
        },
        "source": {
          "$ref": "#/$defs/Reply_PgxSource",
          "description": "Explicit source."
        }
      },
      "required": [
        "source",
        "gene"
      ],
      "type": "object"
    },
    "Reply_PgxPage": {
      "description": "Independent source-ordered page of complete native records.",
      "properties": {
        "header": {
          "$ref": "#/$defs/Reply_PgxHeader",
          "description": "Source and selected gene."
        },
        "items": {
          "default": [],
          "description": "Complete native rows without duplicate summaries.",
          "items": {
            "$ref": "#/$defs/Reply_PgxPair"
          },
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/Reply_PgxPageInfo",
          "description": "Meaning and bounds of this collection."
        }
      },
      "required": [
        "header",
        "page"
      ],
      "type": "object"
    },
    "Reply_PgxPageInfo": {
      "description": "Independent collection scope; observed counts never imply native source totals.",
      "properties": {
        "offset": {
          "description": "Offset in this collection.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "returned": {
          "description": "Number of whole returned rows.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Exact source total or received bounded collection length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_kind": {
          "$ref": "#/$defs/Reply_PgxTotalKind",
          "description": "Provenance of total."
        }
      },
      "required": [
        "offset",
        "returned",
        "total",
        "total_kind"
      ],
      "type": "object"
    },
    "Reply_PgxPair": {
      "description": "Source-native PgxPair fields; no clinical interpretation.",
      "properties": {
        "clinpgxlevel": {
          "description": "Native `clinpgxlevel`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "cpiclevel": {
          "description": "Native `cpiclevel`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "drugid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native `drugid`; literal source value."
        },
        "drugname": {
          "description": "Native `drugname`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "genesymbol": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Native `genesymbol`; literal source value."
        },
        "guidelinename": {
          "description": "Native `guidelinename`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "guidelineurl": {
          "description": "Native `guidelineurl`; literal source value.",
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "pairid": {
          "$ref": "#/$defs/Reply_Identifier_int64",
          "description": "Native `pairid`; literal source value."
        },
        "pgxtesting": {
          "description": "Native `pgxtesting`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        },
        "pmids": {
          "description": "Native `pmids`; literal source value.",
          "items": {
            "$ref": "#/$defs/Reply_Pmid"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "provisional": {
          "description": "Native `provisional`; literal source value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "usedforrecommendation": {
          "description": "Native `usedforrecommendation`; literal source value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pairid",
        "genesymbol"
      ],
      "type": "object"
    },
    "Reply_PgxSearch": {
      "description": "Checked gene-keyed CPIC pair search. No phenotype, phase or dose is calculated.",
      "properties": {
        "cpic_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Literal native level, including compound levels such as B/C."
        },
        "gene": {
          "$ref": "#/$defs/Reply_GeneSymbol",
          "description": "Explicit source gene symbol."
        },
        "limit": {
          "default": 5,
          "description": "Rows per native page.",
          "format": "uint32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Source offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "description": "Required CPIC source; ClinPGx is not supported for search.",
          "enum": [
            "cpic"
          ],
          "type": "string"
        }
      },
      "required": [
        "gene",
        "source"
      ],
      "type": "object"
    },
    "Reply_PgxSource": {
      "description": "Explicit independent source.",
      "enum": [
        "cpic",
        "clinpgx"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " CPIC source-native records.",
        " ClinPGx annotation records."
      ]
    },
    "Reply_PgxTotalKind": {
      "description": "Meaning of the stated collection total.",
      "enum": [
        "source",
        "observed"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The source returned an exact total.",
        " Length of a bounded received collection."
      ]
    },
    "Reply_Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known. A `record.declined` problem has none, so\nit names the record by a source key, such as `event_id:100178`."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records.",
        " A source record without a usable identity was left off the page; each problem names one such record.",
        " The asked filter cannot read the records the field names, so they were not searched and may hold matches the page leaves out."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict",
        "record.declined",
        "filter.unsupported"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source.",
        " The source document was read but does not state the value."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id",
        "not-stated"
      ]
    },
