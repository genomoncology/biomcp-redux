{
  "$defs": {
    "ArticleHeader": {
      "additionalProperties": false,
      "description": "Citation metadata from PubMed or Europe PMC.",
      "properties": {
        "author_count": {
          "description": "Whole source author count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Publication date at source precision."
        },
        "doi": {
          "anyOf": [
            {
              "$ref": "#/$defs/Doi"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked DOI, when supplied."
        },
        "electronic_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Electronic publication date when different from the publication date."
        },
        "europepmc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EuropePmcId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Europe PMC source-local identity."
        },
        "first_author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "First author in source order."
        },
        "first_author_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticScholarAuthorId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact Semantic Scholar ID for the displayed native first author, when supplied."
        },
        "journal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Journal name."
        },
        "pmcid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pmcid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked PMC identity, when supplied."
        },
        "pmid": {
          "$ref": "#/$defs/Pmid",
          "description": "Checked PubMed identity."
        },
        "title": {
          "$ref": "#/$defs/Text",
          "description": "Whole source title."
        },
        "types": {
          "description": "Clinical publication types.",
          "items": {
            "$ref": "#/$defs/PublicationType"
          },
          "type": "array"
        },
        "types_unknown": {
          "description": "The provider does not supply checked publication types.",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "types",
        "author_count"
      ],
      "type": "object"
    },
    "ArticleItem": {
      "additionalProperties": false,
      "description": "One original pool position, including a summary hole.",
      "properties": {
        "cited_by": {
          "description": "iCite citing-paper count, only under citation ordering.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "contexts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Capped"
            },
            {
              "type": "null"
            }
          ],
          "description": "First citation context and the source's complete context count."
        },
        "found_by": {
          "additionalProperties": false,
          "description": "Native one-based source positions, disclosed only for multiple sources.",
          "properties": {
            "europepmc": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "litsense": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "litvar": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "pubmed": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "pubtator": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "semantic-scholar": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "header": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArticleHeader"
            },
            {
              "type": "null"
            }
          ],
          "description": "Citation metadata when accepted."
        },
        "influential": {
          "description": "Provider's influential flag; absent is distinct from false.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "intents": {
          "description": "Citation intents in provider order; absent means not reported.",
          "items": {
            "$ref": "#/$defs/CitationIntent"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "key": {
          "$ref": "#/$defs/ArticleKey",
          "description": "Stable checked paper identity when the provider supplies one."
        },
        "pmid": {
          "$ref": "#/$defs/Pmid",
          "description": "The selected PMID, retained when summary mapping fails."
        },
        "sentence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArticleSentence"
            },
            {
              "type": "null"
            }
          ],
          "description": "First matching sentence in LitSense2 provider order."
        }
      },
      "type": "object"
    },
    "ArticleKey": {
      "description": "Stable identity independent of whether citation metadata was accepted.",
      "oneOf": [
        {
          "description": "PubMed identity.",
          "properties": {
            "id": {
              "$ref": "#/$defs/Pmid"
            },
            "namespace": {
              "const": "pubmed",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "PMC identity when PubMed is absent.",
          "properties": {
            "id": {
              "$ref": "#/$defs/Pmcid"
            },
            "namespace": {
              "const": "pmc",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "DOI when both indexed numeric identities are absent.",
          "properties": {
            "id": {
              "$ref": "#/$defs/Doi"
            },
            "namespace": {
              "const": "doi",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Europe PMC local source identity.",
          "properties": {
            "id": {
              "$ref": "#/$defs/EuropePmcId"
            },
            "namespace": {
              "const": "europepmc",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Semantic Scholar local identity when no indexed identifier exists.",
          "properties": {
            "id": {
              "$ref": "#/$defs/SemanticScholarId"
            },
            "namespace": {
              "const": "semantic_scholar",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "ArticlePage": {
      "additionalProperties": false,
      "description": "A slice of the stored article source order.",
      "properties": {
        "candidates": {
          "description": "Nearby source candidates when an exact variant was not uniquely selected.",
          "items": {
            "$ref": "#/$defs/LitVarCandidate"
          },
          "type": "array"
        },
        "items": {
          "description": "Original ordered items.",
          "items": {
            "$ref": "#/$defs/ArticleItem"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "ArticleSearch": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "gene"
          ]
        },
        {
          "required": [
            "variant"
          ]
        },
        {
          "required": [
            "disease"
          ]
        },
        {
          "required": [
            "drug"
          ]
        },
        {
          "required": [
            "author"
          ]
        },
        {
          "required": [
            "journal"
          ]
        },
        {
          "required": [
            "since"
          ]
        },
        {
          "required": [
            "until"
          ]
        },
        {
          "required": [
            "type"
          ]
        }
      ],
      "description": "Checked search selectors and pool cursor.",
      "properties": {
        "author": {
          "$ref": "#/$defs/Text",
          "description": "Author words sent to PubMed's author field."
        },
        "disease": {
          "$ref": "#/$defs/Text",
          "description": "Disease words."
        },
        "drug": {
          "$ref": "#/$defs/Text",
          "description": "Drug words."
        },
        "gene": {
          "$ref": "#/$defs/GeneInput",
          "description": "Gene input; PubMed resolves it through HGNC."
        },
        "journal": {
          "$ref": "#/$defs/Text",
          "description": "Journal words sent to PubMed's journal field."
        },
        "limit": {
          "default": 10,
          "description": "Maximum page length.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "no_preprints": {
          "description": "Exclude preprints using the source's native filter.",
          "type": "boolean"
        },
        "offset": {
          "default": 0,
          "description": "Number of pool items to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "open_access": {
          "description": "Require the source's native open-access filter; Semantic Scholar means a public PDF.",
          "type": "boolean"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Stable snapshot from an earlier response."
        },
        "retracted": {
          "$ref": "#/$defs/RetractionFilter",
          "description": "Include retracted papers by default, or exclude them using a native filter.",
          "x-cli-flags": {
            "exclude-retracted": "exclude",
            "include-retracted": "include"
          }
        },
        "since": {
          "$ref": "#/$defs/PartialDate",
          "description": "Inclusive lower publication-date bound at the stated precision; PubMed matches either electronic or print date."
        },
        "sort": {
          "$ref": "#/$defs/ArticleSort",
          "default": "rank",
          "description": "rank (default): native provider order; several sources take turns; native search cost.\ndate: native search cost; PubMed means date added and Europe PMC means newest first; other sources refuse it.\ncitations: most cited first across the whole pool; adds iCite calls, about 1 s per 1,000 PMIDs.\nAll sources support citations."
        },
        "source": {
          "default": [
            "pubmed"
          ],
          "description": "Sources to search in caller order, comma separated. Default: pubmed.\nSeveral sources take turns, remove duplicates and show every native rank.\npubmed: keywords with PubMed MeSH mapping; dropped words appear as notices.\neuropepmc: words in open full text and preprints; incidental mentions are possible.\nlitvar: exact variant publications; requires --variant and a protein change needs --gene; unresolved inputs return candidates.\nsemantic-scholar: broad discovery; a shared keyless pool may return 429; an optional free key raises the limit.\nlitsense: sentence resemblance, not a match; unrelated hits and timeouts are possible.\npubtator: entity and word search including full text; needs the right entity ID; --gene uses HGNC Entrez identity and cannot run without that join.",
          "items": {
            "$ref": "#/$defs/ArticleSource"
          },
          "minItems": 1,
          "type": "array",
          "x-comma-separated": true
        },
        "text": {
          "$ref": "#/$defs/Text",
          "description": "Words sent to each named source in its default fields.",
          "x-positional": 0
        },
        "type": {
          "$ref": "#/$defs/ArticleType",
          "description": "Publication-type filter."
        },
        "until": {
          "$ref": "#/$defs/PartialDate",
          "description": "Inclusive upper publication-date bound at the stated precision; PubMed matches either electronic or print date."
        },
        "variant": {
          "$ref": "#/$defs/Text",
          "description": "Variant words."
        }
      },
      "type": "object"
    },
    "ArticleSentence": {
      "additionalProperties": false,
      "description": "Source-provided sentence resemblance, without a claim of clinical relevance.",
      "properties": {
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source section, when present."
        },
        "text": {
          "$ref": "#/$defs/Text",
          "description": "Source sentence text."
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "ArticleSort": {
      "description": "Article ordering supported by this command.",
      "enum": [
        "rank",
        "date",
        "citations"
      ],
      "type": "string"
    },
    "ArticleSource": {
      "description": "Source selectors supported by article search.",
      "enum": [
        "pubmed",
        "europepmc",
        "litvar",
        "semantic-scholar",
        "litsense",
        "pubtator"
      ],
      "type": "string"
    },
    "ArticleType": {
      "description": "Publication-type selectors sent to the named sources.",
      "enum": [
        "trial",
        "randomized",
        "review",
        "systematic_review",
        "meta_analysis",
        "guideline",
        "case_report"
      ],
      "type": "string"
    },
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "Capped": {
      "additionalProperties": false,
      "description": "A bounded list with the total before its cap was applied.",
      "properties": {
        "items": {
          "description": "References in stable source order.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        },
        "total": {
          "description": "Distinct references before capping.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total"
      ],
      "type": "object"
    },
    "CitationIntent": {
      "description": "Source-reported reason for citing a paper.",
      "enum": [
        "background",
        "result",
        "methodology"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The source cites background information.",
        " The source cites a reported result.",
        " The source cites a method."
      ]
    },
    "Doi": {
      "pattern": "^10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "EuropePmcId": {
      "pattern": "^[A-Z]{1,8}[0-9]*[1-9][0-9]*$",
      "type": "string"
    },
    "GeneInput": {
      "pattern": "\\S",
      "type": "string"
    },
    "LitVarCandidate": {
      "additionalProperties": false,
      "description": "Public LitVar2 autocomplete candidate, without a clinical ranking claim.",
      "properties": {
        "count": {
          "description": "Number of associated publications reported by LitVar2.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "gene": {
          "description": "Source gene symbols.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Source variant name."
        },
        "rsid": {
          "$ref": "#/$defs/Text",
          "description": "Source rsID, available for exact follow-up."
        }
      },
      "required": [
        "rsid",
        "gene",
        "name",
        "count"
      ],
      "type": "object"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Pmcid": {
      "pattern": "^PMC[1-9][0-9]*$",
      "type": "string"
    },
    "Pmid": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "PublicationType": {
      "description": "Clinically meaningful PubMed publication types.",
      "enum": [
        "randomized_controlled_trial",
        "clinical_trial",
        "clinical_trial_phase_1",
        "clinical_trial_phase_2",
        "clinical_trial_phase_3",
        "clinical_trial_phase_4",
        "meta_analysis",
        "systematic_review",
        "review",
        "practice_guideline",
        "guideline",
        "case_report",
        "observational_study",
        "multicenter_study",
        "letter",
        "comment",
        "editorial",
        "preprint",
        "retracted_publication",
        "retraction_notice",
        "erratum"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Randomized controlled trial.",
        " Clinical trial.",
        " Phase one trial.",
        " Phase two trial.",
        " Phase three trial.",
        " Phase four trial.",
        " Meta-analysis.",
        " Systematic review.",
        " Review.",
        " Practice guideline.",
        " Guideline.",
        " Case report.",
        " Observational study.",
        " Multicenter study.",
        " Letter.",
        " Comment.",
        " Editorial.",
        " Preprint.",
        " Retracted publication.",
        " Retraction notice.",
        " Erratum."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "RetractionFilter": {
      "description": "Native retraction inclusion policy.",
      "enum": [
        "include",
        "exclude"
      ],
      "type": "string"
    },
    "SemanticScholarAuthorId": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "SemanticScholarId": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "alphagenome",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ],
