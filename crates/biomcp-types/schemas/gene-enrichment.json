{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache or recording failure, independent of what the provider returned.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version",
        "recording-conflict",
        "recording-io",
        "recording-missing",
        "recording-exhausted",
        "recording-malformed",
        "recording-limit",
        "recording-non-utf8"
      ],
      "type": "string"
    },
    "Reply_EnrichedTerm": {
      "description": "One over-represented term as g:Profiler reports it.",
      "properties": {
        "background_size": {
          "description": "Background size: genes annotated in this term source.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "genes": {
          "description": "Inputs annotated to this term, in input order.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "g:Profiler term ID, such as REAC:R-HSA-5693538 or GO:0006281."
        },
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Term name."
        },
        "overlap": {
          "description": "Input genes annotated to this term.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p_value": {
          "description": "Adjusted p value under the stated correction.",
          "format": "double",
          "type": "number"
        },
        "query_size": {
          "description": "Input genes annotated in this term source.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "term_size": {
          "description": "Background genes annotated to this term.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "terms": {
          "$ref": "#/$defs/Reply_EnrichmentTerms",
          "description": "Term source."
        }
      },
      "required": [
        "id",
        "name",
        "terms",
        "p_value",
        "overlap",
        "query_size",
        "term_size",
        "background_size"
      ],
      "type": "object"
    },
    "Reply_EnrichmentCorrection": {
      "description": "g:Profiler's multiple-testing correction.",
      "enum": [
        "g-scs",
        "fdr",
        "bonferroni"
      ],
      "type": "string"
    },
    "Reply_EnrichmentTerms": {
      "description": "One openly licensed g:Profiler term source; licensed and noncommercial sources are not offered.",
      "enum": [
        "reactome",
        "go-bp",
        "go-mf",
        "go-cc",
        "wikipathways"
      ],
      "type": "string",
      "x-enum-descriptions": [
        "Reactome pathways.",
        "Gene Ontology biological processes.",
        "Gene Ontology molecular functions.",
        "Gene Ontology cellular components.",
        "WikiPathways pathways."
      ]
    },
    "Reply_GeneEnrichment": {
      "description": "Terms g:Profiler finds over-represented in a gene list, smallest adjusted p value first.\nOver-representation is a statistical association, not evidence that the genes act together.",
      "properties": {
        "ambiguous": {
          "description": "Inputs g:Profiler mapped to more than one gene; it tests its first choice.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        },
        "background": {
          "description": "The background g:Profiler states it used; each term gives its size.",
          "type": "string"
        },
        "correction": {
          "$ref": "#/$defs/Reply_EnrichmentCorrection",
          "description": "The multiple-testing correction g:Profiler states it applied."
        },
        "items": {
          "description": "Significant terms in g:Profiler's order.",
          "items": {
            "$ref": "#/$defs/Reply_EnrichedTerm"
          },
          "type": "array"
        },
        "release": {
          "$ref": "#/$defs/Reply_Text",
          "description": "g:Profiler data release, which names its Ensembl and Ensembl Genomes versions."
        },
        "test": {
          "description": "The test g:Profiler documents for g:GOSt.",
          "type": "string"
        },
        "threshold": {
          "description": "Adjusted p value threshold; g:Profiler returns only terms at or below it.",
          "format": "double",
          "type": "number"
        },
        "unmapped": {
          "description": "Inputs g:Profiler could not map to a human gene; they are not tested.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "type": "array"
        }
      },
      "required": [
        "release",
        "test",
        "correction",
        "threshold",
        "background"
      ],
      "type": "object"
    },
    "Reply_GeneEnrichmentQuery": {
      "description": "Over-represented terms for a human gene list from g:Profiler, with its own statistics.",
      "properties": {
        "correction": {
          "$ref": "#/$defs/Reply_EnrichmentCorrection",
          "default": "g-scs",
          "description": "Multiple-testing correction; g:SCS by default."
        },
        "genes": {
          "description": "One to 500 human gene symbols or Ensembl, Entrez or UniProt IDs, as g:Profiler reads them.",
          "items": {
            "$ref": "#/$defs/Reply_Text"
          },
          "maxItems": 500,
          "minItems": 1,
          "type": "array",
          "x-positional": 0
        },
        "limit": {
          "default": 10,
          "description": "Ten terms by default, one to fifty, smallest adjusted p value first.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Terms to skip in that order.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "terms": {
          "default": [
            "reactome",
            "go-bp",
            "go-mf",
            "go-cc",
            "wikipathways"
          ],
          "description": "Term sources to test; all five by default.",
          "items": {
            "$ref": "#/$defs/Reply_EnrichmentTerms"
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array",
          "x-comma-separated": true
        }
      },
      "required": [
        "genes"
      ],
      "type": "object"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matches: the source's own count when one source states more than the snapshot holds, otherwise the identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known. A `record.declined` problem has none, so\nit names the record by a source key, such as `event_id:100178`."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records.",
        " A source record without a usable identity was left off the page; each problem names one such record."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict",
        "record.declined"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Reply_Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
