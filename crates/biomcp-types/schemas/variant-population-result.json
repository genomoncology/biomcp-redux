    "SourceNotice": {
      "description": "A provider query interpretation notice.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A checked provider answer survived a local cache failure.",
          "properties": {
            "kind": {
              "const": "cache_problem",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/CacheProblem",
              "description": "Bounded local failure without paths or database diagnostics."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph_truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An empty LitVar lookup can be repeated with a caller-supplied rsID.",
          "properties": {
            "kind": {
              "const": "litvar_rsid_hint",
              "type": "string"
            },
            "message": {
              "description": "Guidance that never supplies or infers an rsID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PubMed supplied a named ESearch warning without changing its phrases.",
          "properties": {
            "kind": {
              "const": "pubmed_warning",
              "type": "string"
            },
            "name": {
              "description": "Original provider warning name, including names added by PubMed later.",
              "type": "string"
            },
            "phrases": {
              "description": "Original provider phrases, preserving whitespace and quotes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not_found_words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SourceOutcome": {
      "additionalProperties": false,
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched": {
          "description": "Retrieved identity depth.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Provider query notices that do not indicate failure.",
          "items": {
            "$ref": "#/$defs/SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "format": "uri",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "The source's own entry for an entity.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Native source identifier."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Link to that entry.",
          "format": "uri"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "Use": {
      "description": "Reviewed source-use category, without inferring rights in individual records.",
      "enum": [
        "open",
        "attribution",
        "noncommercial",
        "restricted"
      ],
      "type": "string"
    },
    "VariantId": {
      "description": "Published variant-level identifiers, with each identifier's level retained.",
      "pattern": "^(rs[1-9][0-9]*|CA[0-9]{6,}|PA[1-9][0-9]*|VCV[0-9]{9}(\\.[1-9][0-9]*)?|clinvar:[1-9][0-9]*|COS[VMN][1-9][0-9]*|ga4gh:VA\\.[A-Za-z0-9_-]{32})$",
      "type": "string"
    },
    "VariantInput": {
      "description": "A validated canonical VariantInput string.",
      "pattern": "(^(rs[1-9][0-9]*|CA[0-9]{6,}|PA[1-9][0-9]*|VCV[0-9]{9}(\\.[1-9][0-9]*)?|clinvar:[1-9][0-9]*|COS[VMN][1-9][0-9]*|ga4gh:VA\\.[A-Za-z0-9_-]{32})$|^((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?)(\\(([A-Za-z][A-Za-z0-9._/@-]*|[A-Za-z0-9_.]+)\\))?:[gcnrpmo]\\.[\\x20-\\x7e]+$|^[1-9][0-9]*$|^chr([1-9][0-9]*|X|Y|M|MT):g\\.[\\x21-\\x7e]+$)",
      "type": "string"
    },
    "VariantPopulation": {
      "additionalProperties": false,
      "description": "Bounded population summary with independent optional sequencing datasets.",
      "properties": {
        "build": {
          "$ref": "#/$defs/Build",
          "description": "Source dataset assembly."
        },
        "dataset": {
          "$ref": "#/$defs/Text",
          "description": "Source dataset selector."
        },
        "exome": {
          "anyOf": [
            {
              "$ref": "#/$defs/GnomadCounts"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exome observation; omitted when the source dataset is null."
        },
        "genome": {
          "anyOf": [
            {
              "$ref": "#/$defs/GnomadCounts"
            },
            {
              "type": "null"
            }
          ],
          "description": "Genome observation; omitted when the source dataset is null."
        },
        "variant": {
          "$ref": "#/$defs/Text",
          "description": "Source allele identifier."
        }
      },
      "required": [
        "variant",
        "dataset",
        "build"
      ],
      "type": "object"
    },
    "VariantPopulationQuery": {
      "additionalProperties": false,
      "description": "Read a bounded ancestry-detail page from the exact source-given GRCh38 allele.",
      "properties": {
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/Build"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit source assembly when required by identity input."
        },
        "detail": {
          "description": "Read source ancestry groups, preserving overlapping groups individually.",
          "type": "boolean"
        },
        "input": {
          "$ref": "#/$defs/VariantInput",
          "description": "Exact published allele identity; ambiguous candidates must first be selected.",
          "x-positional": 0
        },
        "limit": {
          "default": 10,
          "description": "Maximum rows per page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Native rows to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "resolver": {
          "$ref": "#/$defs/VariantResolver",
          "default": "car",
          "description": "Resolver for reference-qualified input."
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "VariantPopulationResult": {
      "additionalProperties": false,
      "description": "Population summary and one explicitly requested ancestry-detail page.",
      "properties": {
        "groups": {
          "description": "Selected native groups, qualified by sequencing subset.",
          "items": {
            "$ref": "#/$defs/GnomadCounts"
          },
          "type": "array"
        },
        "population": {
          "$ref": "#/$defs/Section",
          "description": "Source population state; missing datasets stay absent within its summary."
        }
      },
      "required": [
        "population"
      ],
      "type": "object"
    },
    "VariantRef": {
      "description": "Checked source subject reference; at least one source identity or label is required.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Exact allele identifier or reference-qualified notation.",
          "properties": {
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source-qualified HGVS."
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VariantId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source identifier."
            },
            "level": {
              "const": "allele",
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Protein-level assertion, without genomic conversion.",
          "properties": {
            "gene": {
              "$ref": "#/$defs/GeneRef",
              "description": "Source gene."
            },
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein HGVS."
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein label."
            },
            "level": {
              "const": "protein",
              "type": "string"
            }
          },
          "required": [
            "level",
            "gene"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Compound source profile, without an inferred allele.",
          "properties": {
            "label": {
              "$ref": "#/$defs/Text",
              "description": "Complete source label."
            },
            "level": {
              "const": "profile",
              "type": "string"
            },
            "members": {
              "description": "Source member references in their native order.",
              "items": {
                "$ref": "#/$defs/LeafRef"
              },
              "type": "array"
            },
            "record": {
              "$ref": "#/$defs/Text",
              "description": "Native profile ID."
            }
          },
          "required": [
            "level",
            "record",
            "label"
          ],
          "type": "object"
        }
      ]
    },
    "VariantResolver": {
      "description": "Explicit source service for reference-qualified notation.",
      "enum": [
        "car",
        "mutalyzer",
        "variantvalidator"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.variant-population/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One versioned command response; schema identity comes only from its body type.",
  "properties": {
    "local_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/CacheProblem"
        },
        {
          "type": "null"
