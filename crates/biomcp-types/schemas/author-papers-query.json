{
  "$defs": {
    "AuthorId": {
      "description": "One provider record; this enum establishes no relationship between its variants.",
      "pattern": "^((semantic-scholar|semanticscholar):[1-9][0-9]*|orcid:[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])$",
      "type": "string"
    },
    "AuthorPaperSection": {
      "description": "Indexed-paper disclosure level.",
      "enum": [
        "details"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native detailed metadata for the same paper window."
      ]
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biomcp.author-papers-query/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One exact provider record's publication window. ORCID sends its whole public works list in one reply and pages groups locally.",
  "properties": {
    "full": {
      "description": "Legacy alias for details; normalized on construction.",
      "type": "boolean"
    },
    "id": {
      "$ref": "#/$defs/AuthorId",
      "description": "Exact qualified provider record.",
      "x-positional": 0
    },
    "limit": {
      "default": 5,
      "description": "Bounded row count.",
      "format": "uint32",
      "maximum": 25,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Native or retained collection offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "pool": {
      "$ref": "#/$defs/Text",
      "description": "Retained collection identity."
    },
    "section": {
      "$ref": "#/$defs/AuthorPaperSection",
      "description": "Detailed disclosure when requested.",
      "x-positional": 1
    }
  },
  "required": [
    "id"
  ],
  "title": "AuthorPapersQuery",
  "type": "object"
}
