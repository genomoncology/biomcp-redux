{
  "$defs": {
    "DrugSource": {
      "enum": [
        "mychem",
        "chembl",
        "opentargets",
        "civic",
        "openfda-label",
        "drugsfda",
        "ema",
        "ddinter"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biomcp.drug-search/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Literal single-source candidate discovery, without an implicit identity selection.",
  "properties": {
    "limit": {
      "default": 10,
      "description": "Native candidate rows per page.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Native rows to skip.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "query": {
      "$ref": "#/$defs/Text",
      "description": "Literal source name selector, unchanged by the consumer.",
      "x-positional": 0
    },
    "source": {
      "$ref": "#/$defs/DrugSource",
      "default": "mychem",
      "description": "Exactly one source; default MyChem never fans out."
    }
  },
  "required": [
    "query"
  ],
  "title": "DrugSearch",
  "type": "object"
}
