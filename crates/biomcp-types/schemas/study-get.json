{
  "$defs": {
    "StudyId": {
      "description": "Opaque case-sensitive cBioPortal study identity, without repair.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "StudyProfileId": {
      "description": "Exact cBioPortal molecular profile identity.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "StudySection": {
      "description": "Supported bounded study metadata sections.",
      "enum": [
        "profiles",
        "sample-lists",
        "mutations",
        "structural-variants",
        "samples",
        "cna",
        "files",
        "all"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Molecular profiles.",
        " Sample-list metadata.",
        " Mutation rows for one gene, using the all-cases sample list.",
        " Fusions and rearrangements for one gene.",
        " Sample IDs and types.",
        " Discrete copy-number counts for one gene.",
        " Repository file links.",
        " First pages; mutations require a gene."
      ]
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.study-get/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact case-sensitive study card or bounded metadata section. No frequency, denominator, survival or comparison is calculated. Source counts keep their native names.",
  "properties": {
    "gene": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "HUGO symbol or Entrez ID. Required for mutations, structural-variants and cna."
    },
    "id": {
      "$ref": "#/$defs/StudyId",
      "description": "Exact study ID.",
      "x-positional": 0
    },
    "molecular_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudyProfileId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact profile ID. Defaults to the first of that section's kind."
    },
    "section": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudySection"
        },
        {
          "type": "null"
        }
      ],
      "description": "Omit for the study card; help get study",
      "x-positional": 1,
      "x-section-rule": "Omit for the study card."
    },
    "section_limit": {
      "default": 5,
      "description": "Rows per section (default 5).",
      "format": "uint32",
      "maximum": 200,
      "minimum": 1,
      "type": "integer"
    },
    "section_offset": {
      "default": 0,
      "description": "Offset in one section.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id"
  ],
  "title": "StudyGet",
  "type": "object"
}
