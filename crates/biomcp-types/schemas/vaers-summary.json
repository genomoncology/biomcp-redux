{
  "$defs": {
    "AdverseEventSearch": {
      "additionalProperties": false,
      "description": "Search five report headers by default. VAERS accepts MMR, COVID19, COVID-19 vaccine or one exact qualified native influenza code, matched without case; use influenza to list codes and labels. Tables remain separate and are never summed. One report may list several vaccines. VAERS returns five reported symptom rows by default; seriousness and age select independent tables. Counts are reports, not people. Reports do not show that a vaccine caused an event and cannot measure risk or compare vaccine safety.",
      "properties": {
        "limit": {
          "default": 5,
          "description": "Native report headers or VAERS rows per page; default five.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Native row offset. VAERS continuation requires its retained snapshot.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS MedDRA term phrase match, not exact equality."
        },
        "received_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive first FDA receipt lower bound, YYYY-MM-DD."
        },
        "received_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inclusive first FDA receipt upper bound, YYYY-MM-DD."
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/VaersSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "Independent VAERS table; omitted means reported symptoms.",
          "x-positional": 1
        },
        "serious": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdverseEventSerious"
            },
            {
              "type": "null"
            }
          ],
          "description": "FAERS report flag: death or hospitalization; never a reaction outcome."
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Retained VAERS table for provider-free continuation."
        },
        "source": {
          "$ref": "#/$defs/AdverseEventSource",
          "default": "faers",
          "description": "FAERS by default; VAERS accepts only exact supported vaccine names."
        },
        "text": {
          "$ref": "#/$defs/Text",
          "description": "Literal drug text, MAUDE device phrase or exact supported VAERS vaccine.",
          "x-positional": 0
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "AdverseEventSerious": {
      "description": "Report-level seriousness filter, independent of reaction outcome.",
      "enum": [
        "death",
        "hospitalization"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native report death flag.",
        " Native report hospitalization flag."
      ]
    },
    "AdverseEventSource": {
      "description": "An explicit source; never probe the other family.",
      "enum": [
        "faers",
        "maude",
        "vaers"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Drug event reports.",
        " Device event reports.",
        " Explicit CDC WONDER vaccine aggregate tables."
      ]
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
        " Open Targets.",
        " openFDA SPL labels.",
        " Drugs@FDA application records.",
        " European Medicines Agency.",
        " WHO finished pharmaceutical products.",
        " DDInter interaction records.",
        " MyChem DrugBank Open identity subset only.",
        " MyChem DrugCentral component.",
        " MyChem Guide to Pharmacology component.",
        " MyChem UNII identities.",
        " MyChem NDC package identities.",
        " MyChem openFDA cross-references only.",
        " Ontology Lookup Service.",
        " MyDisease.info aggregation.",
        " Monarch associations.",
        " SEER Explorer.",
        " MONDO published ontology content.",
        " Disease Ontology published content.",
        " NCI Thesaurus ontology content.",
        " HPO-published annotations.",
        " Reviewed Orphadata Science content.",
        " Separately licensed OMIM payload only.",
        " openFDA FAERS drug adverse event reports.",
        " CDC WONDER vaccine report summaries.",
        " openFDA MAUDE device event reports.",
        " Source-reported MedDRA reaction labels and versions.",
        " Source-carried GMDN device terminology.",
        " NCBI Genetic Testing Registry public reports.",
        " WHO prequalified in vitro diagnostics.",
        " FDA companion diagnostic device tables.",
        " openFDA premarket approval submissions.",
        " FDA native 510(k) clearance records.",
        " Clinical Pharmacogenetics Implementation Consortium.",
        " ClinPGx pharmacogenomics annotations.",
        " Public cBioPortal with study-specific reuse terms.",
        " Cellosaurus cell line identity."
      ]
    },
    "SourceNotice": {
      "description": "A provider query interpretation notice.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph_truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not_found_words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "words"
          ],
          "type": "object"
        }
      ]
    },
    "SourceOutcome": {
      "additionalProperties": false,
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched": {
          "description": "Retrieved identity depth.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Provider query notices that do not indicate failure.",
          "items": {
            "$ref": "#/$defs/SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind",
        "args"
      ],
      "type": "object"
    },
    "StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "Use": {
      "description": "Reviewed source-use category, without inferring rights in individual records.",
      "enum": [
        "open",
        "attribution",
        "noncommercial",
        "restricted"
      ],
      "type": "string"
    },
    "VaersNotice": {
      "additionalProperties": false,
      "description": "Applied source text, retaining its original content and source role.",
      "properties": {
        "kind": {
          "description": "Message, footnote or evaluated caveat.",
          "type": "string"
        },
        "text": {
          "description": "Original source text, including embedded publisher markup.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    "VaersRow": {
      "additionalProperties": false,
      "description": "One whole native row, never reconstructed from another grouping.",
      "properties": {
        "label": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Native label cell; no code is invented when absent.",
          "type": "object"
        },
        "percent": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Native Percent cell, retaining values above one hundred percent.",
          "type": "object"
        },
        "reports": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Native Events Reported count for this row. A footer counts occurrences, separate from the message report total; suppressed and displayed-total text stay unchanged.",
          "type": "object"
        }
      },
      "required": [
        "label",
        "reports",
        "percent"
      ],
      "type": "object"
    },
    "VaersScope": {
      "additionalProperties": false,
      "description": "Fixed native geographic selection, without a caller-selectable geography filter.",
      "properties": {
        "value": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exact selected native value and its own catalog label.",
          "type": "object"
        },
        "variable": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Native variable attributes, including source name and code.",
          "type": "object"
        }
      },
      "required": [
        "variable",
        "value"
      ],
      "type": "object"
    },
    "VaersSection": {
      "description": "One independent CDC WONDER grouping.",
      "enum": [
        "symptoms",
        "seriousness",
        "age"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native reported symptom rows.",
        " Reports classified by native seriousness.",
        " Native age groups."
      ]
    },
    "VaersSummary": {
      "additionalProperties": false,
      "description": "Bounded page of one independent native vaccine summary table.",
      "properties": {
        "dataset": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Native dataset attributes including processed-through vintage.",
          "type": "object"
        },
        "footer": {
          "$ref": "#/$defs/VaersRow",
          "description": "Whole native footer cells, never a sum calculated by this program."
        },
        "grouping": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Native grouping attributes.",
          "type": "object"
        },
        "interpretation": {
          "description": "Reviewed interpretation boundary.",
          "type": "string"
        },
        "measure_metadata": {
          "description": "Response-specific measure metadata without denominator inference.",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": "array"
        },
        "measures": {
          "description": "Source measure definitions, including original names and codes.",
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": "array"
        },
        "notices": {
          "description": "Applied native messages, evaluated caveats and footnotes.",
          "items": {
            "$ref": "#/$defs/VaersNotice"
          },
          "type": "array"
        },
        "report_total": {
          "description": "Native report-total message, separate from the footer aggregation.",
          "type": "string"
        },
        "rows": {
          "description": "Native row order with local paging.",
          "items": {
            "$ref": "#/$defs/VaersRow"
          },
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/VaersScope",
          "description": "Native fixed State / Territory selection."
        },
        "vaccine": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Native selected vaccine attributes.",
          "type": "object"
        }
      },
      "required": [
        "vaccine",
        "scope",
        "grouping",
        "dataset",
        "measures",
        "measure_metadata",
        "report_total",
        "footer",
        "rows",
        "notices",
        "interpretation"
      ],
      "type": "object"
    }
  },
  "$id": "biomcp.vaers_summary/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One versioned command response; schema identity comes only from its body type.",
  "properties": {
    "next": {
      "description": "Available next commands.",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Search page metadata."
    },
    "problems": {
      "description": "Rejected source fields.",
      "items": {
        "$ref": "#/$defs/Problem"
      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/AdverseEventSearch",
      "description": "Parsed query."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/VaersSummary"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.vaers_summary/1",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
