{
  "$defs": {
    "Concept": {
      "additionalProperties": false,
      "description": "One source concept with its optional ontology identifier.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated concept identifier."
        },
        "label": {
          "$ref": "#/$defs/Text",
          "description": "Original concept label."
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Curie": {
      "pattern": "^[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "DiagnosticCandidate": {
      "description": "A conflict is visible once without a selected name or card.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "One matched WHO product with cells from its first matching native row.",
          "properties": {
            "id": {
              "$ref": "#/$defs/WhoProductId",
              "description": "Exact source product identifier."
            },
            "identity_status": {
              "const": "who_ivd",
              "type": "string"
            },
            "manufacturer": {
              "description": "Unmodified manufacturer cell.",
              "type": "string"
            },
            "marker": {
              "description": "Unmodified marker cell.",
              "type": "string"
            },
            "product_name": {
              "description": "Unmodified product name cell.",
              "type": "string"
            }
          },
          "required": [
            "identity_status",
            "id",
            "product_name",
            "manufacturer",
            "marker"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One resolved native identity.",
          "properties": {
            "header": {
              "$ref": "#/$defs/GtrHeader",
              "description": "Compact source header."
            },
            "identity_status": {
              "const": "resolved",
              "type": "string"
            },
            "matched": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GtrTestRelation"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Complete native relation that matched the source selector."
            }
          },
          "required": [
            "identity_status",
            "header"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A native relation remains visible without a current card.",
          "properties": {
            "id": {
              "$ref": "#/$defs/GtrTestId",
              "description": "Exact relation-owned test accession and version."
            },
            "identity_status": {
              "const": "missing_card",
              "type": "string"
            },
            "matched": {
              "$ref": "#/$defs/GtrTestRelation",
              "description": "The original matched relation; no manufactured header."
            }
          },
          "required": [
            "identity_status",
            "id",
            "matched"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Several incompatible native rows with the same exact accession/version.",
          "properties": {
            "id": {
              "$ref": "#/$defs/GtrTestId",
              "description": "Exact conflicting identity."
            },
            "identity_status": {
              "const": "conflict",
              "type": "string"
            },
            "problem": {
              "$ref": "#/$defs/Problem",
              "description": "Explicit source identity problem; no chosen winner."
            }
          },
          "required": [
            "identity_status",
            "id",
            "problem"
          ],
          "type": "object"
        }
      ]
    },
    "DiagnosticCountUnit": {
      "description": "Meaning of the envelope's total for a source-owned diagnostic page.",
      "enum": [
        "product_identities",
        "test_identities",
        "native_relation_rows",
        "native_method_entries"
      ],
      "type": "string"
    },
    "DiagnosticDeviceId": {
      "pattern": "^(P[0-9]{6}(/S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))?|K[0-9]{6}|DEN[0-9]{6}|H[0-9]{6})$",
      "type": "string"
    },
    "DiagnosticLaboratory": {
      "additionalProperties": false,
      "description": "Compact native laboratory context without authorization interpretation.",
      "properties": {
        "country": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native country."
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Native laboratory identifier."
        },
        "institution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native institution name."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source laboratory name, absent when the native cell is empty."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DiagnosticPage": {
      "additionalProperties": false,
      "description": "Source-ordered GTR test candidates or WHO product headers.",
      "properties": {
        "count_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticCountUnit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact meaning of the envelope total; supplied by the owning source command."
        },
        "distinct_id_total": {
          "description": "Distinct complete native IDs across the selected relation collection.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "description": "Complete source-owned rows in native order; envelope totals count native rows.",
          "items": {
            "$ref": "#/$defs/DiagnosticCandidate"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "DiagnosticSearch": {
      "additionalProperties": false,
      "description": "Search one diagnostic source. A listing is not authorization; a companion row is not a treatment recommendation.",
      "properties": {
        "biomarker": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact table-0 biomarker cell; unsupported in the group table."
        },
        "bundle_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Immutable stored bundle revision retained by a continuation."
        },
        "condition_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact MedGen:CUI identifier only."
        },
        "device_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticDeviceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact PMA application, application/supplement or native K identity."
        },
        "drug_application": {
          "anyOf": [
            {
              "$ref": "#/$defs/FdaDrugApplication"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cell-owned typed NDA/BLA application."
        },
        "gene": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneSymbol"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact source gene_symbol field, without alias expansion."
        },
        "gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NcbiGeneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact source GeneID, exclusive with gene symbol."
        },
        "limit": {
          "default": 5,
          "description": "Five results by default; at most fifty source rows or product headers.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "manufacturer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Literal whole-word phrase in WHO's Manufacturer name cell."
        },
        "marker": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Literal whole-word phrase in WHO's Pathogen/Disease/Marker cell."
        },
        "offset": {
          "default": 0,
          "description": "Zero-based source result offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/DiagnosticSearchSource",
          "description": "Explicit native GTR, WHO IVD or FDA companion discovery."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/GtrTestType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact native test_type value."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "DiagnosticSearchSource": {
      "description": "One explicit diagnostic discovery source.",
      "enum": [
        "gtr",
        "fda-cdx",
        "who-ivd"
      ],
      "type": "string"
    },
    "EnsemblGeneId": {
      "pattern": "^ENSG[0-9]{11}(\\.[1-9][0-9]*)?$",
      "type": "string"
    },
    "FdaDrugApplication": {
      "pattern": "^(NDA|BLA)[0-9]{6}$",
      "type": "string"
    },
    "GeneRef": {
      "additionalProperties": false,
      "description": "A source-stated gene reference; its label never implies an identifier.",
      "properties": {
        "ensembl_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hgnc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HgncId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "ncbi_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NcbiGeneId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "GeneSymbol": {
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "GtrConditionRelation": {
      "additionalProperties": false,
      "description": "Native condition membership; SNOMED cells never become GeneID.",
      "properties": {
        "condition": {
          "$ref": "#/$defs/Concept",
          "description": "Shared MedGen concept with source label."
        },
        "mim_number": {
          "description": "Native MIM cell, including empty.",
          "type": "string"
        },
        "snomed_ct_id": {
          "description": "Native SNOMED CT cell, including empty; never a gene ID.",
          "type": "string"
        },
        "test_id": {
          "$ref": "#/$defs/GtrTestId",
          "description": "Complete owning test accession/version."
        },
        "test_type": {
          "$ref": "#/$defs/GtrTestType",
          "description": "Native source test type."
        }
      },
      "required": [
        "test_id",
        "test_type",
        "condition",
        "mim_number",
        "snomed_ct_id"
      ],
      "type": "object"
    },
    "GtrGeneRelation": {
      "additionalProperties": false,
      "description": "Native gene relation; its numeric ID comes only from the gene row.",
      "properties": {
        "gene": {
          "$ref": "#/$defs/GeneRef",
          "description": "Shared source-given GeneID and gene_symbol; absent GeneID stays absent."
        },
        "mim_number": {
          "description": "Native MIM cell, including empty.",
          "type": "string"
        },
        "native_gene_or_snomed_ct_id": {
          "description": "Uninterpreted nonempty `gene_or_SNOMED_CT_ID` when it is not a checked NCBI Gene ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "native_medgen": {
          "$ref": "#/$defs/Curie",
          "description": "Independent native MedGen identity from GTR_identifier."
        },
        "object_name": {
          "description": "Full source object_name without interpretation.",
          "type": "string"
        },
        "test_id": {
          "$ref": "#/$defs/GtrTestId",
          "description": "Complete owning test accession/version."
        },
        "test_type": {
          "$ref": "#/$defs/GtrTestType",
          "description": "Native source test type."
        }
      },
      "required": [
        "test_id",
        "test_type",
        "gene",
        "native_medgen",
        "mim_number",
        "object_name"
      ],
      "type": "object"
    },
    "GtrHeader": {
      "additionalProperties": false,
      "description": "Small resolved GTR candidate; broad gene and condition arrays stay off the header.",
      "properties": {
        "id": {
          "$ref": "#/$defs/GtrTestId",
          "description": "Complete source accession and version."
        },
        "laboratory": {
          "$ref": "#/$defs/DiagnosticLaboratory",
          "description": "Native laboratory context."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native test name, absent when the cell is empty."
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Source record URL."
        }
      },
      "required": [
        "id",
        "laboratory",
        "url"
      ],
      "type": "object"
    },
    "GtrMethod": {
      "additionalProperties": false,
      "description": "One entry from one independent native method list.",
      "properties": {
        "index": {
          "description": "Zero-based native list position.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "list": {
          "$ref": "#/$defs/GtrMethodList",
          "description": "Independent source list; lists are never positionally paired."
        },
        "test_id": {
          "$ref": "#/$defs/GtrTestId",
          "description": "Complete owning test accession/version."
        },
        "value": {
          "description": "Complete unmodified source entry.",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "list",
        "index",
        "value"
      ],
      "type": "object"
    },
    "GtrMethodList": {
      "description": "Independent native GTR method lists.",
      "enum": [
        "method_categories",
        "methods",
        "platforms"
      ],
      "type": "string"
    },
    "GtrTestId": {
      "pattern": "^GTR[0-9]{9}\\.[1-9][0-9]*$",
      "type": "string"
    },
    "GtrTestRelation": {
      "description": "Source-owned native membership or one independent method-list entry.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Native gene relation row.",
          "properties": {
            "kind": {
              "const": "gene",
              "type": "string"
            },
            "relation": {
              "$ref": "#/$defs/GtrGeneRelation"
            }
          },
          "required": [
            "kind",
            "relation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native condition relation row.",
          "properties": {
            "kind": {
              "const": "condition",
              "type": "string"
            },
            "relation": {
              "$ref": "#/$defs/GtrConditionRelation"
            }
          },
          "required": [
            "kind",
            "relation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One independent method-list entry.",
          "properties": {
            "kind": {
              "const": "method",
              "type": "string"
            },
            "relation": {
              "$ref": "#/$defs/GtrMethod"
            }
          },
          "required": [
            "kind",
            "relation"
          ],
          "type": "object"
        }
      ]
    },
    "GtrTestType": {
      "description": "Native GTR relation test category, not an offering or authorization judgment.",
      "enum": [
        "Clinical",
        "Research",
        "Clinical microbial"
      ],
      "type": "string"
    },
    "HgncId": {
      "pattern": "^HGNC:[1-9][0-9]*$",
      "type": "string"
    },
    "NcbiGeneId": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
        " Open Targets.",
        " openFDA SPL labels.",
        " Drugs@FDA application records.",
