{
  "$defs": {
    "Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "DiseaseEndpoint": {
      "description": "One native endpoint with an identifier and an optional source label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Curie",
          "description": "Exact source identifier."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source label when supplied."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.disease-relation/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A publisher relation with distinct endpoints and predicate.",
  "properties": {
    "attribution": {
      "$ref": "#/$defs/Attribution",
      "description": "Publisher record and version."
    },
    "description": {
      "description": "Unchanged native cross-reference description when supplied.",
      "type": [
        "string",
        "null"
      ]
    },
    "object": {
      "$ref": "#/$defs/DiseaseEndpoint",
      "description": "Native object."
    },
    "predicate": {
      "$ref": "#/$defs/Curie",
      "description": "Publisher predicate, without equivalence promotion."
    },
    "subject": {
      "$ref": "#/$defs/DiseaseEndpoint",
      "description": "Native subject."
    }
  },
  "required": [
    "subject",
    "predicate",
    "object",
    "attribution"
  ],
  "title": "DiseaseRelation",
  "type": "object"
}
