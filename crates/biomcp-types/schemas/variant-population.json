{
  "$defs": {
    "Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ]
    },
    "VariantInput": {
      "description": "A validated canonical VariantInput string.",
      "pattern": "(^(rs[1-9][0-9]*|CA[0-9]{6,}|PA[1-9][0-9]*|VCV[0-9]{9}(\\.[1-9][0-9]*)?|clinvar:[1-9][0-9]*|COS[VMN][1-9][0-9]*|ga4gh:VA\\.[A-Za-z0-9_-]{32})$|^(?!(?:[^:(]*\\()?([NX]P_([0-9]{6}|[0-9]{9})\\.[1-9][0-9]*|ENSP[0-9]{11}\\.[1-9][0-9]*|LRG_[0-9]+p[0-9]+)(?:\\([^:]*\\)|\\))?:[gcnrmo]\\.)((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?)(\\(([A-Za-z][A-Za-z0-9._/@-]*|[A-Za-z0-9_.]+)\\))?:([gcnrpmo]\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*|[pr]\\.(\\?|\\(\\?\\)|=|\\(=\\))|r\\.(spl\\??|\\(spl\\?\\)))$|^[1-9][0-9]*$|^chr([1-9][0-9]*|X|Y|M|MT):g\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*$)",
      "type": "string"
    },
    "VariantResolver": {
      "description": "Explicit source service for reference-qualified notation.",
      "enum": [
        "car",
        "mutalyzer",
        "variantvalidator"
      ],
      "type": "string"
    }
  },
  "$id": "biodata.variant-population/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read a bounded ancestry-detail page from the exact source-given GRCh38 allele.",
  "properties": {
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/Build"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit source assembly when required by identity input."
    },
    "detail": {
      "description": "Read source ancestry groups, preserving overlapping groups individually.",
      "type": "boolean"
    },
    "input": {
      "$ref": "#/$defs/VariantInput",
      "description": "Exact published allele identity; ambiguous candidates must first be selected.",
      "x-positional": 0
    },
    "limit": {
      "default": 10,
      "description": "Maximum rows per page.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Native rows to skip.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "resolver": {
      "$ref": "#/$defs/VariantResolver",
      "default": "car",
      "description": "Resolver for reference-qualified input."
    }
  },
  "required": [
    "input"
  ],
  "title": "VariantPopulationQuery",
  "type": "object"
}
