{
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link."
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "CivicClaimKind": {
      "description": "CIViC native claim collection.",
      "enum": [
        "evidence",
        "assertions"
      ],
      "type": "string"
    },
    "DrugDiseaseReference": {
      "additionalProperties": false,
      "description": "One native disease identifier and its own source label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Exact identifier spelling, without CURIE conversion."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Label attached to this identifier by the source."
        },
        "namespace": {
          "$ref": "#/$defs/Text",
          "description": "Source namespace spelling, such as EFO or MeSH."
        }
      },
      "required": [
        "namespace",
        "id"
      ],
      "type": "object"
    },
    "DrugGet": {
      "additionalProperties": false,
      "description": "Exact native ID retrieval with an explicitly selected source.",
      "properties": {
        "civic_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native continuation cursor for that exact drug, profile and claim collection."
        },
        "civic_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/CivicClaimKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Independent native evidence or assertion collection within the selected profile."
        },
        "civic_profile": {
          "description": "Selected native CIViC molecular profile for a drug-scoped claim stream.",
          "format": "uint64",
          "maximum": 2147483647,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "input": {
          "$ref": "#/$defs/DrugId",
          "description": "Published source-native identifier, never SOURCE:ID or a selected name.",
          "x-positional": 0
        },
        "label_section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact native label heading, required only for the label section."
        },
        "product_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit native application product number, only for approvals."
        },
        "section": {
          "description": "Explicit named disclosures; empty means identity only.",
          "items": {
            "$ref": "#/$defs/DrugSection"
          },
          "type": "array",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Named section page size, refused on an identity-only card.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "section_offset": {
          "description": "Named section continuation, refused on an identity-only card.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/DrugSource",
          "description": "Required source; there is no default exact-ID resolver."
        }
      },
      "required": [
        "input",
        "source"
      ],
      "type": "object"
    },
    "DrugHeader": {
      "additionalProperties": false,
      "description": "One source candidate, without authorization, targets, label text or interactions.",
      "properties": {
        "id": {
          "$ref": "#/$defs/DrugId",
          "description": "Published native identifier."
        },
        "identity_level": {
          "$ref": "#/$defs/DrugIdentityLevel",
          "description": "Level established only by the endpoint or record type."
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Original source display name."
        },
        "source": {
          "$ref": "#/$defs/DrugSource",
          "description": "The single source responsible for this header."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native record type."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record URL."
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native source revision, omitted when the source supplies none."
        }
      },
      "required": [
        "id",
        "source",
        "identity_level"
      ],
      "type": "object"
    },
    "DrugId": {
      "pattern": "^(?:[A-Z][A-Z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "DrugIdentity": {
      "additionalProperties": false,
      "description": "One source record identity, without any equivalence or authorization claim.",
      "properties": {
        "id": {
          "$ref": "#/$defs/DrugId",
          "description": "Published native record identifier."
        },
        "identity_level": {
          "$ref": "#/$defs/DrugIdentityLevel",
          "description": "Level established by the endpoint or record type; unknown stays unknown."
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Original source name."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for this identity."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native record type, without local classification."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native record URL."
        }
      },
      "required": [
        "id",
        "source",
        "identity_level"
      ],
      "type": "object"
    },
    "DrugIdentityLevel": {
      "description": "Identity level established by the source endpoint or record type, never inferred from ID shape.",
      "enum": [
        "ingredient",
        "salt",
        "clinical_formulation",
        "branded_product",
        "spl_set",
        "spl_version",
        "ndc_package",
        "fda_application",
        "fda_product",
        "ema_authorization",
        "ema_application",
        "orphan_designation",
        "unknown"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Source-stated ingredient identity.",
        " Source-stated salt identity.",
        " Source-stated clinical formulation identity.",
        " Source-stated branded product identity.",
        " Source-stated spl set identity.",
        " Source-stated spl version identity.",
        " Source-stated ndc package identity.",
        " Source-stated fda application identity.",
        " Source-stated fda product identity.",
        " Source-stated ema authorization identity.",
        " Source-stated ema application identity.",
        " Source-stated orphan designation identity.",
        " Source-stated unknown identity."
      ]
    },
    "DrugIndicationClaim": {
      "additionalProperties": false,
      "description": "A source indication retaining its full population and combination wording.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "description": "Native claim provenance."
        },
        "combination": {
          "description": "Complete source-stated combination members, without local joins.",
          "items": {
            "$ref": "#/$defs/DrugIdentity"
          },
          "type": "array"
        },
        "disease_references": {
          "description": "Independently labeled native disease identifiers, without cross-source normalization.",
          "items": {
            "$ref": "#/$defs/DrugDiseaseReference"
          },
          "type": "array"
        },
        "drug": {
          "$ref": "#/$defs/DrugIdentity",
          "description": "Source drug identity."
        },
        "indication": {
          "$ref": "#/$defs/Text",
          "description": "Complete native indication wording."
        },
        "population": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Population wording explicitly supplied separately."
        },
        "references": {
          "description": "Source-native supporting references.",
          "items": {
            "$ref": "#/$defs/DrugNativeReference"
          },
          "type": "array"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DrugStage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated development stage, separate from authorization events."
        }
      },
      "required": [
        "drug",
        "indication",
        "attribution"
      ],
      "type": "object"
    },
    "DrugIndications": {
      "additionalProperties": false,
      "description": "Source-native indication wording, populations and combinations.",
      "properties": {
        "identity": {
          "$ref": "#/$defs/DrugHeader",
          "description": "Selected native identity, checked independently of section facts."
        },
        "indications": {
          "$ref": "#/$defs/Section",
          "description": "Existing typed section state, preserving empty, unavailable and skipped outcomes."
        }
      },
      "required": [
        "identity",
        "indications"
      ],
      "type": "object"
    },
    "DrugNativeReference": {
      "additionalProperties": false,
      "description": "Typed source reference shared by mechanism and indication records.",
      "properties": {
        "ref_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source reference identifier, when supplied."
        },
        "ref_type": {
          "$ref": "#/$defs/Text",
          "description": "Native reference type."
        },
        "ref_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source reference link, when supplied."
        }
      },
      "required": [
        "ref_type"
      ],
      "type": "object"
    },
    "DrugRecords": {
      "additionalProperties": false,
      "description": "One bounded native row page, without fabricating an unknown total.",
      "properties": {
        "offset": {
          "description": "Source row offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "records": {
          "description": "Native source rows in order.",
          "items": {
            "$ref": "#/$defs/DrugIndicationClaim"
          },
          "type": "array"
        },
        "retrieved": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual retrieval date, never substituted for source revision."
        },
        "total": {
          "description": "Native total only when supplied.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "truncated": {
          "description": "Native source truncation indicator.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset or bundle revision."
        }
      },
      "required": [
        "offset"
      ],
      "type": "object"
    },
    "DrugSection": {
      "description": "Explicit drug disclosures; identity cards never expand into these sections.",
      "enum": [
        "xrefs",
        "targets",
        "indications",
        "civic",
        "label",
        "approvals",
        "regulatory",
        "interactions"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " All native identity cross-references and product links, mechanically paged.",
        " Native target and mechanism relations.",
        " Native indication wording.",
        " Native CIViC therapy evidence and profile context.",
        " One exact native label heading.",
        " Native application and product history rows.",
        " Source-scoped regulator events.",
        " Native DDInter partner rows and levels; five rows per default page, with explicit section limits preserved."
      ]
    },
    "DrugSource": {
      "enum": [
        "who-pq",
        "mychem",
        "chembl",
        "opentargets",
        "civic",
        "openfda-label",
        "drugsfda",
        "ema",
        "ddinter"
      ],
      "type": "string"
    },
    "DrugStage": {
      "additionalProperties": false,
      "description": "One source development-stage field and its unchanged value.",
      "properties": {
        "field": {
          "description": "Exact native field name.",
          "type": "string"
        },
        "value": {
          "description": "Exact source string, without an authorization interpretation.",
          "type": "string"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "type": "object"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Section": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/DrugRecords",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "alphagenome",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
