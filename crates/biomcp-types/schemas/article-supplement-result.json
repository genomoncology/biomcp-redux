    },
    "SourceNotice": {
      "description": "A provider query interpretation notice.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A checked provider answer survived a local cache failure.",
          "properties": {
            "kind": {
              "const": "cache_problem",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/CacheProblem",
              "description": "Bounded local failure without paths or database diagnostics."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph_truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An empty LitVar lookup can be repeated with a caller-supplied rsID.",
          "properties": {
            "kind": {
              "const": "litvar_rsid_hint",
              "type": "string"
            },
            "message": {
              "description": "Guidance that never supplies or infers an rsID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PubMed supplied a named ESearch warning without changing its phrases.",
          "properties": {
            "kind": {
              "const": "pubmed_warning",
              "type": "string"
            },
            "name": {
              "description": "Original provider warning name, including names added by PubMed later.",
              "type": "string"
            },
            "phrases": {
              "description": "Original provider phrases, preserving whitespace and quotes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name",
            "phrases"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not_found_words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "words"
          ],
          "type": "object"
        }
      ]
    },
    "SourceOutcome": {
      "additionalProperties": false,
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched": {
          "description": "Retrieved identity depth.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Provider query notices that do not indicate failure.",
          "items": {
            "$ref": "#/$defs/SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "format": "uri",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "The source's own entry for an entity.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Native source identifier."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Link to that entry.",
          "format": "uri"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
