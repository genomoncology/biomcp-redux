{
  "$defs": {
    "ArticleInput": {
      "description": "A validated canonical ArticleInput string.",
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|PPR[0-9]*[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.article-pdf/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Download one publisher PDF to an explicit file or existing folder.",
  "properties": {
    "input": {
      "$ref": "#/$defs/ArticleInput",
      "description": "Article identity.",
      "x-positional": 0
    },
    "replace": {
      "description": "Replace an existing file only when explicitly requested.",
      "type": "boolean"
    },
    "save": {
      "$ref": "#/$defs/Text",
      "description": "Destination file or existing folder."
    }
  },
  "required": [
    "input",
    "save"
  ],
  "title": "ArticlePdf",
  "type": "object"
}
