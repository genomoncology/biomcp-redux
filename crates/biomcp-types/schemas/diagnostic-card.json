    "SourceNotice": {
      "description": "A source notice or request recovery step.",
      "oneOf": [
        {
          "description": "Local request limits and source-specific recovery guidance.",
          "properties": {
            "kind": {
              "const": "request-guidance",
              "type": "string"
            },
            "message": {
              "description": "Reviewed guidance without provider response text.",
              "type": "string"
            },
            "retry_after_seconds": {
              "description": "Seconds left before another source request may be admitted.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Registered conditions lack the literal words requested in a condition search.",
          "properties": {
            "kind": {
              "const": "condition-word-mismatch",
              "type": "string"
            },
            "message": {
              "description": "The source searches several fields and can expand terms; no expansion cause is inferred.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "A checked provider answer survived a local cache failure.",
          "properties": {
            "kind": {
              "const": "cache-problem",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/CacheProblem",
              "description": "Bounded local failure without paths or database diagnostics."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph-truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "description": "An empty LitVar lookup can be repeated with a caller-supplied rsID.",
          "properties": {
            "kind": {
              "const": "litvar-rsid-hint",
              "type": "string"
            },
            "message": {
              "description": "Guidance that never supplies or infers an rsID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "PubMed supplied a named ESearch warning without changing its phrases.",
          "properties": {
            "kind": {
              "const": "pubmed-warning",
              "type": "string"
            },
            "name": {
              "description": "Original provider warning name, including names added by PubMed later.",
              "type": "string"
            },
            "phrases": {
              "description": "Original provider phrases, preserving whitespace and quotes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not-found-words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SourceOutcome": {
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched": {
          "description": "Retrieved identity depth.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Source notices and request recovery guidance.",
          "items": {
            "$ref": "#/$defs/SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "format": "uri",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Step": {
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "Use": {
      "description": "Reviewed source-use category, without inferring rights in individual records.",
      "enum": [
        "open",
        "attribution",
        "noncommercial",
        "restricted"
      ],
      "type": "string"
    },
    "WhoIvdRow": {
      "description": "One original WHO CSV row; each repeated field retains its own row scope.",
      "properties": {
        "assay_format": {
          "description": "Complete native assay format cell; no interpretation or inferred date.",
          "type": "string"
        },
        "manufacturer": {
          "description": "Complete native manufacturer cell; no interpretation or inferred date.",
          "type": "string"
        },
        "marker": {
          "description": "Complete native marker cell; no interpretation or inferred date.",
          "type": "string"
        },
        "prequalification_year": {
          "description": "Complete native prequalification year cell; no interpretation or inferred date.",
          "type": "string"
        },
        "product_code": {
          "description": "Complete native product code cell; no interpretation or inferred date.",
          "type": "string"
        },
        "product_name": {
          "description": "Complete native product name cell; no interpretation or inferred date.",
          "type": "string"
        },
        "regulatory_version": {
          "description": "Complete native regulatory version cell; no interpretation or inferred date.",
          "type": "string"
        }
      },
      "required": [
        "product_name",
        "product_code",
        "assay_format",
        "manufacturer",
        "marker",
        "regulatory_version",
        "prequalification_year"
      ],
      "type": "object"
    },
    "WhoProductId": {
      "description": "WHO product listing identity, independent of product codes.",
      "pattern": "^[0-9]{4,5}-([0-9]{3}|[0-9]{5})-[0-9]{2}$",
      "type": "string"
    }
  },
  "$id": "biomcp.diagnostic-card/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One versioned command response; schema identity comes only from its body type.\nJSON readers ignore unknown fields and unknown growable enum values within a major.",
  "properties": {
    "local_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/CacheProblem"
        },
        {
          "type": "null"
        }
      ],
      "description": "Bounded local cache failure, independent of provider outcomes."
    },
    "next": {
      "description": "Available next commands.",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Search page metadata."
    },
    "problems": {
      "description": "Rejected source fields.",
      "items": {
        "$ref": "#/$defs/Problem"
      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/DiagnosticGet",
      "description": "Parsed query."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticCard"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.diagnostic-card/2",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
