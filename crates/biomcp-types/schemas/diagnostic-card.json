{
  "$defs": {
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "DeviceRecallHeader": {
      "description": "Native medical device product recall header, independent of event grouping.",
      "properties": {
        "event_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native res_event_number."
        },
        "firm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native recalling_firm."
        },
        "initiated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native event_date_initiated, preserving the source day."
        },
        "product_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native device category code."
        },
        "recall_number": {
          "$ref": "#/$defs/DeviceRecallNumber",
          "description": "Exact native product_res_number."
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native recall_status, without interpreting completion."
        }
      },
      "required": [
        "recall_number"
      ],
      "type": "object"
    },
    "DeviceRecallNumber": {
      "description": "Native FDA product recall number, independent of its event number.",
      "pattern": "^Z-[0-9]{4}-[0-9]{4}$",
      "type": "string"
    },
    "DiagnosticCard": {
      "description": "Exactly one source-owned diagnostic card; conflicts have no card variant.",
      "oneOf": [
        {
          "description": "Exact native medical device recall with an optional exact enforcement classification.",
          "properties": {
            "classification": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Classification from an exact enforcement recall_number match, absent without that match."
            },
            "distribution_pattern": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native distribution_pattern."
            },
            "header": {
              "$ref": "#/$defs/DeviceRecallHeader",
              "description": "Native recall identity and dates."
            },
            "k_numbers": {
              "description": "Top-level native 510(k) submission entries; harmonized openfda fields never enter this list.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "kind": {
              "const": "device-recall",
              "type": "string"
            },
            "pma_numbers": {
              "description": "Top-level native PMA submission entries; no code-level identifiers enter this list.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "product_description": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native product_description."
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native reason_for_recall."
            },
            "root_cause": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native root_cause_description."
            }
          },
          "required": [
            "kind",
            "header"
          ],
          "type": "object"
        },
        {
          "description": "Exact resolved GTR accession/version.",
          "properties": {
            "clia_number": {
              "description": "Native CLIA number; never authorization.",
              "type": "string"
            },
            "header": {
              "$ref": "#/$defs/GtrHeader",
              "description": "Source identity header."
            },
            "kind": {
              "const": "gtr-test",
              "type": "string"
            },
            "lab_test_id": {
              "description": "Native laboratory test identifier, including empty.",
              "type": "string"
            },
            "last_touch_date": {
              "$ref": "#/$defs/Text",
              "description": "Native revision date; not a local retrieval date."
            },
            "manufacturer_test_name": {
              "description": "Native manufacturer test name, including empty.",
              "type": "string"
            },
            "native_status": {
              "$ref": "#/$defs/GtrNativeStatus",
              "description": "Separate native flags."
            },
            "sections": {
              "description": "Source-supported named pages.",
              "items": {
                "$ref": "#/$defs/DiagnosticSection"
              },
              "type": "array"
            },
            "state_license_numbers": {
              "description": "Whole original license number list, independently retained.",
              "type": "string"
            },
            "state_licenses": {
              "description": "Whole original license list, not paired with numbers by position.",
              "type": "string"
            },
            "test_create_date": {
              "$ref": "#/$defs/Text",
              "description": "Source creation date."
            },
            "test_deletion_date": {
              "description": "Native deletion cell, including empty.",
              "type": "string"
            },
            "test_development": {
              "description": "Native development description, without regulatory inference.",
              "type": "string"
            },
            "test_order_code": {
              "description": "Native order code, including empty.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "header",
            "native_status",
            "last_touch_date",
            "test_create_date",
            "test_deletion_date",
            "manufacturer_test_name",
            "test_development",
            "lab_test_id",
            "test_order_code",
            "clia_number",
            "state_licenses",
            "state_license_numbers"
          ],
          "type": "object"
        },
        {
          "description": "All native rows under one WHO Product ID.",
          "properties": {
            "id": {
              "$ref": "#/$defs/WhoProductId",
              "description": "Native product listing identity."
            },
            "kind": {
              "const": "who-ivd-product",
              "type": "string"
            },
            "native_rows": {
              "description": "All original rows belonging to this exact product, without clipping.",
              "items": {
                "$ref": "#/$defs/WhoIvdRow"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Exact native FDA base or supplement, never an application-wide inferred claim.",
          "properties": {
            "header": {
              "$ref": "#/$defs/DiagnosticPmaHeader",
              "description": "Exact selected source header."
            },
            "kind": {
              "const": "pma-submission",
              "type": "string"
            },
            "sections": {
              "description": "Source-supported pages for this exact base or supplement.",
              "items": {
                "$ref": "#/$defs/DiagnosticSection"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "header"
          ],
          "type": "object"
        },
        {
          "description": "Exact native 510(k) clearance, separate from PMA approval.",
          "properties": {
            "applicant": {
              "description": "Native applicant; missing and empty remain distinct.",
              "type": [
                "string",
                "null"
              ]
            },
            "date_received": {
              "description": "Native date_received; missing and empty remain distinct.",
              "type": [
                "string",
                "null"
              ]
            },
            "decision_code": {
              "description": "Native decision_code; missing and empty remain distinct.",
              "type": [
                "string",
                "null"
              ]
            },
            "decision_date": {
              "description": "Native decision_date; missing and empty remain distinct.",
              "type": [
                "string",
                "null"
              ]
            },
            "decision_description": {
              "description": "Native decision_description; missing and empty remain distinct.",
              "type": [
                "string",
                "null"
              ]
            },
            "device_name": {
              "description": "Native device_name; missing and empty remain distinct.",
              "type": [
                "string",
                "null"
              ]
            },
            "k_number": {
              "$ref": "#/$defs/DiagnosticDeviceId",
              "description": "Exact native K number."
            },
            "kind": {
              "const": "clearance",
              "type": "string"
            },
            "product_code": {
              "description": "Native product_code; missing and empty remain distinct.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "k_number"
          ],
          "type": "object"
        }
      ]
    },
    "DiagnosticDeviceId": {
      "description": "Source device identifier; DEN and H identifiers imply no executable get.",
      "pattern": "^(P[0-9]{6}(/S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))?|K[0-9]{6}|DEN[0-9]{6}|H[0-9]{6})$",
      "type": "string"
    },
    "DiagnosticGet": {
      "description": "Get one exact source record or supported section. A listing is not authorization; a companion row is not a treatment recommendation.",
      "properties": {
        "bundle_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Immutable stored bundle revision retained by a continuation."
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Exact native identity, including version for GTR.",
          "x-positional": 0
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "GTR: genes, conditions, methods. PMA: regulatory, supplements.\nWHO, 510(k) and device recalls have no sections; omit for the card.",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Maximum native rows; omitted means five rows, or one regulatory fragment.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Zero-based native row or fragment offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/DiagnosticGetSource",
          "description": "Explicit source: GTR accession/version, WHO Product ID, PMA P number,\n510(k) K number or device recall Z-NNNN-YYYY."
        },
        "supplement": {
          "anyOf": [
            {
              "$ref": "#/$defs/PmaSupplement"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact native PMA supplement; absent selects the base row."
        }
      },
      "required": [
        "id",
        "source"
      ],
      "type": "object"
    },
    "DiagnosticGetSource": {
      "description": "One explicit exact diagnostic record source.",
      "enum": [
        "gtr",
        "who-ivd",
        "fda-pma",
        "fda-510k",
        "fda-device-recall"
      ],
      "type": "string"
    },
    "DiagnosticLaboratory": {
      "description": "Compact native laboratory context without authorization interpretation.",
      "properties": {
        "country": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native country."
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Native laboratory identifier."
        },
        "institution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native institution name."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source laboratory name, absent when the native cell is empty."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DiagnosticPmaHeader": {
      "description": "Compact exact PMA row identity; its native empty base cell is explicit.",
      "properties": {
        "applicant": {
          "description": "Native applicant when supplied, including explicit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "decision_code": {
          "description": "Native decision_code when supplied, including explicit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "decision_date": {
          "description": "Native decision_date when supplied, including explicit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "pma_number": {
          "$ref": "#/$defs/PmaNumber",
          "description": "Native application."
        },
        "supplement_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/PmaSupplementCell"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent differs from explicit empty base cell."
        },
        "trade_name": {
          "description": "Native trade_name when supplied, including explicit empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Exact source record URL.",
          "format": "uri"
        }
      },
      "required": [
        "pma_number",
        "url"
      ],
      "type": "object"
    },
    "DiagnosticSection": {
      "description": "Source-supported diagnostic sections; no all section.",
      "enum": [
        "genes",
        "conditions",
        "methods",
        "regulatory",
        "supplements"
      ],
      "type": "string",
      "x-enum-descriptions": [
        "GTR native gene rows; five per page.",
        "GTR native condition rows; five per page.",
        "GTR native method entries; five per page.",
        "Selected PMA submission statement; one fragment per page.",
        "PMA base application supplement headers; five per page."
      ]
    },
    "GtrHeader": {
      "description": "Small resolved GTR candidate; broad gene and condition arrays stay off the header.",
      "properties": {
        "id": {
          "$ref": "#/$defs/GtrTestId",
          "description": "Complete source accession and version."
        },
        "laboratory": {
          "$ref": "#/$defs/DiagnosticLaboratory",
          "description": "Native laboratory context."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native test name, absent when the cell is empty."
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Source record URL.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "laboratory",
        "url"
      ],
      "type": "object"
    },
    "GtrNativeStatus": {
      "description": "Native flags retain distinct source meanings and exact source codes.",
      "properties": {
        "lab_currStat": {
          "description": "Native laboratory current status.",
          "type": "string"
        },
        "lab_pubStat": {
          "description": "Native laboratory public status.",
          "type": "string"
        },
        "now_current": {
          "description": "Current version flag, not current clinical availability.",
          "type": "string"
        },
        "test_currStat": {
          "description": "Native test current status.",
          "type": "string"
        },
        "test_pubStat": {
          "description": "Native test public status.",
          "type": "string"
        }
      },
      "required": [
        "now_current",
        "test_currStat",
        "test_pubStat",
        "lab_currStat",
        "lab_pubStat"
      ],
      "type": "object"
    },
    "GtrTestId": {
      "description": "Complete native GTR accession and positive version.",
      "pattern": "^GTR[0-9]{9}\\.[1-9][0-9]*$",
      "type": "string"
    },
    "PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "PmaNumber": {
      "description": "Native FDA PMA base application number.",
      "pattern": "^P[0-9]{6}$",
      "type": "string"
    },
    "PmaSupplement": {
      "description": "Explicit native PMA supplement selector; no invented base alias.",
      "pattern": "^S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
      "type": "string"
    },
    "PmaSupplementCell": {
      "description": "Native PMA supplement cell; empty denotes base and never becomes S000.",
      "pattern": "^($|S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))$",
      "type": "string"
    },
    "PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " GenCC submitter assessments.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " AlphaGenome.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
        " Open Targets.",
        " openFDA SPL labels.",
        " Drugs@FDA application records.",
        " European Medicines Agency.",
        " WHO finished pharmaceutical products.",
        " DDInter interaction records.",
        " MyChem DrugBank Open identity subset only.",
        " MyChem DrugCentral component.",
        " MyChem Guide to Pharmacology component.",
        " MyChem UNII identities.",
        " MyChem NDC package identities.",
        " MyChem openFDA cross-references only.",
        " Ontology Lookup Service.",
        " MyDisease.info aggregation.",
        " Monarch associations.",
        " SEER Explorer.",
        " MONDO published ontology content.",
        " Disease Ontology published content.",
        " NCI Thesaurus ontology content.",
        " HPO-published annotations.",
        " Reviewed Orphadata Science content.",
        " Separately licensed OMIM payload only.",
        " openFDA FAERS drug adverse event reports.",
        " CDC WONDER vaccine report summaries.",
        " openFDA MAUDE device event reports.",
        " Source-reported MedDRA reaction labels and versions.",
        " Source-carried GMDN device terminology.",
        " NCBI Genetic Testing Registry public reports.",
        " WHO prequalified in vitro diagnostics.",
        " FDA companion diagnostic device tables.",
        " openFDA premarket approval submissions.",
        " FDA native 510(k) clearance records.",
        " openFDA medical device product recall records.",
        " Clinical Pharmacogenetics Implementation Consortium.",
        " ClinPGx pharmacogenomics annotations.",
        " Public cBioPortal with study-specific reuse terms.",
        " Cellosaurus cell line identity."
      ],
      "x-extensible-enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
