    "Reply_SourceTimestamp": {
      "description": "Checked source timestamp with its stated precision and offset.",
      "properties": {
        "timezone": {
          "$ref": "#/$defs/Reply_SourceTimestampTimezone",
          "description": "Whether the native timestamp includes a timezone."
        },
        "value": {
          "$ref": "#/$defs/Reply_SourceTimestampValue",
          "description": "Checked RFC 3339 source timestamp.",
          "format": "date-time"
        }
      },
      "required": [
        "value",
        "timezone"
      ],
      "type": "object"
    },
    "Reply_SourceTimestampTimezone": {
      "description": "Availability of timezone information in a native timestamp.",
      "enum": [
        "in-value",
        "source-gave-none"
      ],
      "type": "string"
    },
    "Reply_SourceTimestampValue": {
      "description": "RFC 3339 source text preserving offset and precision. The parser additionally validates the calendar day and UTC month-end position of leap seconds. Years follow PartialDate's 0001–9999 range.",
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.change-report/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What a saved search gained, lost or changed between two snapshots; derived, never stored.",
  "properties": {
    "changed": {
      "description": "Records in both whose rows differ.",
      "items": {
        "$ref": "#/$defs/Reply_SavedRef"
      },
      "type": "array"
    },
    "from": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_ChangeSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "description": "The earlier snapshot, absent on a first check."
    },
    "gone": {
      "description": "Records the earlier snapshot holds and the later one does not; also listed when rebaselined.",
      "items": {
        "$ref": "#/$defs/Reply_SavedRef"
      },
      "type": "array"
    },
    "new": {
      "description": "Records the later snapshot holds and the earlier one does not; also listed when rebaselined.",
      "items": {
        "$ref": "#/$defs/Reply_SavedRef"
      },
      "type": "array"
    },
    "next_due": {
      "description": "Unix seconds from which the next check reads the source.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "search": {
      "$ref": "#/$defs/Reply_Text",
      "description": "Name of the saved search."
    },
    "state": {
      "$ref": "#/$defs/Reply_ChangeState",
      "description": "What the check found."
    },
    "to": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_ChangeSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "description": "The later snapshot, absent when a search not yet checked is not due."
    }
  },
  "required": [
    "search",
    "state",
    "next_due"
  ],
  "title": "ChangeReport",
  "type": "object"
}
