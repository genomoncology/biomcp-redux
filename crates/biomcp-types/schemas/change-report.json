{
  "$defs": {
    "Reply_ChangeSnapshot": {
      "description": "A snapshot a change report compares.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Snapshot identifier."
        },
        "taken": {
          "description": "Unix seconds when the snapshot was taken.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "The snapshot's matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "taken",
        "total"
      ],
      "type": "object"
    },
    "Reply_ChangeState": {
      "description": "What a check of a saved search found.",
      "enum": [
        "first",
        "unchanged",
        "changed",
        "not_due",
        "rebaselined",
        "incomplete",
        "failed"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The first check; there is nothing to compare yet.",
        " The same records with the same rows as the last check.",
        " Records were gained, lost or changed; new, gone and changed list them.",
        " Checked less than an hour ago; nothing ran. Ask again at next_due.",
        " The row format changed since the last check, so new and gone list IDs but changed rows are not compared; the next check compares them.",
        " A check matched more records than a snapshot holds; only totals compare.",
        " The check could not finish, such as when the source failed or the saved words no longer parse; nothing was kept. Run saved changed NAME to see why."
      ]
    },
    "Reply_SavedRef": {
      "description": "One record a user kept: the identifier a get command reads.",
      "properties": {
        "as_of": {
          "description": "Unix seconds when the reference was kept.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "entity": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Entity word of the get command, such as gene or trial."
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact identifier the get command accepts."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Source"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source the identifier belongs to, when identifiers are source-specific."
        },
        "source_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_SourceTimestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source data date of the kept record, when known."
        }
      },
      "required": [
        "entity",
        "id",
        "as_of"
      ],
      "type": "object"
    },
    "Reply_Source": {
