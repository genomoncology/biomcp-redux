{
  "$defs": {
    "AcmgAmp2015Code": {
      "description": "Checked AcmgAmp2015 codes.",
      "enum": [
        "pathogenic",
        "likely_pathogenic",
        "uncertain_significance",
        "likely_benign",
        "benign"
      ],
      "type": "string"
    },
    "AmpAscoCap2017LevelCode": {
      "description": "Checked AmpAscoCap2017Level codes.",
      "enum": [
        "level_a",
        "level_b",
        "level_c",
        "level_d"
      ],
      "type": "string"
    },
    "AmpAscoCap2017TierCode": {
      "description": "Checked AmpAscoCap2017Tier codes.",
      "enum": [
        "tier_i",
        "tier_ii",
        "tier_iii",
        "tier_iv"
      ],
      "type": "string"
    },
    "Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "CivicEvidenceLevelCode": {
      "description": "Source-defined CIViC evidence levels.",
      "enum": [
        "a",
        "b",
        "c",
        "d",
        "e"
      ],
      "type": "string"
    },
    "ClingenCgcVicc2022Code": {
      "description": "Checked ClingenCgcVicc2022 codes.",
      "enum": [
        "oncogenic",
        "likely_oncogenic",
        "uncertain_significance",
        "likely_benign",
        "benign"
      ],
      "type": "string"
    },
    "ClingenLowPenetrance2024Code": {
      "description": "Checked ClingenLowPenetrance2024 codes.",
      "enum": [
        "pathogenic_low_penetrance",
        "likely_pathogenic_low_penetrance",
        "established_risk_allele",
        "likely_risk_allele",
        "uncertain_risk_allele"
      ],
      "type": "string"
    },
    "Coding": {
      "description": "A code in one explicitly named source framework.",
      "oneOf": [
        {
          "description": "OncoKB oncogenicity vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/OncokbOncogenicityCode"
            },
            "system": {
              "const": "oncokb_oncogenicity",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "OncoKB evidence levels.",
          "properties": {
            "code": {
              "$ref": "#/$defs/OncokbLevelCode"
            },
            "system": {
              "const": "oncokb_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "CIViC evidence level.",
          "properties": {
            "code": {
              "$ref": "#/$defs/CivicEvidenceLevelCode"
            },
            "system": {
              "const": "civic_evidence_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "acmg_amp_2015 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/AcmgAmp2015Code"
            },
            "system": {
              "const": "acmg_amp_2015",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "clingen_low_penetrance_2024 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/ClingenLowPenetrance2024Code"
            },
            "system": {
              "const": "clingen_low_penetrance_2024",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "amp_asco_cap_2017_tier vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/AmpAscoCap2017TierCode"
            },
            "system": {
              "const": "amp_asco_cap_2017_tier",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "amp_asco_cap_2017_level vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/AmpAscoCap2017LevelCode"
            },
            "system": {
              "const": "amp_asco_cap_2017_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "clingen_cgc_vicc_2022 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/ClingenCgcVicc2022Code"
            },
            "system": {
              "const": "clingen_cgc_vicc_2022",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        }
      ]
    },
    "Concept": {
      "description": "One source concept with its optional ontology identifier.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated concept identifier."
        },
        "label": {
          "$ref": "#/$defs/Text",
          "description": "Original concept label."
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^\\s\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "Direction": {
      "description": "Assessment direction stated by the source.",
      "type": "string",
      "x-extensible-enum": [
        "supports",
        "disputes",
        "neutral"
      ]
    },
    "EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.[1-9][0-9]*)?$",
      "type": "string"
    },
    "GeneRef": {
      "description": "A source-stated gene reference; its label never implies an identifier.",
      "properties": {
        "ensembl_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hgnc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HgncId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "ncbi_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NcbiGeneId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:[1-9][0-9]*$",
      "type": "string"
    },
    "HgvsText": {
      "description": "Reference-qualified notation with its original text, without a molecular parse.",
      "pattern": "^((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?)(\\(([A-Za-z][A-Za-z0-9._/@-]*|[A-Za-z0-9_.]+)\\))?:[gcnrpmo]\\.[\\x20-\\x7e]+$",
      "type": "string"
    },
    "LeafRef": {
      "oneOf": [
        {
          "properties": {
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source-qualified HGVS."
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VariantId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source identifier."
            },
            "level": {
              "const": "allele",
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "properties": {
            "gene": {
              "$ref": "#/$defs/GeneRef",
              "description": "Source gene."
            },
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein HGVS."
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein label."
            },
            "level": {
              "const": "protein",
              "type": "string"
            }
          },
          "required": [
            "level",
            "gene"
          ],
          "type": "object"
        }
      ]
    },
    "NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "OncokbLevelCode": {
      "description": "Source-defined OncoKB vocabulary.",
      "enum": [
        "level_1",
        "level_2",
        "level_3a",
        "level_3b",
        "level_4",
        "level_r1",
        "level_r2",
        "level_dx1",
        "level_dx2",
        "level_dx3",
        "level_px1",
        "level_px2",
        "level_px3"
      ],
      "type": "string"
    },
    "OncokbOncogenicityCode": {
      "description": "Source-defined OncoKB vocabulary.",
      "enum": [
        "oncogenic",
        "likely_oncogenic",
        "likely_neutral",
        "inconclusive",
        "resistance",
        "unknown"
      ],
      "type": "string"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Predicate": {
      "description": "VA-Spec 1.1 proposition relationships in native snake_case.",
      "type": "string",
      "x-extensible-enum": [
        "is_causal_for",
        "is_oncogenic_for",
        "has_clinical_significance_for",
        "predicts_sensitivity_to",
        "predicts_resistance_to",
        "is_diagnostic_inclusion_criterion_for",
        "is_diagnostic_exclusion_criterion_for",
        "associated_with_better_outcome_for",
        "associated_with_worse_outcome_for",
        "impacts_function_of"
      ]
    },
    "Proposition": {
      "description": "Domain of a source claim.",
      "type": "string",
      "x-extensible-enum": [
        "pathogenicity",
        "oncogenicity",
        "clinical_significance",
        "therapeutic_response",
        "diagnostic",
        "prognostic",
        "functional_impact"
      ]
    },
    "Term": {
      "description": "A source label with optional explicitly supported coding.",
      "properties": {
        "coding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coding"
            },
            {
              "type": "null"
            }
          ],
          "description": "Documented framework coding."
        },
        "label": {
          "$ref": "#/$defs/Text",
          "description": "Original label."
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "VariantId": {
      "description": "Published variant-level identifiers, with each identifier's level retained.",
      "pattern": "^(rs[1-9][0-9]*|CA[0-9]{6,}|PA[1-9][0-9]*|VCV[0-9]{9}(\\.[1-9][0-9]*)?|clinvar:[1-9][0-9]*|COS[VMN][1-9][0-9]*|ga4gh:VA\\.[A-Za-z0-9_-]{32})$",
      "type": "string"
    },
    "VariantRef": {
      "description": "Checked source subject reference; at least one source identity or label is required.",
      "oneOf": [
        {
          "description": "Exact allele identifier or reference-qualified notation.",
          "properties": {
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source-qualified HGVS."
            },
            "id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VariantId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source identifier."
            },
            "level": {
              "const": "allele",
              "type": "string"
            }
          },
          "required": [
            "level"
          ],
          "type": "object"
        },
        {
          "description": "Protein-level assertion, without genomic conversion.",
          "properties": {
            "gene": {
              "$ref": "#/$defs/GeneRef",
              "description": "Source gene."
            },
            "hgvs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HgvsText"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein HGVS."
            },
            "label": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Source protein label."
            },
            "level": {
              "const": "protein",
              "type": "string"
            }
          },
          "required": [
            "level",
            "gene"
          ],
          "type": "object"
        },
        {
          "description": "Compound source profile, without an inferred allele.",
          "properties": {
            "label": {
              "$ref": "#/$defs/Text",
              "description": "Complete source label."
            },
            "level": {
              "const": "profile",
              "type": "string"
            },
            "members": {
              "description": "Source member references in their native order.",
              "items": {
                "$ref": "#/$defs/LeafRef"
              },
              "type": "array"
            },
            "record": {
              "$ref": "#/$defs/Text",
              "description": "Native profile ID."
            }
          },
          "required": [
            "level",
            "record",
            "label"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "biodata.statement/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One source claim, kept in its own framework and context.",
  "properties": {
    "allele_origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/Term"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source-stated origin."
    },
    "attribution": {
      "$ref": "#/$defs/Attribution",
      "description": "One source record and its provenance."
    },
    "citations": {
      "description": "Source publications.",
      "items": {
        "$ref": "#/$defs/Pmid"
      },
      "type": "array"
    },
    "classification": {
      "$ref": "#/$defs/Term",
      "description": "Whole source classification label."
    },
    "condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Concept"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source disease or tumor context."
    },
    "criteria": {
      "description": "Source criterion labels in source order.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "type": "array"
    },
    "direction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Direction"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source-stated assessment direction."
    },
    "gene_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeneRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source gene context."
    },
    "predicate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Predicate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source-stated relationship."
    },
    "proposition": {
      "$ref": "#/$defs/Proposition",
      "description": "Claim domain."
    },
    "strength": {
      "anyOf": [
        {
          "$ref": "#/$defs/Term"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source evidence level or review status."
    },
    "subject": {
      "$ref": "#/$defs/VariantRef",
      "description": "Source-owned subject reference."
    },
    "therapies": {
      "description": "Source therapies in their native order.",
      "items": {
        "$ref": "#/$defs/Concept"
      },
      "type": "array"
    }
  },
  "required": [
    "subject",
    "proposition",
    "classification",
    "attribution"
  ],
  "title": "Statement",
  "type": "object"
}
