{
  "$defs": {
    "Reply_AcmgAmp2015Code": {
      "description": "Checked AcmgAmp2015 codes.",
      "enum": [
        "pathogenic",
        "likely_pathogenic",
        "uncertain_significance",
        "likely_benign",
        "benign"
      ],
      "type": "string"
    },
    "Reply_AmpAscoCap2017LevelCode": {
      "description": "Checked AmpAscoCap2017Level codes.",
      "enum": [
        "level_a",
        "level_b",
        "level_c",
        "level_d"
      ],
      "type": "string"
    },
    "Reply_AmpAscoCap2017TierCode": {
      "description": "Checked AmpAscoCap2017Tier codes.",
      "enum": [
        "tier_i",
        "tier_ii",
        "tier_iii",
        "tier_iv"
      ],
      "type": "string"
    },
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_CivicEvidenceLevelCode": {
      "description": "Source-defined CIViC evidence levels.",
      "enum": [
        "a",
        "b",
        "c",
        "d",
        "e"
      ],
      "type": "string"
    },
    "Reply_ClingenCgcVicc2022Code": {
      "description": "Checked ClingenCgcVicc2022 codes.",
      "enum": [
        "oncogenic",
        "likely_oncogenic",
        "uncertain_significance",
        "likely_benign",
        "benign"
      ],
      "type": "string"
    },
    "Reply_ClingenLowPenetrance2024Code": {
      "description": "Checked ClingenLowPenetrance2024 codes.",
      "enum": [
        "pathogenic_low_penetrance",
        "likely_pathogenic_low_penetrance",
        "established_risk_allele",
        "likely_risk_allele",
        "uncertain_risk_allele"
      ],
      "type": "string"
    },
    "Reply_ClinvarAlleleOriginCode": {
      "description": "Checked ClinVar allele origin codes.",
      "enum": [
        "germline",
        "somatic",
        "de_novo",
        "inherited",
        "maternal",
        "paternal",
        "biparental",
        "uniparental",
        "not_provided",
        "unknown"
      ],
      "type": "string"
    },
    "Reply_ClinvarReviewStatusCode": {
      "description": "Checked ClinVar review status codes.",
      "enum": [
        "practice_guideline",
        "expert_panel",
        "criteria_provided_multiple_submitters_no_conflicts",
        "criteria_provided_conflicting_classifications",
        "criteria_provided_multiple_submitters",
        "criteria_provided_single_submitter",
        "no_assertion_criteria_provided",
        "no_classification_provided",
        "no_classification_for_the_individual_variant"
      ],
      "type": "string"
    },
    "Reply_Coding": {
      "description": "A code in one explicitly named source framework.",
      "oneOf": [
        {
          "description": "ClinVar publisher review status.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClinvarReviewStatusCode"
            },
            "system": {
              "const": "clinvar_review_status",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "ClinVar publisher allele origin.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClinvarAlleleOriginCode"
            },
            "system": {
              "const": "clinvar_allele_origin",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "OncoKB oncogenicity vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_OncokbOncogenicityCode"
            },
            "system": {
              "const": "oncokb_oncogenicity",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "OncoKB evidence levels.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_OncokbLevelCode"
            },
            "system": {
              "const": "oncokb_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "CIViC evidence level.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_CivicEvidenceLevelCode"
            },
            "system": {
              "const": "civic_evidence_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "acmg_amp_2015 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_AcmgAmp2015Code"
            },
            "system": {
              "const": "acmg_amp_2015",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "clingen_low_penetrance_2024 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClingenLowPenetrance2024Code"
            },
            "system": {
              "const": "clingen_low_penetrance_2024",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "amp_asco_cap_2017_tier vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_AmpAscoCap2017TierCode"
            },
            "system": {
              "const": "amp_asco_cap_2017_tier",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "amp_asco_cap_2017_level vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_AmpAscoCap2017LevelCode"
            },
            "system": {
              "const": "amp_asco_cap_2017_level",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        },
        {
          "description": "clingen_cgc_vicc_2022 vocabulary.",
          "properties": {
            "code": {
              "$ref": "#/$defs/Reply_ClingenCgcVicc2022Code"
            },
            "system": {
              "const": "clingen_cgc_vicc_2022",
              "type": "string"
            }
          },
          "required": [
            "system",
            "code"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_Concept": {
      "description": "One source concept with its optional ontology identifier.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated concept identifier."
        },
        "label": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original concept label."
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Reply_Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^:/\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f][^:\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "Reply_Direction": {
      "description": "Assessment direction stated by the source.",
      "type": "string",
      "x-extensible-enum": [
        "supports",
        "disputes",
        "neutral"
      ]
    },
    "Reply_EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?$",
      "type": "string"
    },
    "Reply_GeneRef": {
      "description": "A source-stated gene reference; its label never implies an identifier.",
      "properties": {
        "ensembl_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hgnc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_HgncId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Reply_Text"
        },
        "ncbi_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_NcbiGeneId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Reply_HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_HgvsText": {
      "description": "Reference-qualified notation with its original text, without a molecular parse.",
      "pattern": "^(?!(?:[NX]P_[0-9]{6}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|[NX]P_(?!000)[0-9]{9}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENSP[0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))p0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))(?:\\([^)]*\\))?:[gcnrmo]\\.)(?![^:()]+\\((?:[NX]P_[0-9]{6}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|[NX]P_(?!000)[0-9]{9}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENSP[0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))p0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))\\):[gcnrmo]\\.)(?:(?:N[CGMPRTW]|X[MPR])_(?:[0-9]{6}|(?!000)[0-9]{9})\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENS[GTP][0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))(?:[tp]0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))?)(?:\\((?:(?:(?:N[CGMPRTW]|X[MPR])_(?:[0-9]{6}|(?!000)[0-9]{9})\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|ENS[GTP][0-9]{11}\\.(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})|LRG_0*(?:0|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))(?:[tp]0*(?:0|(?:65535|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4][0-9]{0})))?)|[A-Za-z][A-Za-z0-9._/@-]{0,254})\\))?:(?:[gcnrpmo]\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*|[pr]\\.(?:\\?|\\(\\?\\)|=|\\(=\\))|r\\.(?:spl\\??|\\(spl\\?\\)))$",
      "type": "string"
    },
    "Reply_NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_OncokbLevelCode": {
      "description": "Source-defined OncoKB vocabulary.",
      "enum": [
        "level_1",
        "level_2",
        "level_3a",
        "level_3b",
        "level_4",
        "level_r1",
        "level_r2",
        "level_dx1",
        "level_dx2",
        "level_dx3",
        "level_px1",
        "level_px2",
        "level_px3"
      ],
      "type": "string"
    },
    "Reply_OncokbOncogenicityCode": {
      "description": "Source-defined OncoKB vocabulary.",
      "enum": [
        "oncogenic",
        "likely_oncogenic",
        "likely_neutral",
        "inconclusive",
        "resistance",
        "unknown"
      ],
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "Reply_Predicate": {
      "description": "VA-Spec 1.1 proposition relationships in native snake_case.",
      "type": "string",
      "x-extensible-enum": [
        "is_causal_for",
        "is_oncogenic_for",
        "has_clinical_significance_for",
        "predicts_sensitivity_to",
        "predicts_resistance_to",
        "is_diagnostic_inclusion_criterion_for",
        "is_diagnostic_exclusion_criterion_for",
        "associated_with_better_outcome_for",
        "associated_with_worse_outcome_for",
        "impacts_function_of"
      ]
    },
    "Reply_ProfileExpression": {
      "description": "Exact source text together with its parsed Boolean tree.",
      "properties": {
        "source": {
          "$ref": "#/$defs/Reply_Text"
        },
        "tree": {
          "$ref": "#/$defs/Reply_ProfileNode"
        }
      },
      "required": [
        "source",
        "tree"
      ],
      "type": "object"
    },
    "Reply_ProfileNode": {
      "description": "Source-stated Boolean relations. No node implies same-allele phase.",
      "oneOf": [
        {
          "description": "One source-native variant reference.",
          "properties": {
            "operator": {
              "const": "member",
              "type": "string"
            },
            "record": {
              "$ref": "#/$defs/Reply_Curie",
              "description": "Source-native variant identifier."
            }
          },
          "required": [
            "operator",
            "record"
          ],
          "type": "object"
        },
        {
          "description": "Every operand is required by the source expression.",
          "properties": {
            "operands": {
              "description": "Source operands in expression order.",
              "items": {
                "$ref": "#/$defs/Reply_ProfileNode"
              },
              "type": "array"
            },
            "operator": {
              "const": "and",
              "type": "string"
            }
          },
          "required": [
            "operator",
            "operands"
          ],
          "type": "object"
        },
        {
          "description": "Alternatives in the source expression.",
          "properties": {
            "operands": {
              "description": "Source alternatives in expression order.",
              "items": {
                "$ref": "#/$defs/Reply_ProfileNode"
              },
              "type": "array"
            },
            "operator": {
              "const": "or",
              "type": "string"
            }
          },
          "required": [
            "operator",
            "operands"
          ],
          "type": "object"
        },
        {
          "description": "Source negation of one member.",
          "properties": {
            "operand": {
              "$ref": "#/$defs/Reply_ProfileNode",
              "description": "Negated source member."
            },
            "operator": {
              "const": "not",
              "type": "string"
            }
          },
          "required": [
            "operator",
            "operand"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_Proposition": {
      "description": "Domain of a source claim.",
      "type": "string",
      "x-extensible-enum": [
        "pathogenicity",
        "oncogenicity",
        "clinical_significance",
        "therapeutic_response",
        "diagnostic",
        "prognostic",
        "functional_impact"
      ]
    },
    "Reply_Term": {
      "description": "A source label with explicitly supported codings in source order.",
      "properties": {
        "codings": {
          "description": "Documented framework codings.",
          "items": {
            "$ref": "#/$defs/Reply_Coding"
          },
          "type": "array"
        },
        "label": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original label."
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
