{
  "$defs": {
    "Capped": {
      "additionalProperties": false,
      "description": "A bounded list with the total before its cap was applied.",
      "properties": {
        "items": {
          "description": "References in stable source order.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        },
        "total": {
          "description": "Distinct references before capping.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total"
      ],
      "type": "object"
    },
    "NctId": {
      "description": "Canonical ClinicalTrials.gov identifier.",
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "TrialPhase": {
      "description": "Source-native registry value.",
      "enum": [
        "EARLY_PHASE1",
        "PHASE1",
        "PHASE2",
        "PHASE3",
        "PHASE4",
        "NA"
      ],
      "type": "string"
    },
    "TrialStatus": {
      "description": "Publisher Status enum for OverallStatus from\n<https://clinicaltrials.gov/api/v2/studies/enums>.",
      "enum": [
        "ACTIVE_NOT_RECRUITING",
        "COMPLETED",
        "ENROLLING_BY_INVITATION",
        "NOT_YET_RECRUITING",
        "RECRUITING",
        "SUSPENDED",
        "TERMINATED",
        "WITHDRAWN",
        "AVAILABLE",
        "NO_LONGER_AVAILABLE",
        "TEMPORARILY_NOT_AVAILABLE",
        "APPROVED_FOR_MARKETING",
        "WITHHELD",
        "UNKNOWN"
      ],
      "type": "string"
    }
  },
  "$id": "biodata.trial_header/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Small source-attributed trial discovery record.",
  "properties": {
    "conditions": {
      "$ref": "#/$defs/Capped",
      "description": "Source condition names."
    },
    "interventions": {
      "$ref": "#/$defs/Capped",
      "description": "Source intervention names."
    },
    "nct_id": {
      "$ref": "#/$defs/NctId",
      "description": "Exact registry identity."
    },
    "phases": {
      "description": "Source phases; absent phases remain absent.",
      "items": {
        "$ref": "#/$defs/TrialPhase"
      },
      "type": "array"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrialStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "Registry overall status, absent when missing or rejected; independent of site status."
    },
    "title": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source brief title, absent when missing or rejected."
    },
    "updated": {
      "anyOf": [
        {
          "$ref": "#/$defs/PartialDate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Last posted registry update, absent when missing or rejected."
    },
    "url": {
      "$ref": "#/$defs/Text",
      "description": "Publisher's canonical record URL.",
      "format": "uri"
    }
  },
  "required": [
    "nct_id",
    "conditions",
    "interventions",
    "url"
  ],
  "title": "TrialHeader",
  "type": "object"
}
