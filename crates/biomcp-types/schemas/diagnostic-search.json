{
  "$defs": {
    "DiagnosticDeviceId": {
      "pattern": "^(P[0-9]{6}(/S(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}))?|K[0-9]{6}|DEN[0-9]{6}|H[0-9]{6})$",
      "type": "string"
    },
    "DiagnosticSearchSource": {
      "description": "One explicit diagnostic discovery source.",
      "enum": [
        "gtr",
        "fda-cdx"
      ],
      "type": "string"
    },
    "FdaDrugApplication": {
      "pattern": "^(NDA|BLA)[0-9]{6}$",
      "type": "string"
    },
    "GeneSymbol": {
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "GtrTestType": {
      "description": "Native GTR relation test category, not an offering or authorization judgment.",
      "enum": [
        "Clinical",
        "Research",
        "Clinical microbial"
      ],
      "type": "string"
    },
    "NcbiGeneId": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biomcp.diagnostic-search/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Checked selected-source diagnostic discovery; no identity resolution or I/O.",
  "properties": {
    "biomarker": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact table-0 biomarker cell; unsupported in the group table."
    },
    "bundle_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Immutable stored bundle revision retained by a continuation."
    },
    "condition_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact MedGen:CUI identifier only."
    },
    "device_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticDeviceId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact PMA application or application/supplement identity."
    },
    "drug_application": {
      "anyOf": [
        {
          "$ref": "#/$defs/FdaDrugApplication"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cell-owned typed NDA/BLA application."
    },
    "gene": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeneSymbol"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact source gene_symbol field, without alias expansion."
    },
    "gene_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/NcbiGeneId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact source GeneID, exclusive with gene symbol."
    },
    "limit": {
      "default": 5,
      "description": "Maximum native rows on this page.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Zero-based native row offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/DiagnosticSearchSource",
      "description": "Required explicit GTR or FDA companion-table source."
    },
    "type": {
      "anyOf": [
        {
          "$ref": "#/$defs/GtrTestType"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact native test_type value."
    }
  },
  "required": [
    "source"
  ],
  "title": "DiagnosticSearch",
  "type": "object"
}
