{
  "$defs": {
    "Reply_CacheProblem": {
      "description": "A local cache or recording failure, independent of what the provider returned.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version",
        "recording-conflict",
        "recording-io",
        "recording-missing",
        "recording-exhausted",
        "recording-malformed",
        "recording-limit",
        "recording-non-utf8"
      ],
      "type": "string"
    },
    "Reply_Grant": {
      "description": "One NIH award, or one component of a multi-part award, for one fiscal year.",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "NIH activity code, such as R01, R35 or P50."
        },
        "award_amount": {
          "description": "This fiscal year's total cost in US dollars, direct plus indirect, as RePORTER states it.\nA parent row's amount already includes its components' amounts.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "core_project": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Core project number shared by every year of the project, such as P50CA265826."
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Project end date."
        },
        "fiscal_year": {
          "description": "NIH fiscal year of this award.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "institute": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_GrantInstitute"
            },
            {
              "type": "null"
            }
          ],
          "description": "Administering NIH institute or center."
        },
        "investigators": {
          "description": "Principal investigators as RePORTER names them.",
          "items": {
            "$ref": "#/$defs/Reply_GrantInvestigator"
          },
          "type": "array"
        },
        "organization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_GrantOrganization"
            },
            {
              "type": "null"
            }
          ],
          "description": "Funded organization."
        },
        "project": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Full NIH project number for this year, such as 5P50CA265826-04; a parent and its\ncomponents share it."
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Project start date."
        },
        "subproject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Component ID within a multi-part award; absent on the parent and on single awards."
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Project title."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "RePORTER project details page."
        }
      },
      "required": [
        "project",
        "fiscal_year"
      ],
      "type": "object"
    },
    "Reply_GrantInstitute": {
      "description": "An NIH institute or center.",
      "properties": {
        "abbreviation": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Abbreviation, such as NCI."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Full name."
        }
      },
      "required": [
        "abbreviation"
      ],
      "type": "object"
    },
    "Reply_GrantInvestigator": {
      "description": "A principal investigator on an award row.",
      "properties": {
        "contact": {
          "description": "The contact principal investigator.",
          "type": "boolean"
        },
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Name as RePORTER gives it."
        },
        "profile_id": {
          "description": "RePORTER person profile ID.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Reply_GrantOrganization": {
      "description": "A funded organization as RePORTER spells it.",
      "properties": {
        "city": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "City."
        },
        "country": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Country."
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Organization name."
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "State."
        }
      },
      "type": "object"
    },
    "Reply_GrantPage": {
      "description": "NIH RePORTER award rows in RePORTER's order: one per award and fiscal year, plus one per component of a multi-part award. `page.total` counts these rows, not distinct projects.",
      "properties": {
        "hint": {
          "description": "How to read the rows: what the total counts, how to add amounts and how names match.",
          "type": "string"
        },
        "items": {
          "description": "Award rows on this page.",
          "items": {
            "$ref": "#/$defs/Reply_Grant"
          },
          "type": "array"
        }
      },
      "required": [
        "hint"
      ],
      "type": "object"
    },
    "Reply_GrantSearch": {
      "description": "Search NIH-funded research projects in NIH RePORTER by topic, investigator, organization and fiscal year. Each row is one award for one fiscal year: a project funded for five years gives five rows, and a multi-part award gives a parent row plus one row per component (`subproject`). An investigator name matches any investigator with each word anywhere in their name; check `investigators[].profile_id` and search again with investigator_id (--investigator-id on the command line).",
      "properties": {
        "fiscal_year": {
          "description": "One NIH fiscal year, such as 2025; all years by default.",
          "format": "uint32",
          "maximum": 2100,
          "minimum": 1985,
          "type": "integer"
        },
        "investigator": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Principal investigator name, such as \"Pasi Janne\". Each word matches any part of any investigator's name, so common names find other people; check the profile IDs."
        },
        "investigator_id": {
          "description": "RePORTER investigator profile ID from `investigators[].profile_id`, such as 1861387.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "limit": {
          "default": 10,
          "description": "Ten award rows by default, one to fifty.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Award rows to skip in RePORTER's order; RePORTER pages at most 15,000 deep.",
          "format": "uint32",
          "maximum": 14999,
          "minimum": 0,
          "type": "integer"
        },
        "organization": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Funded organization name or part of it, as RePORTER spells it, such as \"DANA-FARBER\"."
        },
        "query": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Words that must all appear in the project title, abstract or terms, such as \"KRAS G12C\".",
          "x-positional": 0
        }
      },
      "type": "object"
    },
    "Reply_Incomplete": {
      "description": "One thing a `partial` reply is missing, pointing at the detail already in the reply.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Reply_Text",
          "description": "JSON pointer into this reply, such as `/sources/1` or a record's field."
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why, when a typed reason is known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source whose data is missing."
        }
      },
      "required": [
        "at",
        "source"
      ],
      "type": "object"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matches: the source's own count when one source states more than the snapshot holds, otherwise the identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known. A `record.declined` problem has none, so\nit names the record by a source key, such as `event_id:100178`."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records.",
        " A source record without a usable identity was left off the page; each problem names one such record.",
        " The asked filter cannot read the records the field names, so they were not searched and may hold matches the page leaves out."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict",
        "record.declined",
        "filter.unsupported"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source.",
        " The source document was read but does not state the value."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id",
        "not-stated"
      ]
    },
