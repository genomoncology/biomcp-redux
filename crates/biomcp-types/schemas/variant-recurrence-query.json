{
  "$defs": {
    "GeneSymbol": {
      "description": "Source spelling of a gene symbol, with ASCII case-insensitive identity.",
      "pattern": "^[A-Za-z][A-Za-z0-9._/@-]{0,254}$",
      "type": "string"
    },
    "RecurrenceSource": {
      "description": "Source requiring explicit study, profile and sample set.",
      "enum": [
        "cbioportal"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "VariantInput": {
      "description": "A validated canonical VariantInput string.",
      "pattern": "(^(rs[1-9][0-9]*|CA[0-9]{6,}|PA[1-9][0-9]*|VCV[0-9]{9}(\\.[1-9][0-9]*)?|clinvar:[1-9][0-9]*|COS[VMN][1-9][0-9]*|ga4gh:VA\\.[A-Za-z0-9_-]{32})$|^(?!(?:[^:(]*\\()?([NX]P_([0-9]{6}|[0-9]{9})\\.[1-9][0-9]*|ENSP[0-9]{11}\\.[1-9][0-9]*|LRG_[0-9]+p[0-9]+)(?:\\([^:]*\\)|\\))?:[gcnrmo]\\.)((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?)(\\(([A-Za-z][A-Za-z0-9._/@-]*|[A-Za-z0-9_.]+)\\))?:([gcnrpmo]\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*|[pr]\\.(\\?|\\(\\?\\)|=|\\(=\\))|r\\.(spl\\??|\\(spl\\?\\)))$|^[1-9][0-9]*$|^chr([1-9][0-9]*|X|Y|M|MT):g\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*$)",
      "type": "string"
    }
  },
  "$id": "biodata.variant-recurrence-query/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Observe exact-allele samples within one caller-selected source page.",
  "properties": {
    "gene": {
      "$ref": "#/$defs/GeneSymbol",
      "description": "HGNC symbol resolved to the source's Entrez gene identifier."
    },
    "input": {
      "$ref": "#/$defs/VariantInput",
      "description": "Published variant identity; ambiguous identities are never selected silently.",
      "x-positional": 0
    },
    "limit": {
      "default": 10,
      "description": "Source mutation rows per page, including excluded alleles.",
      "format": "uint32",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "page": {
      "default": 0,
      "description": "Zero-based native source page.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "profile": {
      "$ref": "#/$defs/Text",
      "description": "Explicit mutation molecular profile."
    },
    "sample_set": {
      "$ref": "#/$defs/Text",
      "description": "Explicit sample list; selected size is never an allele denominator."
    },
    "source": {
      "$ref": "#/$defs/RecurrenceSource",
      "description": "Explicit cohort source."
    },
    "study": {
      "$ref": "#/$defs/Text",
      "description": "Explicit study; there is no default cohort."
    }
  },
  "required": [
    "input",
    "source",
    "gene",
    "study",
    "profile",
    "sample_set"
  ],
  "title": "VariantRecurrenceQuery",
  "type": "object"
}
