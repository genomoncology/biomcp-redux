{
  "$defs": {
    "AuthorCountScope": {
      "description": "Scope of source-reported bibliographic counts.",
      "enum": [
        "provider_record"
      ],
      "type": "string"
    },
    "AuthorCounts": {
      "additionalProperties": false,
      "description": "Counts describe only this provider record, never a global publication corpus.",
      "properties": {
        "citation_count": {
          "description": "Native citations to this record’s indexed papers.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "h_index": {
          "description": "Native h-index for this record’s indexed papers.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "paper_count": {
          "description": "Native indexed paper count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/AuthorCountScope",
          "description": "Counts apply only to this provider record."
        }
      },
      "required": [
        "scope"
      ],
      "type": "object"
    },
    "AuthorHeader": {
      "additionalProperties": false,
      "description": "One source candidate; absent affiliations differ from an empty source collection.",
      "properties": {
        "affiliations": {
          "description": "Native affiliation labels; no employment claim.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "counts": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorCounts"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record counts when supplied."
        },
        "id": {
          "$ref": "#/$defs/AuthorId",
          "description": "Exact qualified provider record."
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Source display name, never a join key."
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "AuthorId": {
      "pattern": "^((semantic-scholar|semanticscholar):[1-9][0-9]*|orcid:[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])$",
      "type": "string"
    },
    "AuthorPage": {
      "additionalProperties": false,
      "description": "Native author candidates in provider order; search total counts only this query.",
      "properties": {
        "items": {
          "description": "Source candidates; no deduplication by display name.",
          "items": {
            "$ref": "#/$defs/AuthorHeader"
          },
          "type": "array"
        },
        "matching_records": {
          "description": "Native matching-record total, if supplied.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "AuthorSearch": {
      "additionalProperties": false,
      "description": "Literal author name query and native window; positional text maps to query.",
      "properties": {
        "limit": {
          "default": 5,
          "description": "Bounded source page size.",
          "format": "uint32",
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Native offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Retained page identity."
        },
        "query": {
          "description": "Literal query from the positional argument or --query.",
          "minLength": 1,
          "type": "string",
          "x-positional": 0
        },
        "source": {
          "$ref": "#/$defs/AuthorSearchSource",
          "default": "semantic-scholar",
          "description": "Native author source."
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "AuthorSearchSource": {
      "description": "Author search supports one provider and its legacy spelling.",
      "enum": [
        "semantic-scholar",
        "semanticscholar"
      ],
      "type": "string"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "enum": [
        "hgnc",
        "mygene",
        "reactome",
        "wikipathways",
        "hpa",
        "uniprot",
        "interpro",
        "complex-portal",
        "gnomad",
        "clinvar",
        "erepo",
        "gwas",
        "clingen",
        "pubmed",
        "europepmc",
        "litvar",
        "litsense",
        "semantic-scholar",
        "orcid",
        "pmc-oa",
        "icite",
        "pubtator",
        "ctgov",
        "nci",
        "civic",
        "hotspots",
        "oncokb",
        "myvariant",
        "car",
        "mutalyzer",
        "variantvalidator",
        "mychem",
        "chembl",
        "opentargets",
        "openfda-label",
        "drugsfda",
        "ema",
        "who-pq",
        "ddinter",
        "drugbank-open",
        "drugcentral",
        "gtopdb",
        "unii",
        "ndc",
        "openfda-xref",
        "ols",
        "mydisease",
        "monarch",
        "seer",
        "mondo",
        "doid",
        "ncit",
        "hpo",
        "orphanet",
        "omim",
        "faers",
        "vaers",
        "maude",
        "meddra",
        "gmdn",
        "gtr",
        "who-ivd",
        "fda-cdx",
        "fda-pma",
        "fda-510k",
        "cpic",
        "clinpgx",
        "cbioportal",
        "cellosaurus"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " HGNC.",
        " MyGene.info.",
        " Reactome.",
        " WikiPathways published pathway catalogs.",
        " Human Protein Atlas.",
        " UniProt.",
        " Integrated InterPro entries.",
        " Complex Portal.",
        " gnomAD.",
        " ClinVar component source policy.",
        " ClinGen Evidence Repository.",
        " GWAS Catalog v2.",
        " ClinGen.",
        " PubMed.",
        " Europe PMC.",
        " NCBI LitVar2.",
        " NCBI LitSense2.",
        " Semantic Scholar.",
        " ORCID public registry.",
        " PMC Open Access bucket.",
        " NIH iCite.",
        " PubTator.",
        " ClinicalTrials.gov.",
        " NCI Clinical Trials Search.",
        " CIViC.",
        " Cancer Hotspots residue recurrence.",
        " OncoKB.",
        " MyVariant.info aggregation.",
        " ClinGen Allele Registry.",
        " Mutalyzer.",
        " VariantValidator.",
        " MyChem.info aggregation.",
        " ChEMBL native records and carried component.",
        " Open Targets.",
        " openFDA SPL labels.",
