{
  "$defs": {
    "ArticleInput": {
      "description": "A validated canonical ArticleInput string.",
      "pattern": "(^(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$|(?=PPR)^(?=.{1,64}$)[A-Z]{1,8}[0-9]*[1-9][0-9]*$|^(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$)",
      "type": "string"
    },
    "ArticleSaved": {
      "description": "Explicit saved article file, owned by the caller.",
      "properties": {
        "bytes": {
          "description": "Exact byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parts": {
          "description": "Number of ordered text parts; absent for original supplement bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/Text",
          "description": "Absolute caller destination."
        },
        "sha256": {
          "$ref": "#/$defs/Text",
          "description": "SHA-256 of the saved bytes."
        },
        "url": {
          "$ref": "#/$defs/Text",
          "description": "Source URL for the original material.",
          "format": "uri"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "url"
      ],
      "type": "object"
    },
    "ArticleText": {
      "anyOf": [
        {
          "required": [
            "part"
          ]
        },
        {
          "required": [
            "find"
          ]
        },
        {
          "required": [
            "variant"
          ]
        },
        {
          "required": [
            "save"
          ]
        }
      ],
      "description": "Read one bounded body part, find matching rows, or save the complete Markdown document.",
      "properties": {
        "find": {
          "$ref": "#/$defs/Text",
          "description": "Case-insensitive literal text to find."
        },
        "input": {
          "$ref": "#/$defs/ArticleInput",
          "description": "PubMed or PMC identity. DOI selectors are not accepted by the reader.",
          "x-positional": 0
        },
        "offset": {
          "default": 0,
          "description": "Number of matching rows already returned.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "part": {
          "description": "One-based outline part number.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "replace": {
          "description": "Replace an existing destination only when explicitly requested with save.",
          "type": "boolean"
        },
        "save": {
          "$ref": "#/$defs/Text",
          "description": "Save the whole original document to an explicit file or existing folder."
        },
        "variant": {
          "$ref": "#/$defs/Text",
          "description": "Explicit checked protein substitution."
        }
      },
      "required": [
        "input"
      ],
      "type": "object"
    },
    "ArticleTextResult": {
      "description": "Body text response; the envelope supplies advancing reader steps.",
      "properties": {
        "content": {
          "$ref": "#/$defs/Section",
          "description": "Explicit section outcome including not applicable and not open."
        },
        "pmcid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pmcid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested PMC record when known."
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    },
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "License": {
      "description": "License reported by the bucket metadata record.",
      "type": "string",
      "x-enum-descriptions": [
        " Creative Commons Attribution.",
        " Creative Commons Attribution NonCommercial.",
        " Creative Commons Attribution ShareAlike.",
        " Creative Commons Attribution NonCommercial ShareAlike.",
        " Creative Commons Attribution NoDerivatives.",
        " Creative Commons Attribution NonCommercial NoDerivatives.",
        " Creative Commons public-domain dedication.",
        " Public domain.",
        " Text and data mining manuscript terms.",
        " The bucket reports another license."
      ],
      "x-extensible-enum": [
        "cc_by",
        "cc_by_nc",
        "cc_by_sa",
        "cc_by_nc_sa",
        "cc_by_nd",
        "cc_by_nc_nd",
        "cc0",
        "public_domain",
        "tdm",
        "other"
      ]
    },
    "Markdown": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "format": "markdown",
      "minLength": 1,
      "type": "string"
    },
    "PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Pmcid": {
      "description": "Canonical PMC identifier, with an explicit namespace.",
      "pattern": "^PMC(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})$",
      "type": "string"
    },
    "PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "local_quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ]
    },
    "Section": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/TextContent",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
