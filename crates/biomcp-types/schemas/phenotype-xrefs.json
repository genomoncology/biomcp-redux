    "Reply_SourceNotice": {
      "description": "A source notice or request recovery step.",
      "oneOf": [
        {
          "description": "Source-stated spellings actually searched.",
          "properties": {
            "input": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Whole caller-supplied name."
            },
            "kind": {
              "const": "drug-name-search",
              "type": "string"
            },
            "message": {
              "description": "Why the names were expanded or retained.",
              "type": "string"
            },
            "names": {
              "description": "Names actually searched; ambiguous identities retain the typed name only.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "input",
            "names",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Variant spellings and registry fields actually searched.",
          "properties": {
            "codon": {
              "description": "Codon forms searched, which match trials written for any change at that position.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            },
            "input": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Whole caller-supplied variant or criteria text."
            },
            "kind": {
              "const": "variant-search",
              "type": "string"
            },
            "message": {
              "description": "What was searched, where, and how to search the typed text only.",
              "type": "string"
            },
            "spellings": {
              "description": "Spellings of the same change actually searched, including the typed text.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "input",
            "spellings",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Local request limits, source observations and recovery guidance.",
          "properties": {
            "data_date": {
              "description": "Retained publisher dataset date, independent of acquisition and record events.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "request-guidance",
              "type": "string"
            },
            "message": {
              "description": "Reviewed guidance; any quoted provider wording remains source data.",
              "type": "string"
            },
            "retry_after_seconds": {
              "description": "Seconds left before another source request may be admitted.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Registered conditions lack the literal words requested in a condition search.",
          "properties": {
            "kind": {
              "const": "condition-word-mismatch",
              "type": "string"
            },
            "message": {
              "description": "The source searches several fields and can expand terms; no expansion cause is inferred.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "A checked provider answer survived a local cache failure.",
          "properties": {
            "kind": {
              "const": "cache-problem",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/Reply_CacheProblem",
              "description": "Bounded local failure without paths or database diagnostics."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Reply_Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph-truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "description": "An empty LitVar lookup can be repeated with a caller-supplied rsID.",
          "properties": {
            "kind": {
              "const": "litvar-rsid-hint",
              "type": "string"
            },
            "message": {
              "description": "Guidance that never supplies or infers an rsID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "PubMed supplied a named ESearch warning without changing its phrases.",
          "properties": {
            "kind": {
              "const": "pubmed-warning",
              "type": "string"
            },
            "name": {
              "description": "Original provider warning name, including names added by PubMed later.",
              "type": "string"
            },
            "phrases": {
              "description": "Original provider phrases, preserving whitespace and quotes.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not-found-words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Reply_Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Reply_SourceOutcome": {
      "description": "One source's outcome with source notices and request guidance.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Source notices and request recovery guidance.",
          "items": {
            "$ref": "#/$defs/Reply_SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "retrieved_count": {
          "description": "Number of retrieved identities.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/Reply_SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "use": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Reviewed source use category; publisher terms remain authoritative: see `help sources`."
        }
      },
      "required": [
        "source",
        "use",
        "state"
      ],
      "type": "object"
    },
    "Reply_SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Reply_Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Reply_Step": {
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/Reply_StepKind",
          "description": "Purpose of the action."
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Options this call also takes, each with a placeholder to fill in, such as\n`\"--decision-from\": \"<YYYY-MM-DD>\"`; add any of them to `args`. MCP names them as tool\narguments. Absent when the step is only runnable as it is.",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Reply_StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Reply_Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    },
    "Reply_Use": {
      "description": "Reviewed source-use category, without inferring rights in individual records.",
      "enum": [
        "open",
        "attribution",
        "noncommercial",
        "licensed",
        "per-record"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.phenotype-xrefs/5",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One versioned command response; schema identity comes only from its body type.\nJSON readers ignore unknown fields and unknown growable enum values within a major.",
  "properties": {
    "absent": {
      "description": "IDs a get of several did not find while it found others; each item says so too.",
      "items": {
        "$ref": "#/$defs/Reply_Text"
      },
      "type": "array"
    },
    "fields": {
      "description": "The row fields the caller chose with `--fields`, as given; absent without them.\nEach row keeps those, its required keys and identifiers; other keys are left out.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "incomplete": {
      "description": "What a `partial` reply is missing; present only on `partial` replies.",
      "items": {
        "$ref": "#/$defs/Reply_Incomplete"
      },
      "type": "array"
    },
    "local_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_CacheProblem"
        },
        {
          "type": "null"
        }
      ],
      "description": "Bounded local cache or recording failure, independent of provider outcomes."
    },
    "next": {
      "description": "Available next commands.",
      "items": {
        "$ref": "#/$defs/Reply_Step"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Search page metadata. With zero results, `total` and `returned` are 0 and the result leaves out `items`, because replies omit empty lists."
    },
    "problems": {
      "description": "Rejected source fields.",
      "items": {
        "$ref": "#/$defs/Reply_Problem"
      },
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/Reply_PhenotypeGet",
      "description": "Parsed query."
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_PhenotypeXrefs"
        },
        {
          "type": "null"
        }
      ],
      "description": "Answer when available."
    },
    "schema": {
      "const": "biomcp.phenotype-xrefs/5",
      "type": "string"
    },
    "sources": {
      "description": "Sources actually asked.",
      "items": {
        "$ref": "#/$defs/Reply_SourceOutcome"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Reply_Status",
      "description": "Overall outcome."
    }
  },
  "required": [
    "schema",
    "status",
    "query"
  ],
  "title": "Envelope",
  "type": "object"
}
