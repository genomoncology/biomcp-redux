{
  "$defs": {
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "approved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source approval date."
        },
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "published": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source publication date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_CacheProblem": {
      "description": "A local cache or recording failure, independent of what the provider returned.",
      "enum": [
        "busy",
        "database",
        "encoding",
        "filesystem",
        "internal",
        "limit",
        "snapshot",
        "version",
        "recording-conflict",
        "recording-io",
        "recording-missing",
        "recording-exhausted",
        "recording-malformed",
        "recording-limit",
        "recording-non-utf8"
      ],
      "type": "string"
    },
    "Reply_ComponentLabel": {
      "description": "Terms attached to a named carried component on a consumer response.",
      "properties": {
        "component": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native component name."
        },
        "terms": {
          "$ref": "#/$defs/Reply_ComponentTerms",
          "description": "Canonical publisher terms."
        }
      },
      "required": [
        "component",
        "terms"
      ],
      "type": "object"
    },
    "Reply_ComponentTerms": {
      "description": "Terms attached to one independently licensed source component.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher terms name."
        },
        "url": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Publisher terms page.",
          "format": "uri"
        },
        "usage": {
          "$ref": "#/$defs/Reply_Use",
          "description": "Publisher use category."
        }
      },
      "required": [
        "usage",
        "name",
        "url"
      ],
      "type": "object"
    },
    "Reply_Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^:/\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f][^:\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]*$",
      "type": "string"
    },
    "Reply_HpId": {
      "description": "Exact Human Phenotype Ontology identifier with seven decimal digits.",
      "pattern": "^HP:[0-9]{7}$",
      "type": "string"
    },
    "Reply_Incomplete": {
      "description": "One thing a `partial` reply is missing, pointing at the detail already in the reply.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Reply_Text",
          "description": "JSON pointer into this reply, such as `/sources/1` or a record's field."
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_ProblemCode"
            },
            {
              "type": "null"
            }
          ],
          "description": "The refused record's own problem code, when a problem is the cause."
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why, when a typed source reason is known."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source whose data is missing."
        }
      },
      "required": [
        "at",
        "source"
      ],
      "type": "object"
    },
    "Reply_PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matches: the source's own count when one source states more than the snapshot holds, otherwise the identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "Reply_PhenotypeGet": {
      "description": "Read an exact HP term from HPO or Monarch, or page native source sections. A term lookup answers terminology; an association answers what its publisher asserts. Neither establishes a diagnosis.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_HpId",
          "description": "Exact HP identifier.",
          "x-positional": 0
        },
        "section": {
          "$ref": "#/$defs/Reply_PhenotypeSection",
          "description": "Absent means the source identity card.",
          "x-positional": 1
        },
        "section_limit": {
          "description": "Default five text/link rows, one complete association row or 50 ancestors.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "section_offset": {
          "default": 0,
          "description": "Native section row offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Retained exact source reply for local text and link pages; unsupported for diseases, genes and ancestors."
        },
        "source": {
          "$ref": "#/$defs/Reply_PhenotypeSource",
          "description": "HPO or Monarch for cards, synonyms and xrefs; Monarch only for hierarchy, diseases and genes; OLS only for ancestors. Defaults to HPO for cards, synonyms and xrefs, OLS for ancestors, otherwise Monarch."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Reply_PhenotypeSection": {
      "description": "A named source term section.",
      "enum": [
        "synonyms",
        "xrefs",
        "hierarchy",
        "diseases",
        "genes",
        "ancestors"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Native synonyms.",
        " Native cross references.",
        " Native direct parent and child links.",
        " Native disease association rows.",
        " Native human gene association rows.",
        " Every ancestor term up to the ontology root, from OLS."
      ]
    },
    "Reply_PhenotypeSource": {
      "description": "One independent term publisher.",
      "enum": [
        "hpo",
        "monarch",
        "ols"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Direct HPO term metadata.",
        " Monarch term search and associations.",
        " OLS ancestor lists for HP terms."
      ]
    },
    "Reply_PhenotypeXref": {
      "description": "One exact native cross reference, without equivalence promotion.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Reply_Attribution",
          "description": "Publisher provenance."
        },
        "id": {
          "$ref": "#/$defs/Reply_Curie",
          "description": "Exact publisher reference."
        },
        "predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Curie"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native predicate when actually supplied."
        }
      },
      "required": [
        "id",
        "attribution"
      ],
      "type": "object"
    },
    "Reply_PhenotypeXrefs": {
      "description": "Source reference rows without equivalence promotion.",
      "properties": {
        "components": {
          "description": "Applicable publisher component terms.",
          "items": {
            "$ref": "#/$defs/Reply_ComponentLabel"
          },
          "type": "array"
        },
        "fetched": {
          "description": "Original source retrieval seconds, distinct from ontology release.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "description": "Native ordered rows; empty remains an empty collection.",
          "items": {
            "$ref": "#/$defs/Reply_PhenotypeXref"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Reply_PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Reply_Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Reply_ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known. A `record.declined` problem has none, so\nit names the record by a source key, such as `event_id:100178`."
        },
        "source": {
          "$ref": "#/$defs/Reply_Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "Reply_ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records.",
        " A source record without a usable identity was left off the page; each problem names one such record.",
        " The asked filter cannot read the records the field names, so they were not searched and may hold matches the page leaves out."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict",
        "record.declined",
        "filter.unsupported"
      ]
    },
    "Reply_Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source.",
        " The source document was read but does not state the value."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id",
        "not-stated"
      ]
    },
