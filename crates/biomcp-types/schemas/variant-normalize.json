{
  "$defs": {
    "Build": {
      "description": "The assembly stated by the source; no default is inferred.",
      "enum": [
        "GRCh37",
        "GRCh38"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " Genome Reference Consortium human build 37.",
        " Genome Reference Consortium human build 38."
      ]
    },
    "NormalizationSource": {
      "description": "Explicit normalization service selection.",
      "enum": [
        "car",
        "mutalyzer",
        "variantvalidator",
        "all"
      ],
      "type": "string"
    }
  },
  "$id": "biodata.variant-normalize/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Send unchanged reference-qualified notation to explicitly named services.",
  "properties": {
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/Build"
        },
        {
          "type": "null"
        }
      ],
      "description": "Caller assembly; required when VariantValidator is selected."
    },
    "hgvs": {
      "description": "Reference-qualified HGVS, or chromosome genomic HGVS with an explicit build for CAR.\nChecked for reference and syntax only; no full HGVS parser.",
      "pattern": "(^(?!(?:[^:(]*\\()?([NX]P_([0-9]{6}|[0-9]{9})\\.[1-9][0-9]*|ENSP[0-9]{11}\\.[1-9][0-9]*|LRG_[0-9]+p[0-9]+)(?:\\([^:]*\\)|\\))?:[gcnrmo]\\.)((N[CGMPRTW]|X[MPR])_([0-9]{6}|[0-9]{9})\\.[0-9]+|ENS[GTP][0-9]{11}\\.[0-9]+|LRG_[0-9]+([tp][0-9]+)?)(\\(([A-Za-z][A-Za-z0-9._/@-]*|[A-Za-z0-9_.]+)\\))?:([gcnrpmo]\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*|[pr]\\.(\\?|\\(\\?\\)|=|\\(=\\))|r\\.(spl\\??|\\(spl\\?\\)))$|^chr([1-9][0-9]*|X|Y|M|MT):g\\.[\\x21-\\x7e]*[0-9][\\x21-\\x7e]*$)",
      "type": "string"
    },
    "limit": {
      "default": 10,
      "description": "Source mapping rows per service, with typed continuation for remaining rows.",
      "format": "uint32",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Source mapping rows to skip per service.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/NormalizationSource",
      "description": "Explicit service; all preserves independent results without consensus."
    }
  },
  "required": [
    "source",
    "hgvs"
  ],
  "title": "VariantNormalize",
  "type": "object"
}
