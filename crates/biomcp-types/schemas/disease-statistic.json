{
  "$defs": {
    "Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "FiniteNumber": {
      "description": "A finite decimal that JSON can represent without losing its value to null.",
      "format": "double",
      "type": "number"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "StatisticEstimate": {
      "description": "Source estimate and uncertainty without computed quantities.",
      "properties": {
        "count": {
          "description": "Native count; no inferred denominator.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lower_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native lower confidence bound."
        },
        "standard_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native standard error."
        },
        "upper_ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native upper confidence bound."
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiniteNumber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native estimate."
        }
      },
      "type": "object"
    },
    "StatisticSelector": {
      "description": "One source-native selector without a local interpretation.",
      "properties": {
        "code": {
          "$ref": "#/$defs/Text",
          "description": "Source selector code."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Publisher label when supplied."
        },
        "name": {
          "$ref": "#/$defs/Text",
          "description": "Source field name."
        }
      },
      "required": [
        "name",
        "code"
      ],
      "type": "object"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.disease-statistic/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One native statistics row with requested and returned dimensions.",
  "properties": {
    "attribution": {
      "$ref": "#/$defs/Attribution",
      "description": "Publisher record and dataset version when supplied."
    },
    "measure": {
      "$ref": "#/$defs/Text",
      "description": "Native measure name."
    },
    "modeled": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatisticEstimate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Modeled estimate kept separately."
    },
    "observed": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatisticEstimate"
        },
        {
          "type": "null"
        }
      ],
      "description": "Observed estimate; missing stays absent."
    },
    "requested_selectors": {
      "description": "Settings sent to the publisher.",
      "items": {
        "$ref": "#/$defs/StatisticSelector"
      },
      "type": "array"
    },
    "requested_site": {
      "$ref": "#/$defs/Text",
      "description": "Explicit selected native site ID."
    },
    "returned_selectors": {
      "description": "Settings actually returned, never filled from request.",
      "items": {
        "$ref": "#/$defs/StatisticSelector"
      },
      "type": "array"
    },
    "year": {
      "description": "Native annual row year.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "requested_site",
    "measure",
    "attribution"
  ],
  "title": "DiseaseStatistic",
  "type": "object"
}
