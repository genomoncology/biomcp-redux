{
  "$defs": {
    "ArticleEdgePage": {
      "description": "A page of citing or referenced papers in citation order.",
      "properties": {
        "items": {
          "description": "Papers in the fixed edge pool.",
          "items": {
            "$ref": "#/$defs/ArticleItem"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ArticleEdges": {
      "description": "Page the citing or referenced PubMed papers of one checked PMID.",
      "properties": {
        "limit": {
          "default": 10,
          "description": "Maximum papers on one page.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Number of pool items to skip.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pmid": {
          "$ref": "#/$defs/ArticleInput",
          "description": "PMID, PMC or DOI; iCite accepts only a PMID.",
          "x-positional": 0
        },
        "pool": {
          "$ref": "#/$defs/Text",
          "description": "Fixed snapshot from an earlier page."
        },
        "source": {
          "$ref": "#/$defs/EdgeSource",
          "default": "icite",
          "description": "Graph provider; iCite remains the default."
        }
      },
      "required": [
        "pmid"
      ],
      "type": "object"
    },
    "ArticleHeader": {
      "description": "Citation metadata from PubMed or Europe PMC.",
      "properties": {
        "author_count": {
          "description": "Whole source author count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Publication date at source precision."
        },
        "doi": {
          "anyOf": [
            {
              "$ref": "#/$defs/Doi"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked DOI, when supplied."
        },
        "electronic_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Electronic publication date when different from the publication date."
        },
        "europepmc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EuropePmcId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Europe PMC source-local identity."
        },
        "first_author": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "First author in source order."
        },
        "first_author_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticScholarAuthorId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact Semantic Scholar ID for the displayed native first author, when supplied."
        },
        "journal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Journal name."
        },
        "pmcid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pmcid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Checked PMC identity, when supplied."
        },
        "pmid": {
          "$ref": "#/$defs/Pmid",
          "description": "Checked PubMed identity."
        },
        "title": {
          "$ref": "#/$defs/Text",
          "description": "Whole source title."
        },
        "types": {
          "description": "Clinical publication types.",
          "items": {
            "$ref": "#/$defs/PublicationType"
          },
          "type": "array"
        },
        "types_unknown": {
          "description": "The provider does not supply checked publication types.",
          "type": "boolean"
        }
      },
      "required": [
        "author_count"
      ],
      "type": "object"
    },
    "ArticleInput": {
      "description": "A validated canonical ArticleInput string.",
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|PPR[0-9]*[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "ArticleItem": {
      "description": "One original pool position, including a summary hole.",
      "properties": {
        "cited_by": {
          "description": "iCite citing-paper count, only under citation ordering.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "contexts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Capped"
            },
            {
              "type": "null"
            }
          ],
          "description": "First citation context and the source's complete context count."
        },
        "found_by": {
          "description": "Native one-based source positions, disclosed only for multiple sources.",
          "properties": {
            "europepmc": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "litsense": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "litvar": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "pubmed": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "pubtator": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "semantic-scholar": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "header": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArticleHeader"
            },
            {
              "type": "null"
            }
          ],
          "description": "Citation metadata when accepted."
        },
        "influential": {
          "description": "Provider's influential flag; absent is distinct from false.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "intents": {
          "description": "Citation intents in provider order; absent means not reported.",
          "items": {
            "$ref": "#/$defs/CitationIntent"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "key": {
          "$ref": "#/$defs/ArticleKey",
          "description": "Stable checked paper identity when the provider supplies one."
        },
        "pmid": {
          "$ref": "#/$defs/Pmid",
          "description": "The selected PMID, retained when summary mapping fails."
        },
        "sentence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArticleSentence"
            },
            {
              "type": "null"
            }
          ],
          "description": "First matching sentence in LitSense2 provider order."
        }
      },
      "type": "object"
    },
    "ArticleKey": {
      "description": "Stable identity independent of whether citation metadata was accepted.",
      "oneOf": [
        {
          "description": "PubMed identity.",
          "properties": {
            "id": {
              "$ref": "#/$defs/Pmid"
            },
            "namespace": {
              "const": "pubmed",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "PMC identity when PubMed is absent.",
          "properties": {
            "id": {
              "$ref": "#/$defs/Pmcid"
            },
            "namespace": {
              "const": "pmc",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "DOI when both indexed numeric identities are absent.",
          "properties": {
            "id": {
              "$ref": "#/$defs/Doi"
            },
            "namespace": {
              "const": "doi",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Europe PMC local source identity.",
          "properties": {
            "id": {
              "$ref": "#/$defs/EuropePmcId"
            },
            "namespace": {
              "const": "europepmc",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Semantic Scholar local identity when no indexed identifier exists.",
          "properties": {
            "id": {
              "$ref": "#/$defs/SemanticScholarId"
            },
            "namespace": {
              "const": "semantic-scholar",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "ArticleSentence": {
      "description": "Source-provided sentence resemblance, without a claim of clinical relevance.",
      "properties": {
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source section, when present."
        },
        "text": {
          "$ref": "#/$defs/Text",
          "description": "Source sentence text."
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "CacheProblem": {
      "description": "A local cache failure that leaves the provider outcome intact.",
      "enum": [
        "busy",
        "database",
        "version"
      ],
      "type": "string"
    },
    "Capped": {
      "description": "A bounded list with the total before its cap was applied.",
      "properties": {
        "items": {
          "description": "References in stable source order.",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "type": "array"
        },
        "total": {
          "description": "Distinct references before capping.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total"
      ],
      "type": "object"
    },
    "CitationIntent": {
      "description": "Source-reported reason for citing a paper.",
      "type": "string",
      "x-enum-descriptions": [
        " The source cites background information.",
        " The source cites a reported result.",
        " The source cites a method."
      ],
      "x-extensible-enum": [
        "background",
        "result",
        "methodology"
      ]
    },
    "Doi": {
      "description": "DOI preserving source spelling with ASCII-insensitive equality.",
      "pattern": "^10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "EdgeSource": {
      "description": "Graph edge provider, independent of article search providers.",
      "enum": [
        "icite",
        "semantic-scholar"
      ],
      "type": "string"
    },
    "EuropePmcId": {
      "description": "Europe PMC source prefix followed by its positive numeric local identifier.",
      "pattern": "^[A-Z]{1,8}[0-9]*[1-9][0-9]*$",
      "type": "string"
    },
    "PageInfo": {
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Pmcid": {
      "description": "Canonical PMC identifier, with an explicit namespace.",
      "pattern": "^PMC[1-9][0-9]*$",
      "type": "string"
    },
    "Pmid": {
      "description": "Positive PubMed identifier.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "PoolInfo": {
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ],
      "x-extensible-enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ]
    },
    "PublicationType": {
      "description": "Clinically meaningful PubMed publication types.",
      "type": "string",
      "x-enum-descriptions": [
        " Randomized controlled trial.",
        " Clinical trial.",
        " Phase one trial.",
        " Phase two trial.",
        " Phase three trial.",
        " Phase four trial.",
        " Meta-analysis.",
        " Systematic review.",
        " Review.",
        " Practice guideline.",
        " Guideline.",
        " Case report.",
        " Observational study.",
        " Multicenter study.",
        " Letter.",
        " Comment.",
        " Editorial.",
        " Preprint.",
        " Retracted publication.",
        " Retraction notice.",
        " Erratum."
      ],
      "x-extensible-enum": [
        "randomized-controlled-trial",
        "clinical-trial",
        "clinical-trial-phase-1",
        "clinical-trial-phase-2",
        "clinical-trial-phase-3",
        "clinical-trial-phase-4",
        "meta-analysis",
        "systematic-review",
        "review",
        "practice-guideline",
        "guideline",
        "case-report",
        "observational-study",
        "multicenter-study",
        "letter",
        "comment",
        "editorial",
        "preprint",
        "retracted-publication",
        "retraction-notice",
        "erratum"
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The local source quota refused admission without a network request.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ],
      "x-extensible-enum": [
        "not-found",
        "not-open",
        "not-pdf",
        "unsupported",
        "too-large",
        "rate-limited",
        "local-quota",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad-reply",
        "deadline-exceeded",
        "offline",
        "no-key",
        "disabled",
        "replay-miss",
        "syncing",
        "no-join-id"
      ]
    },
    "SemanticScholarAuthorId": {
      "description": "A checked source-local Semantic Scholar author identifier, never a person identity.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "SemanticScholarId": {
      "description": "Semantic Scholar's stable 40-character hexadecimal paper identifier.",
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "Source": {
      "description": "A source of BioMCP data, identified by its canonical short name.",
      "type": "string",
