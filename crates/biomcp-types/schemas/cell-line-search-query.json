{
  "$defs": {
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biomcp.cell-line-search-query/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One literal cell line search, with native order and no total claim.",
  "properties": {
    "limit": {
      "default": 5,
      "description": "Native page size.",
      "format": "uint32",
      "maximum": 25,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Native start offset.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "query": {
      "$ref": "#/$defs/Text",
      "description": "Literal source query; positional spelling and --query use the same field.",
      "x-positional": 0
    }
  },
  "required": [
    "query"
  ],
  "title": "CellLineSearch",
  "type": "object"
}
