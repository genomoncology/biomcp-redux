{
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "DrugId": {
      "description": "A published native drug record identifier, without a consumer source prefix.",
      "pattern": "^(?:[A-Z][A-Z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "DrugLabelReference": {
      "additionalProperties": false,
      "description": "One independently identified label set and revision.",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "description": "Label provenance."
        },
        "id": {
          "$ref": "#/$defs/DrugId",
          "description": "Published SPL set or native label record ID."
        },
        "revised": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source-stated revision date."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label URL.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native label revision."
        }
      },
      "required": [
        "id",
        "attribution"
      ],
      "type": "object"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.drug-label-section/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Original label text under one exact native heading.",
  "properties": {
    "heading": {
      "$ref": "#/$defs/Text",
      "description": "Exact native field or heading."
    },
    "label": {
      "$ref": "#/$defs/DrugLabelReference",
      "description": "Label identity and revision."
    },
    "text": {
      "description": "Original text, preserving whitespace; consumer paging never summarizes it.",
      "type": "string"
    }
  },
  "required": [
    "label",
    "heading",
    "text"
  ],
  "title": "DrugLabelSection",
  "type": "object"
}
