{
  "$defs": {
    "ArticleInput": {
      "description": "A validated canonical ArticleInput string.",
      "pattern": "^(?:[1-9][0-9]*|PMC[1-9][0-9]*|PPR[0-9]*[1-9][0-9]*|(?:https?://doi\\.org/)?10\\.[0-9]+/[^\\s\\x00-\\x1f\\x7f]+)$",
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.article-recommend/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Recommendations in the provider's recent-paper pool order.",
  "properties": {
    "limit": {
      "default": 10,
      "description": "Maximum recommendations requested, in native order.",
      "format": "uint32",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "negative": {
      "default": [],
      "description": "Up to ten negative paper identities.",
      "items": {
        "$ref": "#/$defs/ArticleInput"
      },
      "maxItems": 10,
      "type": "array"
    },
    "offset": {
      "default": 0,
      "description": "Number of stored recommendations to skip.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "pool": {
      "$ref": "#/$defs/Text",
      "description": "Fixed recommendation pool."
    },
    "seeds": {
      "description": "One to ten positive paper identities.",
      "items": {
        "$ref": "#/$defs/ArticleInput"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array",
      "x-positional": 0
    }
  },
  "required": [
    "seeds"
  ],
  "title": "ArticleRecommend",
  "type": "object"
}
