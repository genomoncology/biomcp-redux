{
  "$defs": {
    "Curie": {
      "description": "Checked prefix:local ontology identifier.",
      "pattern": "^[A-Za-z0-9_.-]+:[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\x00-\\x1f\\x7f-\\x9f]+$",
      "type": "string"
    },
    "GeneInput": {
      "description": "An input classified before source resolution; aliases remain free text.",
      "pattern": "^[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*(?:HGNC:(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})|ENSG[0-9]{11}(\\.(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0}))?|(?:4294967295|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-4][0-9]{0})|(?!(?:[Hh][Gg][Nn][Cc]:|[Ee][Nn][Ss][Gg]))(?![0-9]+[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$)[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?)[\\x09-\\x0d\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$",
      "type": "string"
    },
    "NctId": {
      "description": "Canonical ClinicalTrials.gov identifier.",
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision. The parser additionally validates the calendar day, including leap years.",
      "pattern": "^(?!0000)[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "type": "string"
    },
    "PhaseFilter": {
      "description": "Explicit source phase selection, including the registry's combined phases.",
      "enum": [
        "early-1",
        "1",
        "2",
        "3",
        "4",
        "not-applicable",
        "1/2",
        "2/3"
      ],
      "type": "string"
    },
    "SponsorType": {
      "description": "Registry funding category facet.",
      "enum": [
        "nih",
        "fed",
        "industry",
        "other"
      ],
      "type": "string"
    },
    "StudyType": {
      "description": "Source-native registry value.",
      "enum": [
        "INTERVENTIONAL",
        "OBSERVATIONAL",
        "EXPANDED_ACCESS"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    },
    "TrialSex": {
      "description": "Source-native registry value.",
      "enum": [
        "ALL",
        "FEMALE",
        "MALE"
      ],
      "type": "string"
    },
    "TrialSource": {
      "description": "Independent trial providers; results are never folded or used as fallbacks.",
      "enum": [
        "ctgov",
        "nci"
      ],
      "type": "string"
    },
    "TrialStatus": {
      "description": "Publisher Status enum for OverallStatus from\n<https://clinicaltrials.gov/api/v2/studies/enums>.",
      "enum": [
        "ACTIVE_NOT_RECRUITING",
        "COMPLETED",
        "ENROLLING_BY_INVITATION",
        "NOT_YET_RECRUITING",
        "RECRUITING",
        "SUSPENDED",
        "TERMINATED",
        "WITHDRAWN",
        "AVAILABLE",
        "NO_LONGER_AVAILABLE",
        "TEMPORARILY_NOT_AVAILABLE",
        "APPROVED_FOR_MARKETING",
        "WITHHELD",
        "UNKNOWN"
      ],
      "type": "string"
    }
  },
  "$id": "biomcp.trial-search/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Search ClinicalTrials.gov or keyed NCI with native counts. NCI --facility matches exact organization names; a listed site is not necessarily enrolling.",
  "properties": {
    "age": {
      "description": "Age in years; unstated source bounds count as no limit.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "condition": {
      "description": "Condition alternatives joined with OR; NCI requires NCIt codes.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 5,
      "type": "array"
    },
    "condition_id": {
      "$ref": "#/$defs/Curie",
      "description": "Exact MONDO or DOID CURIE resolved by MyDisease; NCI also accepts explicit NCIT:C codes."
    },
    "count_only": {
      "description": "Source total only; no returned study rows.",
      "type": "boolean"
    },
    "criteria": {
      "$ref": "#/$defs/Text",
      "description": "Search literal registry eligibility text for discovery only; no eligibility judgment."
    },
    "distance": {
      "$ref": "#/$defs/Text",
      "description": "Source distance with explicit mi or km units."
    },
    "exact_condition": {
      "description": "Ask ClinicalTrials.gov to restrict matching to the registered condition phrase; its support is partial.",
      "type": "boolean"
    },
    "facility": {
      "$ref": "#/$defs/Text",
      "description": "Exact facility name; NCI matches organization names case-insensitively. A listed site is not necessarily enrolling. Cannot combine with radius."
    },
    "gene": {
      "$ref": "#/$defs/GeneInput",
      "description": "Resolve one checked gene for registry text discovery only; no eligibility judgment."
    },
    "has_results": {
      "description": "Require posted source results.",
      "type": "boolean"
    },
    "id": {
      "$ref": "#/$defs/NctId",
      "description": "Exact NCT identity in a conjunction with other filters."
    },
    "intervention": {
      "description": "Intervention alternatives joined with OR; supported by ClinicalTrials.gov.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 5,
      "type": "array"
    },
    "keyword": {
      "description": "Repeat for ClinicalTrials.gov general text alternatives joined with OR; different filters combine with AND. NCI accepts one keyword.",
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 5,
      "type": "array"
    },
    "lat": {
      "$ref": "#/$defs/Text",
      "description": "Radius center latitude in degrees."
    },
    "limit": {
      "default": 10,
      "description": "Headers per page; NCI applies its own lower publisher limit.",
      "format": "uint32",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "lon": {
      "$ref": "#/$defs/Text",
      "description": "Radius center longitude in degrees."
    },
    "next_page": {
      "$ref": "#/$defs/Text",
      "description": "Opaque registry continuation; keep filters unchanged."
    },
    "phase": {
      "$ref": "#/$defs/PhaseFilter",
      "description": "Registry phase: 1, 2, 3, 4, early-1, not-applicable, 1/2 or 2/3."
    },
    "query": {
      "$ref": "#/$defs/Text",
      "description": "General registry discovery text.",
      "x-positional": 0
    },
    "sex": {
      "$ref": "#/$defs/TrialSex",
      "description": "Registry sex facet."
    },
    "source": {
      "$ref": "#/$defs/TrialSource",
      "description": "Explicit provider; defaults to ClinicalTrials.gov and never falls back."
    },
    "sponsor": {
      "$ref": "#/$defs/Text",
      "description": "Exact lead sponsor field."
    },
    "sponsor_type": {
      "$ref": "#/$defs/SponsorType",
      "description": "Registry sponsor funding facet."
    },
    "status": {
      "$ref": "#/$defs/TrialStatus",
      "description": "Exact registry overall status."
    },
    "study_type": {
      "$ref": "#/$defs/StudyType",
      "description": "Exact registry study type."
    },
    "updated_since": {
      "$ref": "#/$defs/PartialDate",
      "description": "First included registry update date."
    },
    "updated_until": {
      "$ref": "#/$defs/PartialDate",
      "description": "Last included registry update date."
    },
    "variant": {
      "$ref": "#/$defs/Text",
      "description": "Literal variant text for registry discovery only; no eligibility judgment."
    }
  },
  "title": "TrialSearch",
  "type": "object"
}
