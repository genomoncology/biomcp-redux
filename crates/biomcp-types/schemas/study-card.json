{
  "$defs": {
    "CbioportalCancerTypeId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "PageInfo": {
      "additionalProperties": false,
      "description": "Search counts after filtering and deduplication.",
      "properties": {
        "offset": {
          "description": "Skipped results.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pool": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional pooled snapshot."
        },
        "returned": {
          "description": "Results returned on this page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Total matching identities held by this snapshot.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Matching source count exceeded the retrieved window.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "offset",
        "returned",
        "total"
      ],
      "type": "object"
    },
    "Pmid": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "PoolInfo": {
      "additionalProperties": false,
      "description": "Fixed lifetime and size of a stored search snapshot.",
      "properties": {
        "created": {
          "description": "Publication wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "description": "Fixed expiry wall time in Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Opaque snapshot identifier."
        },
        "size": {
          "description": "Number of ordered identities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "size",
        "created",
        "expires"
      ],
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "description": "A field that could not be accepted from a source record.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProblemCode",
          "description": "Why the field value was not accepted."
        },
        "field": {
          "description": "The biodata field name.",
          "type": "string"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The record's canonical identifier, when known."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "The source that supplied the record."
        }
      },
      "required": [
        "source",
        "field",
        "code"
      ],
      "type": "object"
    },
    "ProblemCode": {
      "description": "A stable code for a rejected field value.",
      "enum": [
        "value.unknown",
        "collection.incomplete",
        "identity.conflict"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The field value was not recognized.",
        " Native collection exceeds the admitted complete source page.",
        " A source repeats one exact identity with incompatible records."
      ]
    },
    "Reason": {
      "description": "Why a source could not supply data.",
      "enum": [
        "not_found",
        "not_open",
        "not_pdf",
        "unsupported",
        "too_large",
        "rate_limited",
        "unavailable",
        "tls",
        "proxy",
        "rejected",
        "bad_reply",
        "deadline_exceeded",
        "offline",
        "no_key",
        "disabled",
        "replay_miss",
        "syncing",
        "no_join_id"
      ],
      "type": "string",
      "x-enum-descriptions": [
        " The requested record was not found.",
        " The public bucket does not hold an open text record.",
        " Publisher response is not a PDF.",
        " The local reader does not support the file or container format.",
        " The response exceeds an explicit reader resource bound.",
        " The source limited the request rate.",
        " The source was unavailable.",
        " Platform or configured certificate verification failed.",
        " Connecting to or negotiating the configured proxy failed.",
        " The source rejected the request.",
        " The reply could not be used.",
        " The request exhausted its deadline.",
        " Network access was disabled.",
        " A required credential was absent.",
        " The source was disabled.",
        " No recording matched the request.",
        " The source data was being synchronized.",
        " Identity lacks the identifier required to join this source."
      ]
    },
    "Section": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/StudyProfiles",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Section2": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/StudySampleLists",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "Section3": {
      "description": "A requested section has exactly one state.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source returned data.",
          "properties": {
            "data": {
              "$ref": "#/$defs/StudyFiles",
              "description": "Whole section data."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The source answered with no data.",
          "properties": {
            "record": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native entry, if any."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A requested source failed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "unavailable",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "User settings prevented the source request.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Reason",
              "description": "Typed reason."
            },
            "source": {
              "$ref": "#/$defs/Source",
              "description": "Source identity."
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "source",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entity facts rule this section out.",
          "properties": {
            "state": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
