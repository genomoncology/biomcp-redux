    "SourceNotice": {
      "description": "A provider query interpretation notice.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The source still has graph pages after the bounded fetch window.",
          "properties": {
            "fallback": {
              "$ref": "#/$defs/Text",
              "description": "Default-source command offering another graph view."
            },
            "kind": {
              "const": "graph_truncated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fallback"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "PubMed did not index these words.",
          "properties": {
            "kind": {
              "const": "not_found_words",
              "type": "string"
            },
            "words": {
              "description": "Whole source words.",
              "items": {
                "$ref": "#/$defs/Text"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "words"
          ],
          "type": "object"
        }
      ]
    },
    "SourceOutcome": {
      "additionalProperties": false,
      "description": "One source's outcome, without provider text.",
      "properties": {
        "count": {
          "description": "Provider matching count.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched": {
          "description": "Retrieved identity depth.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "notices": {
          "description": "Provider query notices that do not indicate failure.",
          "items": {
            "$ref": "#/$defs/SourceNotice"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Failure or stale-fallback reason."
        },
        "source": {
          "$ref": "#/$defs/Source",
          "description": "Asked source."
        },
        "state": {
          "$ref": "#/$defs/SourceState",
          "description": "Retained state."
        },
        "term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact provider search term."
        },
        "terms": {
          "description": "Publisher terms name from the source registry.",
          "type": "string"
        },
        "terms_url": {
          "description": "Publisher page documenting the terms.",
          "type": "string"
        },
        "use": {
          "$ref": "#/$defs/Use",
          "description": "Reviewed source use category; publisher terms remain authoritative."
        }
      },
      "required": [
        "source",
        "use",
        "terms",
        "terms_url",
        "state"
      ],
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "description": "The source's own entry for an entity.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Text",
          "description": "Native source identifier."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Link to that entry."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SourceState": {
      "description": "State of a source actually asked by the command.",
      "enum": [
        "ok",
        "stale",
        "syncing",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "Status": {
      "description": "Overall command outcome.",
      "enum": [
        "complete",
        "partial",
        "absent",
        "failed"
      ],
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "description": "A command argument list spelled from a typed action.",
      "properties": {
        "args": {
          "description": "CLI and MCP arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StepKind",
          "description": "Purpose of the action."
        }
      },
      "required": [
        "kind",
        "args"
      ],
      "type": "object"
    },
    "StepKind": {
      "description": "Purpose of an available next command.",
      "enum": [
        "restart",
        "section",
        "sort",
        "page",
        "fresh",
        "disambiguate",
        "pivot",
        "sync",
        "key",
        "configure"
      ],
      "type": "string"
    },
    "Study": {
      "additionalProperties": false,
      "description": "Source-specific study card metadata; no inferred denominator or gene aggregate.",
      "properties": {
        "cnaSampleCount": {
          "description": "Native cnaSampleCount.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "description": {
          "description": "Native description.",
          "type": "string"
        },
        "groups": {
          "description": "Native access groups, possibly empty; not a reuse license.",
          "type": "string"
        },
        "header": {
          "$ref": "#/$defs/StudyHeader",
          "description": "Compact study identity and publication references."
        },
        "importDate": {
          "$ref": "#/$defs/StudyImportTime",
          "description": "Native timezone-unstated import time."
        },
        "patientCount": {
          "description": "Only an explicitly stated card patientCount; captured cards omit it, distinct from zero.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "publicStudy": {
          "description": "Native public-study access metadata.",
          "type": "boolean"
        },
        "readPermission": {
          "description": "Native access metadata; not a reuse license.",
          "type": "boolean"
        },
        "resourceCounts": {
          "description": "Independent resource-scoped counts, never summed into study totals.",
          "items": {
            "$ref": "#/$defs/StudyResourceCount"
          },
          "type": "array"
        },
        "sequencedSampleCount": {
          "description": "Native sequencedSampleCount, not gene coverage.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "structuralVariantCount": {
          "description": "Native structuralVariantCount; its name does not imply sample units.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "treatmentCount": {
          "description": "Native treatmentCount without a unit conversion.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "header",
        "description",
        "sequencedSampleCount",
        "cnaSampleCount",
        "structuralVariantCount",
        "treatmentCount",
        "resourceCounts",
        "importDate",
        "groups",
        "readPermission",
        "publicStudy"
      ],
      "type": "object"
    },
    "StudyBlobSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "StudyCard": {
      "additionalProperties": false,
      "description": "Exact card with independent live section states and catalog provenance.",
      "properties": {
        "files": {
          "anyOf": [
            {
              "$ref": "#/$defs/Section3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested file-reference page, with no downloaded data."
        },
        "profiles": {
          "anyOf": [
            {
              "$ref": "#/$defs/Section"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested molecular-profile page, absent when not requested."
        },
        "sample_lists": {
          "anyOf": [
            {
