{
  "$defs": {
    "NctId": {
      "description": "Canonical ClinicalTrials.gov identifier.",
      "pattern": "^NCT(?!00000000)[0-9]{8}$",
      "type": "string"
    },
    "Text": {
      "description": "Bounded nonempty text with surrounding Unicode whitespace removed.",
      "maxLength": 1048576,
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069])",
      "type": "string"
    }
  },
  "$id": "biomcp.trial-document/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read or save a listed trial PDF (25 MiB, 100 pages per read).",
  "properties": {
    "file": {
      "$ref": "#/$defs/Text",
      "description": "Listed PDF name.",
      "x-positional": 1
    },
    "find": {
      "$ref": "#/$defs/Text",
      "description": "Find a phrase, ignoring case."
    },
    "input": {
      "$ref": "#/$defs/NctId",
      "description": "NCT ID.",
      "x-positional": 0
    },
    "page_start": {
      "description": "First PDF page (default 1).",
      "format": "uint32",
      "minimum": 1,
      "type": "integer"
    },
    "replace": {
      "description": "Overwrite.",
      "type": "boolean"
    },
    "save": {
      "$ref": "#/$defs/Text",
      "description": "Save to a file or folder."
    },
    "section_offset": {
      "description": "Part or hit offset from 0.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "input",
    "file"
  ],
  "title": "TrialDocumentGet",
  "type": "object",
  "x-reply-query-titles": [
    "TrialDocumentSaveQuery"
  ]
}
