{
  "$defs": {
    "Reply_Attribution": {
      "description": "Provenance for one source record.",
      "properties": {
        "evaluated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_PartialDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source evaluation date."
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native assertion record."
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset release."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the claim."
        },
        "submitter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source submitter or panel."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source record link.",
          "format": "uri"
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Record version."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "Reply_DrugId": {
      "description": "A published native drug record identifier, without a consumer source prefix.",
      "pattern": "^(?:[A-Z][A-Z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*$",
      "type": "string"
    },
    "Reply_DrugIdentity": {
      "description": "One source record identity, without any equivalence or authorization claim.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_DrugId",
          "description": "Published native record identifier."
        },
        "identity_level": {
          "$ref": "#/$defs/Reply_DrugIdentityLevel",
          "description": "Level established by the endpoint or record type; unknown stays unknown."
        },
        "name": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Original source name."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for this identity."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native record type, without local classification."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native record URL.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "source",
        "identity_level"
      ],
      "type": "object"
    },
    "Reply_DrugIdentityLevel": {
      "description": "Identity level established by the source endpoint or record type, never inferred from ID shape.",
      "type": "string",
      "x-enum-descriptions": [
        " Source-stated ingredient identity.",
        " Source-stated salt identity.",
        " Source-stated clinical formulation identity.",
        " Source-stated branded product identity.",
        " Source-stated spl set identity.",
        " Source-stated spl version identity.",
        " Source-stated ndc package identity.",
        " Source-stated fda application identity.",
        " Source-stated fda product identity.",
        " Source-stated ema authorization identity.",
        " Source-stated ema application identity.",
        " Source-stated orphan designation identity.",
        " Source-stated unknown identity."
      ],
      "x-extensible-enum": [
        "ingredient",
        "salt",
        "clinical_formulation",
        "branded_product",
        "spl_set",
        "spl_version",
        "ndc_package",
        "fda_application",
        "fda_product",
        "ema_authorization",
        "ema_application",
        "orphan_designation",
        "unknown"
      ]
    },
    "Reply_DrugNativeReference": {
      "description": "Typed source reference shared by mechanism and indication records.",
      "properties": {
        "ref_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source reference identifier, when supplied."
        },
        "ref_type": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Native reference type."
        },
        "ref_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source reference link, when supplied.",
          "format": "uri"
        }
      },
      "required": [
        "ref_type"
      ],
      "type": "object"
    },
    "Reply_DrugNativeTarget": {
      "description": "One source-native target identity, without inventing a gene label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Exact published target identifier."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native target label, only when supplied."
        },
        "source": {
          "$ref": "#/$defs/Reply_Text",
          "description": "Source responsible for the native identifier."
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native target link, only when supplied.",
          "format": "uri"
        }
      },
      "required": [
        "source",
        "id"
      ],
      "type": "object"
    },
    "Reply_EnsemblGeneId": {
      "description": " A human Ensembl gene stable identifier with a separately retained version.",
      "pattern": "^ENSG[0-9]{11}(\\.[1-9][0-9]*)?$",
      "type": "string"
    },
    "Reply_GeneRef": {
      "description": "A source-stated gene reference; its label never implies an identifier.",
      "properties": {
        "ensembl_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_EnsemblGeneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "hgnc_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_HgncId"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/Reply_Text"
        },
        "ncbi_gene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reply_NcbiGeneId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Reply_HgncId": {
      "description": "An HGNC identifier with canonical namespace and positive numeric value.",
      "pattern": "^HGNC:[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_NcbiGeneId": {
      "description": "A positive NCBI Gene identifier in canonical decimal text.",
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Reply_PartialDate": {
      "description": "A Gregorian date preserving year, month or day precision.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": "string"
    },
    "Reply_Text": {
      "description": "Nonempty text with surrounding Unicode whitespace removed.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "biodata.drug-target-relation/3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "required": [
        "target"
      ]
    },
    {
      "required": [
        "native_target"
      ]
    }
  ],
  "description": "A native target or mechanism relation, without an indication inference.",
  "properties": {
    "attribution": {
      "$ref": "#/$defs/Reply_Attribution",
      "description": "Native relation provenance."
    },
    "drug": {
      "$ref": "#/$defs/Reply_DrugIdentity",
      "description": "Source drug identity."
    },
    "mechanism": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reply_Text"
        },
        {
          "type": "null"
        }
      ],
      "description": "Native mechanism wording, only when supplied."
    },
    "native_target": {
      "$ref": "#/$defs/Reply_DrugNativeTarget",
      "description": "Native target identity independent of a gene reference."
    },
    "references": {
      "description": "Source-native supporting references.",
      "items": {
        "$ref": "#/$defs/Reply_DrugNativeReference"
      },
      "type": "array"
    },
    "relation": {
      "$ref": "#/$defs/Reply_Text",
      "description": "Native relationship label."
    },
    "target": {
      "$ref": "#/$defs/Reply_GeneRef",
      "description": "Source-stated target gene, without using mechanism text as a gene label."
    }
  },
  "required": [
    "drug",
    "relation",
    "attribution"
  ],
  "title": "DrugTargetRelation",
  "type": "object"
}
