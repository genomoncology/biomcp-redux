---
// The commands of one entity with their one-line help descriptions, from src/data/commands.json.
import { commandRows } from '../lib/commands.mjs';
interface Props { entity: string }
const { entity } = Astro.props;
const rows = commandRows(entity);
if (!rows.length) throw new Error(`CommandTable: no commands for entity ${entity}`);
---
<table>
  <thead><tr><th>Command</th><th>Description</th></tr></thead>
  <tbody>{rows.map((r) => <tr><td><a href={r.route}><code>biomcp {r.command}</code></a></td><td>{r.description}</td></tr>)}</tbody>
</table>
