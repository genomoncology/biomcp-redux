        "value": {"protocolSection":{"identificationModule":{"nctId":"NCT07644559","orgStudyIdInfo":{"id":"VS-7375-201"},"organization":{"fullName":"Verastem, Inc.","class":"INDUSTRY"},"briefTitle":"A Phase 2 Study of VS-7375 in Patients With KRAS G12D-Mutated Pancreatic Cancer","officialTitle":"A Phase 2, Open-label Study of VS-7375, an Oral KRAS G12D (ON/OFF) Inhibitor, as Monotherapy and With Cetuximab, in Patients With Metastatic KRAS G12D-Mutated Pancreatic Cancer (TARGET-D 201)"},"statusModule":{"statusVerifiedDate":"2026-10","overallStatus":"RECRUITING","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2026-06-16","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2027-06","type":"ESTIMATED"},"completionDateStruct":{"date":"2028-12","type":"ESTIMATED"},"studyFirstSubmitDate":"2026-05-26","studyFirstSubmitQcDate":"2026-06-08","studyFirstPostDateStruct":{"date":"2026-06-12","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-11-09","lastUpdatePostDateStruct":{"date":"2026-11-13","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Verastem, Inc.","class":"INDUSTRY"}},"oversightModule":{"oversightHasDmc":false,"isFdaRegulatedDrug":true,"isFdaRegulatedDevice":false},"descriptionModule":{"briefSummary":"This study will assess the safety and efficacy of VS-7375 alone and in combination with cetuximab in patients with metastatic KRAS G12D - mutated Pancreatic Cancer"},"conditionsModule":{"conditions":["Pancreatic Ductal Adenocarcinoma (PDAC)","G12D Mutated KRAS"],"keywords":["KRAS G12D mutation","KRAS","PDAC","Pancreatic Ductal Adenocarcinoma","Pancreatic Cancer","Pancreatic Neoplasms","RAS"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"SINGLE","whoMasked":["OUTCOMES_ASSESSOR"]}},"enrollmentInfo":{"count":185,"type":"ESTIMATED"}},"armsInterventionsModule":{"armGroups":[{"label":"VS-7375 Monotherapy","type":"EXPERIMENTAL","interventionNames":["Drug: VS-7375"]},{"label":"VS-7375 + cetuximab 2L PDAC","type":"EXPERIMENTAL","interventionNames":["Drug: VS-7375","Drug: cetuximab (or panitumumab if α-gal IgE+ or cetuximab reaction)"]},{"label":"VS-7375 + cetuximab 1L PDAC","type":"EXPERIMENTAL","interventionNames":["Drug: VS-7375","Drug: cetuximab (or panitumumab if α-gal IgE+ or cetuximab reaction)"]}],"interventions":[{"type":"DRUG","name":"VS-7375","description":"Taken by mouth","armGroupLabels":["VS-7375 + cetuximab 1L PDAC","VS-7375 + cetuximab 2L PDAC","VS-7375 Monotherapy"]},{"type":"DRUG","name":"cetuximab (or panitumumab if α-gal IgE+ or cetuximab reaction)","description":"Subcutaneous infusion","armGroupLabels":["VS-7375 + cetuximab 1L PDAC","VS-7375 + cetuximab 2L PDAC"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Confirmed ORR by blinded independent central review (BICR) per RESIST v1.1","description":"Overall Response Rate per RECIST version 1.1, per blinded independent central review (BICR)","timeFrame":"6 months"},{"measure":"To characterize the safety and tolerability of VS-7375 monotherapy or in combination with cetuximab, administered on a daily oral schedule in participants with KRAS G12D-mutated PDAC.","description":"Proportion/number of participants with AEs, TEAEs, TRAEs, SAEs, and dose interruptions/reductions and discontinuations.","timeFrame":"6 months"}],"secondaryOutcomes":[{"measure":"Confirmed ORR per RECIST v1.1 assessed by BICR (primary) and Investigator (secondary) assessments.","description":"To evaluate additional efficacy parameters of VS-7375 monotherapy and VS-7375 in combination with cetuximab, administered on a daily oral schedule in participants with KRAS G12D-mutated PDAC.","timeFrame":"24 months"},{"measure":"Plasma Pharmacokinetics (PK) of VS-7375 and relevant metabolites, Cmax","description":"Maximum concentration (Cmax)","timeFrame":"20 weeks"},{"measure":"Plasma Pharmacokinetics (PK) of VS-7375 and relevant metabolites, AUC","description":"Area under plasma Concentration (AUC) 0 to t","timeFrame":"20 weeks"},{"measure":"To evaluate Pharmacodynamics (PD) and other relevant blood tumor markers specific to tumor type","description":"CA19-9, CEA, CA-125","timeFrame":"Up to 2.5 years"},{"measure":"To assess the health-related quality of life and disease based on European Organization for Research and Treatment of Cancer (EORTC) Quality of life Questionnaire Core module C30 (QLQ-C30).","description":"The EORTC QLQ-C30 is a validated questionnaire to assess the quality of life of pancreatic ductal adenocarcinoma patients.","timeFrame":"24 months"},{"measure":"To assess the health-related quality of life and disease based on European Organization for Research and Treatment of Cancer (EORTC) Quality of life Questionnaire Core module QLQ-PAN26.","description":"The EORTC QLQ-PAN26 assesses the health-related QoL in patients with pancreatic cancer. QLQ-PAN26 includes 26 items related to disease symptoms, treatment side-effects, and emotional issues specific to pancreatic cancer.","timeFrame":"24 months"},{"measure":"Time to next therapy.","description":"To assess the interval between initiation of study treatment and initiation of subsequent","timeFrame":"24 months"}],"otherOutcomes":[{"measure":"Imaging of tumor metabolism changes","description":"To assess tumor metabolism dynamics on FDG-PET/CT","timeFrame":"24 months"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Histologic or cytologic confirmed PDAC\n* Measurable disease per RECIST 1.1\n* Local testing confirmed KRAS G12D mutation (tissue required for confirmatory central testing)\n* ECOG PS=0 or 1\n\nAdequate organ function\n\nVS-7375 + cetuximab (2L PDAC) :\n\n-Received only 1 prior Tx in the metastatic setting; prior adjuvant counts as a line if progressed within 6 months\n\nVS-7375 + cetuximab (1L PDAC) :\n\n-Treatment-naïve or received ≤ 1 cycle of SoC for metastatic disease\n\nExclusion criteria:\n\n* Have any documented co-existing pathogenic or likely pathogenic RAS mutation(s) in KRAS\n* Prior anti-cancer Tx within 4 weeks or drug-specific timeline within first treatment dose, whichever shorter\n* Major surgery within 4 weeks of first treatment dose\n* Radiation therapy (RT) within 1 week of first treatment dose; RT to brain or lung within 2 weeks of first treatment dose\n* History of drug-induced Interstitial Lung Disease\n* Receipt of prior direct RAS inhibitor\n* Untreated or symptomatic CNS metastasis\n* Receipt of strong CYP3A4 inhibitor/inducer or CYP3A4 sensitive substrates with narrow therapeutic index within 14 days or drug-specific timeline within first treatment dose, whichever is shorter\n* Receipt of PPI, P-CABs, or H2 blocker within 5 days\n* Inability to swallow oral medication\n* Other protocol-defined inclusion/exclusion criteria may apply","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"centralContacts":[{"name":"Verastem Call Center","role":"CONTACT","phone":"7812924204","email":"VS-7375-201TrialSupport@verastem.com"},{"name":"Luke Chung, MD","role":"CONTACT","email":"VS-7375-201Medical@verastem.com"}],"locations":[{"facility":"START- Los Angeles","status":"RECRUITING","city":"Los Angeles","state":"California","zip":"90025","country":"United States","contacts":[{"name":"Hope Team","role":"CONTACT","email":"hopeteam@startresearch.com"},{"name":"Navid Hafez, MD","role":"PRINCIPAL_INVESTIGATOR"}],"geoPoint":{"lat":34.05223,"lon":-118.24368}},{"facility":"Cedars-Sinai Medical Center","status":"RECRUITING","city":"Los Angeles","state":"California","zip":"90048","country":"United States","contacts":[{"name":"Zachariah Brown","role":"CONTACT","phone":"310-423-5618","email":"Zachariah.Brown@cshs.org"},{"name":"Arsen Osipov, MD","role":"PRINCIPAL_INVESTIGATOR"}],"geoPoint":{"lat":34.05223,"lon":-118.24368}},{"facilit