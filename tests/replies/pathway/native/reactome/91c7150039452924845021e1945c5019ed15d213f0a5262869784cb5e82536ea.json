sapiens","Hs","human","man"],"taxId":"9606","abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"dbId":187689,"displayName":"Trk receptors signal from the plasma membrane and from intra...","text":"Trk receptors signal from the plasma membrane and from intracellular membranes, particularly from early endosomes. Signalling from the plasma membrane is fast but transient; signalling from endosomes is slower but long lasting. Signalling from the plasma membrane is annotated here. TRK signalling leads to proliferation in some cell types and neuronal differentiation in others. Proliferation is the likely outcome of short term signalling, as observed following stimulation of  EGFR (EGF receptor). Long term signalling via TRK receptors, instead, was clearly shown to be required for neuronal differentiation in response to neurotrophins.","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"doi":"10.3180/REACT_12056.1","hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2020-09-24","hasEvent":[{"dbId":187015,"displayName":"Activation of TRKA receptors","stId":"R-HSA-187015","stIdVersion":"R-HSA-187015.4","isInDisease":false,"isInferred":false,"maxDepth":3,"name":["Activation of TRKA receptors"],"releaseDate":"2007-12-11","speciesName":"Homo sapiens","eventOf":[187037],"doi":"10.3180/REACT_11064.3","hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2018-09-30","schemaClass":"Pathway","className":"Pathway"},{"dbId":187687,"displayName":"Signalling to ERKs","stId":"R-HSA-187687","stIdVersion":"R-HSA-187687.3","isInDisease":false,"isInferred":false,"maxDepth":4,"name":["Signalling to ERKs"],"releaseDate":"2007-12-11","speciesName":"Homo sapiens","eventOf":[187037],"hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2019-09-09","schemaClass":"Pathway","className":"Pathway"},{