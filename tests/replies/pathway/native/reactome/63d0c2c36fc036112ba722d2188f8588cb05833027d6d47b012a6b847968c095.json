asive RAD51 nucleofilaments. The RAD51 nucleofilament invades a sister chromatid DNA duplex, leading to D-loop formation. After the D-loop is extended by DNA repair synthesis, the resulting recombination intermediates in the form of extended D-loops or double Holliday junctions can be resolved through crossover- or non-crossover-generating processes (reviewed by Ciccia and Elledge 2010).","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2022-04-07","hasEvent":[{"dbId":5693579,"displayName":"Homologous DNA Pairing and Strand Exchange","stId":"R-HSA-5693579","stIdVersion":"R-HSA-5693579.5","isInDisease":false,"isInferred":false,"maxDepth":3,"name":["Homologous DNA Pairing and Strand Exchange"],"releaseDate":"2003-11-03","speciesName":"Homo sapiens","eventOf":[5685942],"doi":"10.3180/R-HSA-5693579.2","hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2022-04-07","schemaClass":"Pathway","className":"Pathway"},{"dbId":5693593,"displayName":"D-loop extension by DNA polymerases","stId":"R-HSA-5693593","stIdVersion":"R-HSA-5693593.4","isInDisease":false,"isInferred":false,"maxDepth":1,"name":["D-loop extension by DNA polymerases"],"releaseDate":"2003-11-03","speciesName":"Homo sapiens","eventOf":[5685942],"category":"transition","className":"Reaction","schemaClass":"Reaction"},{"dbId":5693537,"displayName":"Resolution of D-Loop Structures","stId":"R-HSA-5693537","stIdVersion":"R-HSA-5693537.3","isInDisease":false,"isInferred":false,"maxDepth":3,"name":["Resolution of D-Loop Structures"],"releaseDate":"2003-11-03","speciesName":"Homo sapiens","eventOf":[5685942],"hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2021-09-15","schemaClass":"Pathway","className":"Pathway"}],"schemaClass":"Pathway","className":"Pathway"}}}]}
