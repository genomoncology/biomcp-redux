ournal":"Nat. Genet.","pages":"602-12","pubMedIdentifier":23583981,"volume":45,"year":2013,"url":"http://www.ncbi.nlm.nih.gov/pubmed/23583981","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"dbId":6800629,"displayName":"A novel SND1-BRAF fusion confers resistance to c-Met inhibitor PF-04217903 in GTL16 cells through [corrected] MAPK activation","title":"A novel SND1-BRAF fusion confers resistance to c-Met inhibitor PF-04217903 in GTL16 cells through [corrected] MAPK activation","journal":"PLoS ONE","pages":"e39653","pubMedIdentifier":22745804,"volume":7,"year":2012,"url":"http://www.ncbi.nlm.nih.gov/pubmed/22745804","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"dbId":6802031,"displayName":"Identification of kinase fusion oncogenes in post-Chernobyl radiation-induced thyroid cancers","title":"Identification of kinase fusion oncogenes in post-Chernobyl radiation-induced thyroid cancers","journal":"J. Clin. Invest.","pages":"4935-44","pubMedIdentifier":24135138,"volume":123,"year":2013,"url":"http://www.ncbi.nlm.nih.gov/pubmed/24135138","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"dbId":6799065,"displayName":"Regulation of RAF protein kinases in ERK signalling","title":"Regulation of RAF protein kinases in ERK signalling","journal":"Nat. Rev. Mol. Cell Biol.","pages":"281-98","pubMedIdentifier":25907612,"volume":16,"year":2015,"url":"http://www.ncbi.nlm.nih.gov/pubmed/25907612","className":"LiteratureReference","schemaClass":"LiteratureReference"}],"species":[{"dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"dbId":6802208,"displayName":"In addition to the more prevalent point mutations, BRAF and ...","text":"In addition to the more prevalent point mutations, BRAF and RAF1 are also subject to activation as a result of translocation events that yield truncated or fusion products (Jones et al, 2008; Cin et al, 2011; Palanisamy et al, 2010; Ciampi et al, 2005; Stransky et al, 2014; Hutchinson et al, 2013; Zhang et al, 2013; Lee et al, 2012; Ricarte-Filho et al, 2013; reviewed in Lavoie and Therrien et al, 2015). In general these events put the C-terminal kinase domain of BRAF or RAF1 downstream of an N-terminal sequence provided by a partner protein. This removes the N-terminal region of the RAF protein, relieving the autoinhibition imposed by this region of the protein. In addition, some but not all of the fusion partner proteins have been shown to contain coiled-coil or other dimerization domains. Taken together, the fusion proteins are thought to dimerize constitutively and activate downstream signaling (Jones et al, 2008; Lee et al, 2012; Hutchinson et al, 2013; Ciampi et al, 2005; Cin et al, 2011; Stransky et al, 2014).","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":false,"hasEvent":[{"dbId":6802927,"displayName":"BRAF and RAF fusion mutant dimers are phosphorylated","stId":"R-HSA-6802927","stIdVersion":"R-HSA-6802927.2","isInDisease":true,"isInferred":false,"maxDepth":1,"name":["BRAF and RAF fusion mutant dimers are phosphorylated"],"releaseDate":"2016-09-19","speciesName":"Homo sapiens","eventOf":[6802952],"isChimeric":false,"category":"transition","className":"Reaction","schemaClass":"Reaction"},{"dbId":6802934,"displayName":"p-BRAF and RAF fusion dimers bind MAP2Ks and MAPKs","stId":"R-HSA-6802934","stIdVersion":"R-HSA-6802934.3","isInDisease":true,"isInferred":false,"maxDepth":1,"name":["p-BRAF and RAF fusion dimers bind MAP2Ks and MAPKs"],"releaseDate":"2016-09-19","speciesName":"Homo sapiens","eventOf":[6802952],"isChimeric":false,"category":"binding","className":"Reaction","schemaClass":"Reactio