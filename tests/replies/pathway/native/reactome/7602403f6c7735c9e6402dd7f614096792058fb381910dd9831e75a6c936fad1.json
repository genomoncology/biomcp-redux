dentifier":"BIOMD0000000883","url":"https://www.ebi.ac.uk/biomodels/BIOMD0000000883","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"},{"dbId":12829022,"displayName":"BioModels Database:BIOMD0000000468","databaseName":"BioModels Database","identifier":"BIOMD0000000468","url":"https://www.ebi.ac.uk/biomodels/BIOMD0000000468","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"},{"dbId":12828956,"displayName":"BioModels Database:BIOMD0000000654","databaseName":"BioModels Database","identifier":"BIOMD0000000654","url":"https://www.ebi.ac.uk/biomodels/BIOMD0000000654","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"disease":[{"dbId":1500689,"displayName":"cancer","databaseName":"DOID","definition":"A disease of cellular proliferation that is malignant and primary, characterized by uncontrolled cellular proliferation, local cell invasion and metastasis.","identifier":"162","name":["cancer"],"synonym":["malignant tumor","malignant neoplasm","primary cancer"],"url":"https://www.ebi.ac.uk/ols4/ontologies/doid/terms?obo_id=DOID:162","className":"Disease","schemaClass":"Disease"}],"literatureReference":[{"dbId":1500571,"displayName":"A transforming mutation in the pleckstrin homology domain of AKT1 in cancer","title":"A transforming mutation in the pleckstrin homology domain of AKT1 in cancer","journal":"Nature","pages":"439-44","pubMedIdentifier":17611497,"volume":448,"year":2007,"url":"http://www.ncbi.nlm.nih.gov/pubmed/17611497","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"dbId":2219532,"displayName":"Molecular mechanism of an oncogenic mutation that alters membrane targeting: Glu17Lys modifies the PIP lipid specificity of the AKT1 PH domain","title":"Molecular mechanism of an oncogenic mutation that alters membrane targeting: Glu17Lys modifies the PIP lipid specificity of the AKT1 PH domain","journal":"Biochemistry","pages":"12260-9","pubMedIdentifier":18954143,"volume":47,"year":2008,"url":"http://www.ncbi.nlm.nih.gov/pubmed/18954143","className":"LiteratureReference","schemaClass":"LiteratureReference"}],"species":[{"dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"dbId":5674403,"displayName":"While AKT1 gene copy number, expression level and phosphoryl...","text":"While AKT1 gene copy number, expression level and phosphorylation are often increased in cancer, only one low frequency point mutation has been repeatedly reported in cancer and functionally studied. This mutation represents a substitution of a glutamic acid residue with lysine at position 17 of AKT1, and acts by enabling AKT1 to bind PIP2. PIP2-bound AKT1 is phosphorylated by TORC2 complex and by PDPK1 that is always present at the plasma membrane, due to low affinity for PIP2. Therefore, E17K substitution abrogates the need for PI3K in AKT1 activation (Carpten et al. 2007, Landgraf et al. 2008).","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2022-04-07","hasEvent":[{"dbId":2219536,"displayName":"AKT1 E17K mutant binds PIP2","stId":"R-HSA-2219536","stIdVersion":"R-HSA-2219536.3","isInDisease":true,"isInferred":false,"maxDepth":1,"name":["AKT1 E17K mutant binds PIP2"],"releaseDate":"2012-09-18","speciesName":"Homo sapiens","eventOf":[5674400],"isChimeric":false,"category":"binding","className":"Reaction","schemaClass":"Reaction"},{"dbId":2243938,"displayName":"AKT1 E17K mutant is phosphorylated by TORC2 complex","stId":"R-HSA-2243938","stIdVersion":"R-HSA-2243938.3","isInDisease":true,"isInferred":false,"maxDepth":1,"name":["AKT1 E17K mutant is phosphorylated by TORC2 complex"],"releaseDate":"2012-09-18","speciesNam