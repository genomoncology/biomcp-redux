cle"],"releaseDate":"2026-06-17","speciesName":"Xenopus tropicalis","inferredFrom":[1640170],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"},{"dbId":10654600,"displayName":"Cell Cycle","stId":"R-DRE-1640170","stIdVersion":"R-DRE-1640170.1","isInDisease":false,"isInferred":true,"maxDepth":9,"name":["Cell Cycle"],"releaseDate":"2026-06-17","speciesName":"Danio rerio","inferredFrom":[1640170],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"},{"dbId":10562455,"displayName":"Cell Cycle","stId":"R-SSC-1640170","stIdVersion":"R-SSC-1640170.1","isInDisease":false,"isInferred":true,"maxDepth":9,"name":["Cell Cycle"],"releaseDate":"2026-06-17","speciesName":"Sus scrofa","inferredFrom":[1640170],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"},{"dbId":10449459,"displayName":"Cell Cycle","stId":"R-BTA-1640170","stIdVersion":"R-BTA-1640170.1","isInDisease":false,"isInferred":true,"maxDepth":9,"name":["Cell Cycle"],"releaseDate":"2026-06-17","speciesName":"Bos taurus","inferredFrom":[1640170],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"},{"dbId":10334977,"displayName":"Cell Cycle","stId":"R-CFA-1640170","stIdVersion":"R-CFA-1640170.1","isInDisease":false,"isInferred":true,"maxDepth":9,"name":["Cell Cycle"],"releaseDate":"2026-06-17","speciesName":"Canis familiaris","inferredFrom":[1640170],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"},{"dbId":10228144,"displayName":"Cell Cycle","stId":"R-RNO-1640170","stIdVersion":"R-RNO-1640170.1","isInDisease":false,"isInferred":true,"maxDepth":9,"name":["Cell Cycle"],"releaseDate":"2026-06-17","speciesName":"Rattus norvegicus","inferredFrom":[1640170],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"},{"dbId":10104368,"displayName":"Cell Cycle","stId":"R-MMU-1640170","stIdVersion":"R-MMU-1640170.1","isInDisease":false,"isInferred":true,"maxDepth":9,"name":["Cell Cycle"],"releaseDate":"2026-06-17","speciesName":"Mus musculus","inferredFrom":[1640170],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"}],"species":[{"dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"dbId":9017367,"displayName":"The replication of the genome and the subsequent segregation...","text":"The replication of the genome and the subsequent segregation of chromosomes into daughter cells are controlled by a series of events collectively known as the <b>cell cycle</b>. DNA replication is carried out during a discrete temporal period known as the S (synthesis)-phase, and chromosome segregation occurs during a massive reorganization to cellular architecture at mitosis. Two gap-phases separate these major cell cycle events: G1 between mitosis and S-phase, and G2 between S-phase and mitosis. In the development of the human body, cells can exit the cell cycle for a period and enter a quiescent state known as G0, or terminally differentiate into cells that will not divide again, but undergo morphological development to carry out the wide variety of specialized functions of individual tissues.<p>A family of protein serine/threonine kinases known as the cyclin-dependent kinases (CDKs) controls progression through the cell cycle. As the name suggests, the activity of the catalytic subunit is dependent on binding to a cyclin partner. The human genome encodes several cyclins and several CDKs, with their names largely derived from the order in which they were identified. The oscillation of cyclin abundance is one important mechanism by which these enzymes phosphorylate key substrates to promote events at the relevant time and place. Additional post-translational modifications and interactions with regulatory proteins ensure that CDK activity is precisely regulated, frequently confined to a narrow window of activity.<p>In addition, genome integrity in the cell cycle is maintained by the action of a number of signal transduction pathways, known as <b>cell cycle checkpoints</b>, which monitor the accuracy and completeness of DNA replication during S phase and the orderly chromosomal condensation, pairing and partition into daughter cells during mitosis.<p>Replication of telomeric DNA at the ends of human chromosomes and packaging of their centromeres into chromatin are two aspects of <b>chromosome maintenance</b> that are integral parts of the cell cycle.<p><b>Meiosis</b> is the specialized form of cell division that generates haploid gametes from diploid germ cells, associated with recombination (exchange of genetic material between chromosomal homologs).","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2020-06-17","hasEvent":[{"dbId":69620,"displayName":"Cell Cycle Checkpoints","stId":"R-HSA-69620","stIdVersion":"R-HSA-69620.5","isInDisease":false,"isInferred":false,"maxDepth":7,"name":["Cell Cycle Checkpoints"],"releaseDate":"2005-01-24","speciesName":"Homo sapiens","eventOf":[1640170],"hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2017-06-22","schemaClass":"Pathway","className":"Pathway"},{"dbId":69278,"displayName":"Cell Cycle, Mitotic","stId":"R-HSA-69278","stIdVersion":"R-HSA-69278.6","definition":"The most common eukaryotic cell cycle, in which a cell is duplicated without changing ploidy; comprises four successive phases called G1, S, G2, and M.","isInDisease":false,"isInferred":false,"maxDepth":8,"name":["Cell Cycle, Mitotic"],"releaseDate":"2004-07-06","speciesName":"Homo sapiens","eventOf":[1640170],"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2019-12-10","schemaClass":"Pathway","className":"Pathway"},{"dbId":73886,"displayName":"Chromosome Maintenance","stId":"R-HSA-73886","stIdVersion":"R-HSA-73886.4","isInDisease":false,"isInferred":false,"maxDepth":7,"name":["Chromosome Maintenance"],"releaseDate":"2010-06-15","speciesName":"Homo sapiens","eventOf":[1640170],"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2020-06-17","schemaClass":"Pathway","className":"Pathway"},{"dbId":1500620,"displayName":"Meiosis","stId":"R-HSA-1500620","stIdVersion":"R-HSA-1500620.4","isInDisease":false,"isInferred":false,"maxDepth":3,"name":["Meiosis"],"releaseDate":"2011-09-20","speciesName":"Homo sapiens","eventOf":[1640170],"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2021-09-15","schemaClass":"Pathway","className":"Pathway"}],"schemaClass":"TopLevelPathway","className":"TopLevelPathway"}}}]}
